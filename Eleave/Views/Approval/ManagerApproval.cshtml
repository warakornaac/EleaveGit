@model IEnumerable<Eleave.Models.ApprovalRequest>

@{
    ViewBag.Title = "การอนุมัติ";

    string DepartAppver = Session["DeptName"].ToString();
    string EmployeeID = Session["EmpId"].ToString();
}
<style>
    div.table-responsive > div.dt-container > div.row {
        margin: 1%;
    }

    .mt-2, .my-2 {
        margin-top: -0.5rem !important;
        margin-bottom: 10px;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รายการอนุมัติ</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManagerApproval", "Approval")">รายการอนุมัติ</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("ManagerApproval", "Approval", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ประเภทร้องขอ | Request Type:</label>
                            @*@Html.DropDownList("LeaveType", new List<SelectListItem>
                                {
                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })*@
                            @Html.DropDownList("LeaveType", new SelectList(ViewBag.REQ_T, "LookValue", "LookDesc"), "Select request type | เลือกประเภทร้องขอ", new { @class = "custom-select", @id = "LeaveType-selector" })


                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ประเภทการลา | Leave Type :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "LeaveType", "Description"), "Select leave type | ประเภทการลา", new { @class = "custom-select", @id = "reqType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">สถานะคำขอ | Request Status :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "All Request Statuses | สถานะคำขอทั้งหมด", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">เริ่มวันที่ | From Date :</label>
                            @Html.TextBox("ReqStart",@*DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy")*@null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ถึงวันที่ | End Date :</label>
                            @Html.TextBox("ReqEnd",@*DateTime.Now.AddDays(3).ToString("dd/MM/yyyy")*@null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">แผนก | Department :</label>
                            @Html.Hidden("Dept", DepartAppver)
                            @Html.DropDownList("Dept",
                            new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc", DepartAppver),
                            "Select department | เลือกหน่วยงาน",
                            new { @class = "custom-select", @id = "department-selector", @disabled = "disabled" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">รหัสคำขอ | Request No :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId", @placeholder = "Request No | รหัสคำขอ" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ชื่อพนักงาน | Employee Name :</label>
                            @Html.TextBox("empName", null, new { @class = "form-control", @id = "empName", @placeholder = "Employee Name | ชื่อพนักงาน" })
                        </div>
                        <div class="form-group col-lg-3">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBox("actionFlag", true, new { @class = "custom-control-input", @id = "actionFlag" })
                                <label class="custom-control-label" for="actionFlag">รายการที่ต้องดำเนินการ | Pending Tasks </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="ล้าง" class="btn btn-secondary" id="reset-btn" />
                            <input type="submit" value="ค้นหา" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="font-weight-bold">Remark | หมายเหตุ :</label>
                            <textarea class="form-control" id="remark-apprv"></textarea>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group float-start m-2">
                            <button type="button" class="btn btn-success" id="selected_submit" value="1"> อนุมัติ/Approve </button>
                            <button type="button" class="btn btn-danger" id="selected_reject" value="2"> ปฎิเสธ/Reject </button>
                        </div>
                    </div>
                    <div class="col-12 pt-2">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped tableList" id="request-table">
                                <thead>
                                    <tr>
                                        <th>
                                            <div class="chk-option">
                                                <label class="check-task custom-control custom-checkbox d-flex justify-content-center done-task">
                                                    @Html.CheckBox("all_select", new { @class = "custom-control-input", @id = "all_select" })
                                                    @Html.Label("all_select", "", new { @class = "custom-control-label" })
                                                    <input type="checkbox" class="custom-control-input">
                                                    <span class="custom-control-label"></span>
                                                </label>
                                            </div>
                                        </th>
                                        <th>#</th>
                                        <th class="text-center">จัดการ | ACT</th>
                                        <th class="text-center">สถานะคำขอ | REQ STATUS</th>
                                        <th class="text-center">ผู้ร้องขอ | REQ BY</th>
                                        <th class="text-center">ประเภทการลา | REQ CATE</th>
                                        <th class="text-center">วันที่ร้องขอ | REQ DATE</th>
                                        <th class="text-center">วันที่ลา | Leave DATE</th>
                                        <th class="text-center">รวมขอลา | TOT DATE</th>
                                        <th class="text-center">หมายเหตุการลา | REMARK</th>
                                        <th class="text-center">ผู้อนุมัติ | APPR BY</th>
                                        <th class="text-center">วันที่อนุมัติ | APPR DATE</th>
                                        <th class="text-center">HR ผู้รับอนุมัติ | ACK BY</th>
                                        <th class="text-center">วันที่ HR รับอนุมัติ | ACK DATE</th>
                                        <th class="text-center">รหัสคำขอ | REQ NO</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 0;
                                    }
                                    @foreach (var request in Model)
                                    {
                                        i++;
                                        <tr>
                                            <td>
                                                <div class="chk-option">
                                                    <label class="check-task custom-control custom-checkbox d-flex justify-content-center done-task">
                                                        @Html.CheckBox("Apprv_Select_Req_" + request.ReqNo, new { @class = "custom-control-input", @value = request.ReqNo, @id = "Apprv_Select_Req_" + request.ReqNo, @disabled = "disabled" })
                                                        @Html.Label("Apprv_Select_Req_" + request.ReqNo, "", new { @class = "custom-control-label" })
                                                        <input type="checkbox" class="custom-control-input">
                                                        <span class="custom-control-label"></span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td class="text-center">@i</td>
                                            <td class="text-center">
                                                <div class="btn btn-warning btn-xs p-1" id="aprvbtn_@request.ReqNo" data-reqno="@request.ReqNo" data-empid="@request.EmpId"><span class="fa fa-eye p-1"></span></div>
                                            </td>
                                            @if (request.ReqStatus == "0")
                                            {
                                                <td class="text-left">
                                                    <div class="text-warning "><span class="badge bg-warning rounded-pill"><i class="fa fa-repeat" aria-hidden="true"></i></span><span> @request.ReqStaDesc</span></div>
                                                </td>
                                            }
                                            else if (request.ReqStatus == "1")
                                            {
                                                <td class="text-left">
                                                    <div class="text-success"><span class="badge bg-success rounded-pill"><i class="fa fa-check" aria-hidden="true"></i></span><span> @request.ReqStaDesc</span></div>
                                                </td>
                                            }
                                            else if (request.ReqStatus == "2")
                                            {
                                                <td class="text-left">
                                                    <div class="text-danger"><span class="badge bg-danger rounded-pill"><i class="fa fa-times" aria-hidden="true"></i></span> <span> @request.ReqStaDesc</span></div>
                                                </td>
                                            }
                                            else if (request.ReqStatus == "3")
                                            {
                                                <td class="text-left">
                                                    <div class="text-primary"><span class="badge bg-primary rounded-pill"><i class="fa fa-check" aria-hidden="true"></i></span><span> @request.ReqStaDesc</span></div>
                                                </td>
                                            }
                                            else if (request.ReqStatus == "4")
                                            {
                                                <td class="text-left">
                                                    <div class="text-danger"><span class="badge bg-danger rounded-pill"><i class="fa fa-ban" aria-hidden="true"></i></span><span> @request.ReqStaDesc</span></div>
                                                </td>
                                            }
                                            <td class="text-center">@request.Empname</td>
                                            <td class="text-center">@request.LeaveType</td>
                                            <td class="text-center">@request.ReqDate</td>
                                            <td class="text-center">@(request.StartDate )-@(request.EndDate)</td>
                                            @*<td class="text-center">@(request.EndDate )</td>*@
                                            <td class="text-center">@Eleave.Library.Utils.CalculateDayHour((double)request.NumDay) </td>

                                            <td style="max-width: 200px;">
                                                <p class="p-0 m-0 text-truncate">@request.Remark</p>
                                            </td>

                                            @*<td class="text-center">@request.ApproveBy</td>*@
                                            @*apprvby*@

                                            @if (request.ApproveBy.Contains(","))
                                            {
                                                <td class="text-left">
                                                    @{
                                                        string[] apprv = request.ApproveBy.Split(',');
                                                        string apver = string.Empty;
                                                        string iconsta = string.Empty;
                                                        string iconbg = string.Empty;
                                                        foreach (var item in apprv)
                                                        {
                                                            if (item.Contains(" | "))
                                                            {
                                                                string[] StatusNAme = item.Split('|');
                                                                switch (StatusNAme[0].Trim())
                                                                {
                                                                    case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                                    case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                    case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                                    case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                    default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                                }
                                                                if (StatusNAme[0].Trim() == "4")
                                                                {
                                                                    <span class="badge rounded-pill @iconbg">
                                                                        <i class="@iconsta" aria-hidden="true"></i>
                                                                    </span>
                                                                    <del>@StatusNAme[1]</del> <br />

                                                                }
                                                                else
                                                                {
                                                                    <span class="badge rounded-pill @iconbg">
                                                                        <i class="@iconsta" aria-hidden="true"></i>
                                                                    </span>
                                                                    <span>@StatusNAme[1]</span><br />
                                                                }

                                                            }
                                                        }
                                                    }
                                                </td>

                                            }
                                            else
                                            {
                                                //<td class="text-center">@leave.ApproveBy</td>
                                                <td class="text-left">
                                                    @{
                                                        string[] apprv = request.ApproveBy.Split(',');

                                                        string apver = string.Empty;
                                                        string iconsta = string.Empty;
                                                        string iconbg = string.Empty;
                                                        foreach (var item in apprv)
                                                        {
                                                            if (item.Contains(" | "))
                                                            {

                                                                string[] StatusNAme = item.Split('|');
                                                                switch (StatusNAme[0].Trim())
                                                                {
                                                                    case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                                    case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                    case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                                    case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                    default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                                }

                                                                <span class="badge rounded-pill @iconbg">
                                                                    <i class="@iconsta" aria-hidden="true"></i>
                                                                </span>

                                                                <span>@StatusNAme[1]</span><br />
                                                            }
                                                        }
                                                    }
                                                </td>
                                            }
                                            @*apprvby*@
                                            <td class="text-center">@(request.ApproveDate )</td>
                                            <td class="text-center">@request.AcknowledgeBy</td>
                                            <td class="text-center">@(request.AcknowledgeDate )</td>
                                            <td class="text-center">@request.ReqNo</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="ApprovRequestModal" tabindex="-1" aria-labelledby="ModalApprov" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalApprov">อนุมัติคำขอ</h5>
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close | ปิด</button></div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>รหัสคำขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqId" id="Approv_reqid"></p>
                            <input type="hidden" name="ReqIdHide" value="" id="Approv_reqid_val" />

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ร้องขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqDate" id="Approv_reqdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqTyp" id="Approv_reqtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการลา: </label>
                            <p class="border-0 p-0 m-0" name="LevTyp" id="Approv_levtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(เริ่ม): </label>
                            <p class="border-0 p-0 m-0" name="StartDate" id="Approv_startdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(สิ้นสุด): </label>
                            <p class="border-0 p-0 m-0" name="EndDate" id="Approv_enddate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>สถานะคำขอ: </label>
                            <div id="Approv_sta"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>หมายเหตุการลา</label>
                            <p class="border-0 p-0 m-0 mb-1" name="Remark" id="Approv_remark"></p>
                        </div>

                    </div>
                </div>
                <div class="row">
                    <div class="col-12" id="area-comment-form" hidden>
                        <div class="form-group">
                            <label>ความเห็นผู้อนุมัติ</label>
                            <textarea class="form-control" id="apprv_comment"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12" id="btn-apprv-form">
                        <button type="button" class="btn btn-success" id="Approv_submit" value="1"> อนุมัติ/Approve </button>
                        <button type="button" class="btn btn-danger" id="Approv_reject" value="2"> ปฎิเสธ/Reject </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    const queryString = decodeURIComponent(window.location.search);
    const params = new URLSearchParams(queryString);
    const page = params.get('req');
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("GetAlertApproval", "Home")',
            data: {
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (data) {
                if (data.message == 'Y') {
                    if (data.RequestApprv.length > 0) {
                        for (var i = 0; i < data.RequestApprv.length; i++) {
                            $('#Apprv_Select_Req_' + data.RequestApprv[i].ReqNo).removeAttr('disabled');
                        }
                    }
                }
            },
            error: function (xhr, status, error) {
                console.log('AJAX error: ' + status + ' - ' + error);
            }
        })
    });

    $(document).on('change', '#all_select', function () {
        var $checkboxes = $('[id^="Apprv_Select_Req_"]');

        if ($(this).is(':checked')) {
            $checkboxes.each(function () {
                if (!$(this).is(':disabled')) {
                    $(this).prop('checked', true);
                }
            });
        } else {
            $checkboxes.prop('checked', false);
        }
    });

    //$(document).on('click', '#test_all_select', function () {
    //    var $checkedCheckboxes = $('[id^="Apprv_Select_Req_"]:checked');
    //    if ($checkedCheckboxes.length) {
    //        console.log("Number of checked checkboxes: " + $checkedCheckboxes.length);
    //        $checkedCheckboxes.each(function () {
    //            console.log("Checked value: " + $(this).val());
    //        });
    //    } else {
    //        console.log("No checkboxes are checked.");
    //    }
    //});
    $(document).ready(function () {
        $('#department-selector').select2({
            width: '100%'
        });
        console.log('Param :' + page);
        if (page) {
            $('#aprvbtn_' + page).click();
            console.log('click:' + page);
        }
    });
    $('#reqStart').inputmask('99/99/9999');
    $('#reqEnd').inputmask('99/99/9999');
    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $(document).on('change', '#LeaveType-selector', function () {
        var typ = $(this).val();
        console.log('typ :' + typ);
        if (typ == 1) {
            $('#reqType-selector').removeAttr('disabled');
        }
        else {
            $('#reqType-selector').attr('disabled', true);
        }
    });
    $(document).on('click', '[id^="aprvbtn_"]', async function (e) {
        e.preventDefault();
        var reqNo = $(this).data('reqno');
        var empId = $(this).data('empid');

        $('#apprv_comment').val('');
        $('#Approv_reqid_val').val(reqNo);

        try {
            await GetReqDetail(reqNo, empId);
            await CheckApprovalReq(reqNo);
        } catch (error) {
            console.error("Error during approval process:", error);
        }
    });
    $(document).on('click', '[id^="Approv_"]', function (e) {
        e.preventDefault();
        var txtMessage = "อนุมัติ";
        var status = $(this).val();
        console.log("Status Btn: " + status);
        if (status == 2) {
            txtMessage = "ปฎิเสธ";
        }
        var comment = $('#apprv_comment').val();
        var reqno = $('#cancel_reqid').text()
        console.log('ReqNo Sub:' + reqno);
        Swal.fire({
            icon: 'question',
            title: 'ต้องการ' + txtMessage + ' ใช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("UpdateApproval", "Approval")',
                    data: {
                        ReqNo: reqno,
                        ApprvStatus: status,
                        ApprvComment: comment
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    success: function (data) {
                        if (data.message == 'Y') {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "อนุมัติเรียบร้อย",
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                onClose: () => {
                                    LoadingHide();
                                }
                            }).then(() => {
                                location.reload();
                            });
                        }
                        else {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "เกิดข้อผิดพลาด!",
                                text: data.message,
                                icon: "error"
                            }).then(() => {
                                $('#ApprovRequestModal').modal('show');
                            });
                        }
                    }
                });
            }
        });
    });
    $(document).on('click', '[id^="selected_"]', function (e) {
        e.preventDefault();
        var $loop_focus = 0;
        var Success_apprv = 0;
        var Faile_apprv = 0;
        var $checkedCheckboxes = $('[id^="Apprv_Select_Req_"]:checked');
        var ApprvMCmt = $('#remark-apprv').val();
        var Sta = $(this).val();
        var actionTitle = Sta === '1' ? "อนุมัติสำเร็จ / Approve Success" : "ปฏิเสธสำเร็จ / Reject Success";

        if ($checkedCheckboxes.length) {
            console.log("Number of checked checkboxes: " + $checkedCheckboxes.length);

            $checkedCheckboxes.each(function () {
                var $thisCheckbox = $(this);
                var reqNo = $thisCheckbox.val();

                $.ajax({
                    url: '@Url.Action("UpdateApproval", "Approval")',
                    type: 'POST',
                    dataType: 'JSON',
                    data: {
                        ReqNo: reqNo,
                        ApprvStatus: Sta,
                        ApprvComment: ApprvMCmt,
                    },
                    success: function (data) {
                        if (data.message === 'Y') {
                            Success_apprv++;
                        } else {
                            Faile_apprv++;
                        }
                    },
                    error: function () {
                        Faile_apprv++;
                    },
                    complete: function () {
                        $loop_focus++;
                        if ($loop_focus === $checkedCheckboxes.length) {
                            Swal.fire({
                                title: actionTitle,
                                html: 'สำเร็จ/Success: ' + Success_apprv + '</br>' + 'ไม่สำเร็จ/Error: ' + Faile_apprv,
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                            }).then(() => {
                                location.reload();
                            });
                        }
                    },
                });
            });
        } else {
            Swal.fire({
                title: "ไม่มีรายการที่เลือก / No Items Selected",
                text: "กรุณาเลือกอย่างน้อย 1 รายการ",
                icon: 'warning',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'ตกลง',
            });
        }
    });




    function ApproveSubmit(Sta) {
        var comment = $('#apprv_comment').val();
        var reqno = $('#cancel_reqid').text()
        console.log('ReqNo Sub:' + reqno);
        Swal.fire({
            icon: 'question',
            title: 'ต้องการอนุมัติใช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("UpdateApproval", "Approval")',
                    data: {
                        ReqNo: reqno,
                        ApprvStatus: Sta,
                        ApprvComment: comment
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    success: function (data) {
                        if (data.message == 'Y') {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "อนุมัติเรียบร้อย",
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                            }).then(() => {
                                location.reload();
                            });
                        }
                        else {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "เกิดข้อผิดพลาด!",
                                text: data.message,
                                icon: "error"
                            }).then(() => {
                                $('#ApprovRequestModal').modal('show');
                            });
                        }
                    }
                });
            }
        });
    }
    function CheckApprovalReq(REQ) {
        return $.ajax({
            url: '@Url.Action("CheckApproval", "Approval")',
            data: {
                ReqNo: REQ
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (res) {
                if (res.message == 'Y') {
                    $('#area-comment-form').removeAttr('hidden');
                    $('#btn-apprv-form').removeAttr('hidden');
                }
                else if (res.message == 'N') {
                    $('#area-comment-form').attr('hidden',true);
                    $('#btn-apprv-form').attr('hidden', true);
                }
                else {
                    console.log('Error :' + res.message);
                }
            }
        });
    }
    function GetReqDetail(REQ, empId) {
        return $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                EmpId: empId,
                Flag: "approve"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#ApprovRequestModal').find('.modal-body').html("");
            },
            success: function (data) {
                $('#ApprovRequestModal').find('.modal-body').html(data);
                $('#ApprovRequestModal').modal('show');
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>GetReqDetail :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }

    function DropdownReqTyp()
    {
        $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                data: {

                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#reqType-selector');
                        select.children().remove();
                        select.append($('<option>').val(null).text('เลือกประเภทการร้องขอ'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.LeaveType).text(item.Description));
                        });

                    }
                    else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
    }
    $(document).on("click", "#reset-btn", function () {
        $('#reqId').val('');                      // รหัสคำขอ
        $('#reqType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqDate').val('');                    // วันที่แจ้ง
        $('#reqStart').val('');                   // เริ่มวันที่
        $('#reqEnd').val('');                     // ถึงวันที่
        $('#reqStatus').val('0').trigger('change'); // สถานะคำขอ
        console.log("dept" + $('#department-selector').val());
    });
    $(document).ready(function () {
        console.log("DepartName :" + "@DepartAppver");
        var isMdOrLarger = window.matchMedia("(min-width: 1600px)").matches;
        $('#request-table').dataTable({
            dom: '<t><"d-flex align-items-center"ip>',
