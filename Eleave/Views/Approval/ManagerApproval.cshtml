@model IEnumerable<Eleave.Models.ApprovalRequest>

@{
    ViewBag.Title = "การอนุมัติ";

    string DepartAppver = Session["DeptName"].ToString();
    string EmployeeID = Session["EmpId"].ToString();
}
<style>
    div.table-responsive > div.dt-container > div.row {
        margin: 1%;
    }

    .mt-2, .my-2 {
        margin-top: -0.5rem !important;
        margin-bottom: 10px;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รายการอนุมัติ</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManagerApproval", "Approval")">รายการอนุมัติ</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("ManagerApproval", "Approval", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ประเภทร้องขอ :</label>
                            @Html.DropDownList("LeaveType", new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ประเภทการลา :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "LeaveType", "Description"), "ประเภทการลา", new { @class = "custom-select", @id = "reqType-selector" })

                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">สถานะคำขอ :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "สถานะคำขอทั้งหมด", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">เริ่มวันที่ :</label>
                            @Html.TextBox("ReqStart",@*DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy")*@null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ถึงวันที่ :</label>
                            @Html.TextBox("ReqEnd",@*DateTime.Now.AddDays(3).ToString("dd/MM/yyyy")*@null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">แผนก :</label>
                            @Html.Hidden("Dept", DepartAppver)
                            @Html.DropDownList("Dept",
                            new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc", DepartAppver),
                            "เลือกหน่วยงาน",
                            new { @class = "custom-select", @id = "department-selector", @disabled = "disabled" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">รหัสคำขอ :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId", @placeholder = "รหัสคำขอ" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">ชื่อพนักงาน :</label>
                            @Html.TextBox("empName", null, new { @class = "form-control", @id = "empName", @placeholder = "ชื่อพนักงาน" })
                        </div>
                        <div class="form-group col-lg-3">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBox("actionFlag", true, new { @class = "custom-control-input", @id = "actionFlag" })
                                <label class="custom-control-label" for="actionFlag">รายการที่ต้องดำเนินการ</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="ล้าง" class="btn btn-secondary" id="reset-btn" />
                            <input type="submit" value="ค้นหา" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="request-table" style="margin-left: -25px;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">จัดการ</th>
                                <th class="text-center">รหัสคำขอ</th>
                                <th class="text-center">วันที่ขอ</th>
                                <th class="text-center">ประเภทการขอ</th>
                                <th class="text-center">ผู้ร้องขอ</th>
                                <th class="text-center">ประเภทการลา</th>
                                <th class="text-center">วันที่ลา(เริ่ม)</th>
                                <th class="text-center">วันที่ลา(สิ้นสุด)</th>
                                <th class="text-center">รวมขอลา</th>
                                <th class="text-center">สถานะคำขอ</th>
                                <th class="text-center">หมายเหตุการลา</th>
                                <th class="text-center">ผู้อนุมัติ</th>
                                <th class="text-center">วันที่อนุมัติ</th>
                                <th class="text-center">HR ผู้รับอนุมัติ</th>
                                <th class="text-center">วันที่ HR รับอนุมัติ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var request in Model)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center">
                                        <div class="btn btn-warning btn-xs p-1" id="aprvbtn_@request.ReqNo" data-reqno="@request.ReqNo" data-empid="@request.EmpId"><span class="fa fa-eye p-1"></span></div>
                                    </td>
                                    <td>@request.ReqNo</td>
                                    <td>@(request.ReqDate )</td>
                                    <td class="text-center">@request.ReqType</td>
                                    <td class="text-center">@request.Empname</td>
                                    <td class="text-center">@request.LeaveType</td>
                                    <td>@(request.StartDate )</td>
                                    <td>@(request.EndDate )</td>
                                    <td class="text-center">@request.NumDay</td>
                                    @if (request.ReqStatus == "0")
                                    {
                                        <td class="text-center">
                                            <div class="text-warning badge" style="font-size: 14px;"><i class="fa fa-repeat" aria-hidden="true"></i><span> @request.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (request.ReqStatus == "1")
                                    {
                                        <td class="text-center">
                                            <div class="text-success badge" style="font-size: 14px;"><i class="fa fa-check" aria-hidden="true"></i><span> @request.ReqStaDesc</span></div>
                                        </td>

                                    }
                                    else if (request.ReqStatus == "2")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger badge" style="font-size: 14px;"><i class="fa fa-times" aria-hidden="true"></i><span> @request.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (request.ReqStatus == "3")
                                    {
                                        <td class="text-center">
                                            <div class="text-success badge" style="font-size: 14px;"><i class="fa fa-check" aria-hidden="true"></i><span> @request.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (request.ReqStatus == "4")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger badge" style="font-size: 14px;"><i class="fa fa-ban" aria-hidden="true"></i><span> @request.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@request.Remark</p>
                                    </td>

                                    <td class="text-center">@request.ApproveBy</td>
                                    <td>@(request.ApproveDate )</td>
                                    <td class="text-center">@request.AcknowledgeBy</td>
                                    <td>@(request.AcknowledgeDate )</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="ApprovRequestModal" tabindex="-1" aria-labelledby="ModalApprov" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalApprov">อนุมัติคำขอ</h5>
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">ปิด</button></div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>รหัสคำขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqId" id="Approv_reqid"></p>
                            <input type="hidden" name="ReqIdHide" value="" id="Approv_reqid_val" />

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ร้องขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqDate" id="Approv_reqdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqTyp" id="Approv_reqtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการลา: </label>
                            <p class="border-0 p-0 m-0" name="LevTyp" id="Approv_levtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(เริ่ม): </label>
                            <p class="border-0 p-0 m-0" name="StartDate" id="Approv_startdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(สิ้นสุด): </label>
                            <p class="border-0 p-0 m-0" name="EndDate" id="Approv_enddate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>สถานะคำขอ: </label>
                            <div id="Approv_sta"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>หมายเหตุการลา</label>
                            <p class="border-0 p-0 m-0 mb-1" name="Remark" id="Approv_remark"></p>
                        </div>

                    </div>
                </div>
                <div class="row">
                    <div class="col-12" id="area-comment-form" hidden>
                        <div class="form-group">
                            <label>ความเห็นผู้อนุมัติ</label>
                            <textarea class="form-control" id="apprv_comment"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-success" id="Approv_submit" value="1"> อนุมัติ/Approve </button>
                        <button type="button" class="btn btn-danger" id="Approv_reject" value="2"> ปฎิเสธ/Reject </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const queryString = decodeURIComponent(window.location.search);
    const params = new URLSearchParams(queryString);
    const page = params.get('req');
    $(document).ready(function () {
        $('#department-selector').select2({
            width: '100%'
        });
        console.log('Param :' + page);
        if (page) {
            $('#aprvbtn_' + page).click();
            console.log('click:' + page);
        }
    });
    $('#reqStart').inputmask('99/99/9999');
    $('#reqEnd').inputmask('99/99/9999');
    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    //$(document).on('change', '#LeaveType-selector', function () {
    //    DropdownReqTyp();
    //});
    $(document).on('click', '[id^="aprvbtn_"]', async function (e) {
        e.preventDefault();
        var reqNo = $(this).data('reqno');
        var empId = $(this).data('empid');

        $('#apprv_comment').val('');
        $('#Approv_reqid_val').val(reqNo);

        try {
            await GetReqDetail(reqNo, empId);
            await CheckApprovalReq(reqNo);
        } catch (error) {
            console.error("Error during approval process:", error);
        }
    });
    $(document).on('click', '[id^="Approv_"]', function (e) {
        e.preventDefault();
        var txtMessage = "อนุมัติ";
        var status = $(this).val();
        console.log("Status Btn: " + status);
        if (status == 2) {
            txtMessage = "ปฎิเสธ";
        }
        var comment = $('#apprv_comment').val();
        var reqno = $('#cancel_reqid').text()
        console.log('ReqNo Sub:' + reqno);
        Swal.fire({
            icon: 'question',
            title: 'ต้องการ' + txtMessage + ' ช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("UpdateApproval", "Approval")',
                    data: {
                        ReqNo: reqno,
                        ApprvStatus: status,
                        ApprvComment: comment
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    success: function (data) {
                        if (data.message == 'Y') {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "อนุมัติเรียบร้อย",
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                onClose: () => {
                                    LoadingHide();
                                }
                            }).then(() => {
                                location.reload();
                            });
                        }
                        else {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "เกิดข้อผิดพลาด!",
                                text: data.message,
                                icon: "error"
                            }).then(() => {
                                $('#ApprovRequestModal').modal('show');
                            });
                        }
                    }
                });
            }
        });
    });
    function ApproveSubmit(Sta) {
        var comment = $('#apprv_comment').val();
        var reqno = $('#cancel_reqid').text()
        console.log('ReqNo Sub:' + reqno);
        Swal.fire({
            icon: 'question',
            title: 'ต้องการอนุมัติใช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("UpdateApproval", "Approval")',
                    data: {
                        ReqNo: reqno,
                        ApprvStatus: Sta,
                        ApprvComment: comment
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    success: function (data) {
                        if (data.message == 'Y') {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "อนุมัติเรียบร้อย",
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                            }).then(() => {
                                location.reload();
                            });
                        }
                        else {
                            $('#ApprovRequestModal').modal('hide');
                            Swal.fire({
                                title: "เกิดข้อผิดพลาด!",
                                text: data.message,
                                icon: "error"
                            }).then(() => {
                                $('#ApprovRequestModal').modal('show');
                            });
                        }
                    }
                });
            }
        });
    }
    function CheckApprovalReq(REQ) {
        return $.ajax({
            url: '@Url.Action("CheckApproval", "Approval")',
            data: {
                ReqNo: REQ
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (res) {
                if (res.message == 'Y') {
                    $('#area-comment-form').removeAttr('hidden');
                    $('#btn-apprv-form').removeAttr('hidden');
                }
                else if (res.message == 'N') {
                    $('#area-comment-form').attr('hidden',true);
                    $('#btn-apprv-form').attr('hidden', true);
                }
                else {
                    console.log('Error :' + res.message);
                }
            }
        });
    }
    function GetReqDetail(REQ, empId) {
        return $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                EmpId: empId,
                Flag: "approve"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#ApprovRequestModal').find('.modal-body').html("");
                //$('#cancel_reqid').text('');
                //$('#cancel_reqid_val').val('');
                //$('#cancel_reqdate').text('');
                //$('#cancel_reqtyp').text('');
                //$('#cancel_levtyp').text('');
                //$('#cancel_startdate').text('');
                //$('#cancel_enddate').text('');
                //$('#cancel_remark').text('');
                //$('#cancel_sta').html('');
            },
            success: function (data) {
                $('#ApprovRequestModal').find('.modal-body').html(data);
                $('#ApprovRequestModal').modal('show');
                //if (data.message == "Y") {
                //    if (data.ReqDetail.length != 0) {
                //        $('#cancel_reqid').text(data.ReqDetail[0].ReqNo);
                //        $('#cancel_reqid_val').val(data.ReqDetail[0].ReqNo);
                //        $('#cancel_reqdate').text(data.ReqDetail[0].ReqDate);
                //        $('#cancel_reqtyp').text(data.ReqDetail[0].ReqType);
                //        $('#cancel_levtyp').text(data.ReqDetail[0].LeaveType);
                //        $('#cancel_startdate').text(data.ReqDetail[0].StartDate);
                //        $('#cancel_enddate').text(data.ReqDetail[0].EndDate);
                //        $('#cancel_remark').text(data.ReqDetail[0].Remark);
                //        if (data.ReqDetail[0].ReqStatus == "0") {
                //            $('#cancel_sta').html('<div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span>' + data.ReqDetail[0].ReqStaDesc +'</span></div>');
                //        }
                //    }
                //}
                //else {
                //    console.log('Detail Err: ' + data.message);
                //}
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>GetReqDetail :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }

    @*$(document).on('click', '#Approv_submit', function () {
        var reqno = $('#Approv_reqid_val').val()
        $.ajax({
            url: '@Url.Action("ApprovRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#ApprovRequestModal').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ทำการอนุมัติเสร็จสิ้น",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#ApprovRequestModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Approv Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
    });*@

    function DropdownReqTyp()
    {
        $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                data: {

                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#reqType-selector');
                        select.children().remove();
                        select.append($('<option>').val(null).text('เลือกประเภทการร้องขอ'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.LeaveType).text(item.Description));
                        });

                    }
                    else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
    }
    $(document).on("click", "#reset-btn", function () {
        $('#reqId').val('');                      // รหัสคำขอ
        $('#reqType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqDate').val('');                    // วันที่แจ้ง
        $('#reqStart').val('');                   // เริ่มวันที่
        $('#reqEnd').val('');                     // ถึงวันที่
        $('#reqStatus').val('0').trigger('change'); // สถานะคำขอ
        //$('#department-selector').val('').trigger('change');
        console.log("dept" + $('#department-selector').val());
    });
    $(document).ready(function () {
        console.log("DepartName :"+"@DepartAppver");
        //$('#reqStatus').val('0').trigger('change');
