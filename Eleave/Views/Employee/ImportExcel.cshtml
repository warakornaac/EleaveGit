@using Eleave.Models;
@{
    ViewBag.Title = "Import ข้อมูลพนักงาน";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Import ข้อมูลพนักงาน</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ImportEmployee", "Employee")">Import ข้อมูลพนักงาน</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <label for="formFileLg" class="form-label">File Excel</label>
                        <input class="form-control form-control-md" name="fileInput" id="fileInput" type="file">
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="col-md-12">
                    <div class="text-right">
                        <input type="button" id="btnImport" onclick="importFile();" value="นำเข้าข้อมูล" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*ตัวอย่างไฟล์นำเข้า*@
<div id="ListImportExcelSample">
    @Html.Partial("_ListImportExcelSample", "")
</div>

@*ข้อมูลที่นำเข้าแล้ว*@
<div id="ListImportExcel" style="display: none;"></div>

<script defer>
    function importFile() {
        var datacountstatusy = new Array();
        var datacountstatusf = new Array();
        var formData = new FormData();
        var fileInput = $("#fileInput").prop('files')[0];
        var empId = @this.Session["EmpId"].ToString();
        console.log("fileInput = " + fileInput);
        console.log("empId = " + empId);
        formData.append('fileInput', fileInput);
        formData.append('empId', empId);
        $.ajax({
            url: '@Url.Action("SaveImportExcel", "Employee")',
            type: 'post',
            data: formData,
            dataType: 'html',
            cache: false,
            contentType: false,
            processData: false,
            beforeSend: function () {
                $('#ListImportExcel').empty();
                $('#ListImportExcel').html('<div style="padding: 30px; font-size: 18px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>')
                LoadingShow();
            },
            success: function (result) {
                LoadingHide();

                $('#ListImportExcelSample').hide();
                $('#ListImportExcel').html(result);
                $('#ListImportExcel').css('display', 'block');

                Swal.fire({
                    title: 'บันทึกเรียบร้อย',
                    icon: 'success',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                    timer: 5000,
                    timerProgressBar: true,
                    onClose: () => {
                        LoadingHide();
                    }
                }).then((result) => {
                    LoadingHide();
                });
            }
        });
    }
</script>
