@using Eleave.Models;
@{
    var dataEmp = (StoreGetProfile)ViewBag.ProfileList;
}

<style>
    .card {
        border-top-color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>รหัสพนักงาน | Employee ID</h5>
                    <div> @dataEmp.EmpId </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>ชื่อ-สกุล | Employee Name</h5>
                    <div> @dataEmp.Fullname  </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>บริษัท | Company</h5>
                    <div> @dataEmp.Company </div>
                </div>
            </div>

            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>หน่วยงาน | Department</h5>
                    <div> @dataEmp.DeptName </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>ตำแหน่ง | Position</h5>
                    <div> @dataEmp.Position </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>หัวหน้างาน | Director</h5>
                    <div> @dataEmp.DirectorId </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>ระดับพนักงาน | Employee Level</h5>
                    <div> @dataEmp.EmpLvlName </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>ประเภทพนักงาน | Employee Type</h5>
                    <div> @dataEmp.EmpTypeName </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>รหัสกลุ่มอนุมัติ | Approval Group</h5>
                    <div> @dataEmp.ApprGrpID </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>วันที่เริ่มงาน | Start Date</h5>
                    <div> @dataEmp.StartDate.ToString("dd/MM/yyyy") </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>อายุงาน</h5>
                    <div>
                        @{
                            DateTime startDate = dataEmp.StartDate;  // dataEmp.StartDate เป็น DateTime อยู่แล้ว
                            DateTime now = DateTime.Now;

                            // คำนวณจำนวนปี, เดือน, และวัน
                            int years = now.Year - startDate.Year;
                            int months = now.Month - startDate.Month;
                            int days = now.Day - startDate.Day;

                            // ถ้าเดือนติดลบ ให้ถอยปีออก 1
                            if (months < 0)
                            {
                                years--;
                                months += 12;
                            }

                            // ถ้าวันติดลบ ให้ถอยเดือนออก 1
                            if (days < 0)
                            {
                                months--;
                                // หาจำนวนวันในเดือนก่อนหน้าเพื่อนำมาบวก
                                var previousMonth = now.AddMonths(-1);
                                int daysInPreviousMonth = DateTime.DaysInMonth(previousMonth.Year, previousMonth.Month);
                                days += daysInPreviousMonth;
                            }

                            <span>@years ปี|Year, @months เดือน|Month, @days วัน|Days</span>
                        }


                    </div>
                </div>
            </div>
            <div class="col-xs-6 col-sm-4">
                <div class="form-group">
                    <h5>สถานะพนักงาน | Employee Status</h5>
                    @if (dataEmp.EmpStatus == "Active")
                    {
                        <div class="text-white badge badge-success rounded-pill"><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>ทำงาน/Working</span></div>
                    }
                    else if (dataEmp.EmpStatus == "Inactive")
                    {
                        <div class="text-white badge badge-success rounded-pill"><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>ยกเลิก/Inactived</span></div>
                    }
                    else
                    {
                        <div class="text-white badge badge-danger rounded-pill"><i class="fa fa-times-circle-o" aria-hidden="true"></i><span>ลาออก/Resigned</span></div>
                    }
                    @*<div> @dataEmp.StartDate </div>*@
                </div>
            </div>
            @if (!string.IsNullOrEmpty(dataEmp.TempId))
            {
                <div class="col-xs-6 col-sm-4">
                    <div class="form-group">
                        <h5>
                            รหัสพนักงานชั่วคราว | Temp ID
                        </h5>
                        <div> @dataEmp.TempId </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>