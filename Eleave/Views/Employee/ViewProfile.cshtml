@using Eleave.Models;
@{
    ViewBag.Title = "Profile";
    var dataEmp = (StoreGetProfile)ViewBag.ProfileList;
    var countListBalance = ((List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance).Count();

    var iconMapping = new Dictionary<int, string>
{
        { 1, "fa fa-medkit" },
        { 2, "fa fa-map-marker" },
        { 3, "icon feather icon-rotate-ccw" },
        { 4, "icon feather icon-rotate-ccw" },
    };

    string defaultIcon = "icon feather icon-file-text"; // Default icon

}
<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 120px;
        height: 34px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #e74c3c;
        -webkit-transition: .4s;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #2ecc71;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(85px);
    }

    /*------ ADDED CSS ---------*/
    .slider:after {
        content: 'Inactive';
        color: white;
        display: block;
        position: absolute;
        transform: translate(-50%,-50%);
        top: 50%;
        left: 50%;
        font-size: 10px;
        font-family: Verdana, sans-serif;
    }

    input:checked + .slider:after {
        content: 'Active';
    }
</style>
<style>
    .filepond--credits {
        display: none;
    }

    small, .small {
        font-size: 100%;
    }

    .star {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eee;
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
    }

    .time-text {
        font-size: 12px;
        color: #989898;
    }

    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">โปรไฟล์</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#!">โปรไฟล์</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-7 col-md-8">
        <!-- ข้อมูลผู้ใช้งาน -->
        <div class="card-container profile-container">
            <div class="d-flex align-items-center justify-content-between">
                @*<h5 class="m-0">ข้อมูลผู้ใช้งาน</h5>*@
                @*<button class="btn btn-warning" type="button" data-bs-toggle="modal" data-bs-target="#exampleModal">ตั้งรหัสผ่านใหม่</button>*@
            </div>
            <div class="card card-primary p-2">
                <div class="card-header p-2">
                    <h5>ข้อมูลผู้ใช้งาน</h5>
                </div>
                <div class="card-body ">
                    <div class="row">
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>รหัสพนักงาน</h5>
                                <div> @dataEmp.EmpId </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>ชื่อ-สกุล</h5>
                                <div> @dataEmp.Fullname  </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>บริษัท</h5>
                                <div> @dataEmp.Company </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>หน่วยงาน</h5>
                                <div> @dataEmp.DeptName </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>ตำแหน่ง</h5>
                                <div> @dataEmp.Position </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>หัวหน้างาน</h5>
                                <div> @dataEmp.DirectorId </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    ระดับพนักงาน
                                </h5>
                                <div> @dataEmp.EmpLvlName </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    ประเภทพนักงาน
                                </h5>
                                <div> @dataEmp.EmpTypeName </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    รหัสกลุ่มอนุมัติ
                                </h5>
                                <div> @dataEmp.ApprGrpID </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    วันที่เริ่มงาน
                                </h5>
                                <div> @dataEmp.StartDate.ToString("dd/MM/yyyy") </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    อายุงาน
                                </h5>
                                <div>

                                    <div>
                                        @{
                                            DateTime startDate = dataEmp.StartDate;  // dataEmp.StartDate เป็น DateTime อยู่แล้ว
                                            DateTime now = DateTime.Now;

                                            // คำนวณจำนวนปี, เดือน, และวัน
                                            int years = now.Year - startDate.Year;
                                            int months = now.Month - startDate.Month;
                                            int days = now.Day - startDate.Day;

                                            // ถ้าเดือนติดลบ ให้ถอยปีออก 1
                                            if (months < 0)
                                            {
                                                years--;
                                                months += 12;
                                            }

                                            // ถ้าวันติดลบ ให้ถอยเดือนออก 1
                                            if (days < 0)
                                            {
                                                months--;
                                                // หาจำนวนวันในเดือนก่อนหน้าเพื่อนำมาบวก
                                                var previousMonth = now.AddMonths(-1);
                                                int daysInPreviousMonth = DateTime.DaysInMonth(previousMonth.Year, previousMonth.Month);
                                                days += daysInPreviousMonth;
                                            }

                                            <span>@years ปี, @months เดือน, @days วัน</span>
                                        }
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-xs-6 col-sm-4">
                            <div class="form-group">
                                <h5>
                                    สถานะพนักนักงาน

                                </h5>
                                @if (dataEmp.EmpStatus == "Active")
                                {
                                    <div class="text-success"><i class="fa fa-check-circle-o" aria-hidden="true"></i><span>ทำงาน/Working</span></div>
                                }
                                else
                                {
                                    <div class="text-danger"><i class="fa fa-times-circle-o" aria-hidden="true"></i><span>ลาออก/Resigned</span></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*flat able*@
        <div class="card flat-card p-2">
            <div class="card-header p-2">
                <h5>วันลาที่ใช้ไป</h5>
            </div>
            @if (ViewBag.LeaveOverview != null)
            {
                <div class="row-table">
                    @for (var i = 0; i < ViewBag.LeaveOverview.Count; i++)
                    {
                        var leav = ViewBag.LeaveOverview[i];
                        var icon = iconMapping.ContainsKey(i) ? iconMapping[i] : defaultIcon;
                        <div class="col-sm-3 card-body">
                            <div class="row">
                                <div class="col-sm-4">
                                    <i class="@icon text-c-green mb-1 d-block"></i>
                                </div>
                                <div class="col-sm-8 text-md-center p-0">
                                    <h5>@leav.TotalCount</h5>
                                    <span>@leav.LeaveType</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            }
            else
            {
                <div class="row-table ">
                    <div class="col-sm-3 card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <i class="icon feather icon-eye text-c-green mb-1 d-block"></i>
                            </div>
                            <div class="col-sm-8 text-md-center">
                                <h5>0</h5>
                                <span>ลากิจ | Business Leave</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3 card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <i class="icon feather icon-music text-c-green mb-1 d-block"></i>
                            </div>
                            <div class="col-sm-8 text-md-center">
                                <h5>0</h5>
                                <span>ลาป่วย | Sick Leave</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-3 card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <i class="icon feather icon-file-text text-c-green mb-1 d-block"></i>
                            </div>
                            <div class="col-sm-8 text-md-center">
                                <h5>0</h5>
                                <span>ลาพักร้อน | Annual Leave</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3 card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <i class="icon feather icon-mail text-c-green mb-1 d-block"></i>
                            </div>
                            <div class="col-sm-8 text-md-center">
                                <h5>0</h5>
                                <span>อื่นๆ/Other</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
    <div class="col-sm-5 col-md-4">
        @*Permission*@
        <div class="card-container permission-container">

            <div class="card card-primary p-2">
                <div class="card-header p-2">
                    <h5>สิทธิ์การเข้าถึง</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Permission.Count > 0)
                    {
                        foreach (var permis in ViewBag.Permission)
                        {
                            <span>@permis.Permission</span>
                        }
                    }
                    else
                    {
                        <span>ไม่พบข้อมูล</span>
                    }
                </div>
            </div>
            <div class="col-lg-12 col-md-12 p-0">
                <div class="card  p-2">
                    <div class="card-header p-2">
                        <h5> สิทธิคงเหลือ </h5>
                    </div>
                    @{
                        if (countListBalance == 0)
                        {
                            <div class="mt-3">
                                <div class="time-text text-center">
                                    <small>ไม่พบข้อมูล</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div id="item-list">
                                @{
                                    if (countListBalance == 0)
                                    {
                                        <div class="mt-3">
                                            <div class="time-text text-center">
                                                <small>ไม่พบข้อมูล</small>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var rowItem in (List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance)
                                        {
                                            <div class="mt-3" id="sub-item-list">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex flex-row align-items-center">
                                                        @*<span class="star"><i class="fa fa-star yellow"></i></span>*@
                                                        <span class="star font-bold">@rowItem.AccuredLeave</span>
                                                        <div class="d-flex flex-column">
                                                            <span>@rowItem.Description</span>
                                                            <div class="d-flex flex-row align-items-center time-text">
                                                                <small>ใช้สิทธิแล้ว (@rowItem.LeaveTaken)</small>
                                                                <span class="dots"></span>
                                                                <small>รออนุมัติ (@rowItem.WaitApprove)</small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span class="content-text-1">@rowItem.ClosingBal</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                <div class="mt-3 text-right text-primary" style="cursor: pointer;">
                                    <a id="view-more" value="View More" style=""> เพิ่มเติม <i class="fa fa-angle-double-down"> </i> </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @*แจ้งงาน / ปัญหา
                <div class="card-container pr-request-container">
                    <h3 class="">แจ้งงาน / ปัญหา</h3>
                    <div class="card card-primary card-pr-request">
                         <div class="card-header with-border">
                            <h3 class="card-title">Recently Added Products</h3>
                            <div class="card-tools pull-right">
                                <button type="button" class="btn btn-card-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                                <button type="button" class="btn btn-card-tool" data-widget="remove"><i class="fa fa-times"></i></button>
                            </div>
                        </div>

                        <div class="card-body">
                            ไม่มีรายการ
                        </div>

                    </div>
                </div>*@

        </div>
    </div>
    <div class="modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modal title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Modal body text goes here.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </div>
    </div>


</div>
<script>
    //set leave balance
    $('#item-list #sub-item-list').slice(5).hide();
    $('#view-more').click(function () {
        $('#item-list #sub-item-list').slice(5).toggle(); // Toggle the hidden items
        if ($(this).val() == "View More") {
            $(this).val("View Less");
            $(this).html("เพิ่มเติม <i class='fa fa-angle-double-down'> </i>");
        } else {
            $(this).val("View More");
            $(this).html("ย่อ <i class='fa fa-angle-double-up'> </i>");
        }
    });
</script>