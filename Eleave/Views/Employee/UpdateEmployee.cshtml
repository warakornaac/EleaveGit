@model Eleave.Models.StoreUpdateEmployeeProfile
@{
    ViewBag.Title = "แก้ไขข้อมูลพนักงาน | Modify Empolyee";

    var com = ViewBag.SearchCompany ?? string.Empty;
    var dept = ViewBag.SearchDept ?? string.Empty;
    var nam = ViewBag.SearchName ?? string.Empty;
    var emp = ViewBag.SearchEmpId ?? string.Empty;
}
<style>
    /* ปรับ dropdown ที่มีการใช้ select2 */
    .select2-container .select2-selection--single {
        display: inline-block;
        width: 100%;
        height: calc(1.5em + 1.25rem + 4px);
        padding: 0.625rem 2.1875rem 0.625rem 1.1875rem;
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.5;
        color: #495057;
        vertical-align: middle;
        background: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 5'%3e%3cpath fill='%23343a40' d='M2 0L0 2h4zm0 5L0 3h4z'/%3e%3c/svg%3e") no-repeat right 1.1875rem center/8px 10px;
        background-color: #fff;
        border: 2px solid rgba(0, 0, 0, 0.15);
        border-radius: 2px;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        cursor: default;
    }

    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #1abc9c;
        outline: 0;
        box-shadow: 0 0 0 0rem rgba(26, 188, 156, 0.25);
    }

    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background-color: #1abc9c;
        color: white
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #444;
    }

    .select2-container .select2-selection--single .select2-selection__rendered {
        padding-left: 0;
    }

    .select2-container .select2-selection--single:focus {
        border-color: #1abc9c;
        outline: 0;
        box-shadow: 0 0 0 0rem rgba(26, 188, 156, 0.25);
    }

    .select2-container:focus {
        border-color: #1abc9c;
        outline: 0;
        box-shadow: 0 0 0 0rem rgba(26, 188, 156, 0.25);
    }

    .select2-selection__arrow {
        display: none;
    }

    .select2-results__option select2-results__option--selectable .select2-results__option--selected .select2-results__option--highlighted {
        background-color: #1abc9c;
    }

    .select2-selection__rendered {
        line-height: 1.5rem !important; /* ปรับค่าให้ตรงกับขนาดความสูงของ select */
    }

    .select2-container--classic .select2-search--dropdown .select2-search__field {
        border-color: #1abc9c;
        outline: 0;
        box-shadow: 0 0 0 0rem rgba(26, 188, 156, 0.25);
    }

    .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: #1abc9c;
        outline: 0;
        box-shadow: 0 0 0 0rem rgba(26, 188, 156, 0.25);
    }
</style>
@*bread*@
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">แก้ไขข้อมูลผู้ใช้งาน | Modify Employee</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManagerEmployee", "Employee")">จัดการผู้ใช้งาน</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="col-xl-12 col-md-12">
    <div class="card table-card">
        <div class="card-header">
            <h5>แก้ไขข้อมูลพนักงาน | Modify Employee</h5>
            <input type="hidden" value="" id="" />
            <input type="hidden" value="" id="" />
            <input type="hidden" value="" id="" />
            <input type="hidden" value="" id="" />
            <span>กรุณากรอกข้อมูลที่มีเครื่องหมาย (<span class="text-danger">*</span>) ให้ครบถ้วน</span>
            <span>| Please complete data with (<span class="text-danger">*</span>) </span>
        </div>
        <div class="card-body p-3 d-flex justify-content-center">
            @using (Html.BeginForm("UpdateEmployee", "Employee", FormMethod.Post, new { id = "update-employee-form" }))
            {
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmpId, "รหัสพนักงาน | Employee ID")
                            @Html.TextBoxFor(model => model.EmpId, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Company, "บริษัท | Company")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.Company, new List<SelectListItem>
                                               {
                                                    new SelectListItem() {Text="AAC", Value="AAC"},
                                                    new SelectListItem() {Text="TRU", Value="TRU"},
                                                    new SelectListItem(){Text="OMP",Value="OMP"}
                                               }, "เลือกบริษัท|Select Company", new { @class = "custom-select", @id = "comp-selector" })
                            <span class="text-danger" id="alert-comp" hidden>กรุณาเลือกบริษัท | Please select a company</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.TitleName, "คำนำหน้า | Title")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.TitleName, new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text="นาย", Value="นาย"},
                                                    new SelectListItem() {Text="นาง", Value="นาง"},
                                                    new SelectListItem(){Text="นางสาว",Value="นางสาว"},
                                                    new SelectListItem() {Text="Mr", Value="Mr"},
                                                    new SelectListItem() {Text="Ms", Value="Ms"},
                                                    new SelectListItem() {Text="Mrs", Value="Mrs"}
                                                }, "เลือกคำนำหน้า|Select title", new { @class = "custom-select", @id = "title-selector" })
                            <span class="text-danger" id="alert-title" hidden>กรุณาเลือกบริษัท | Please select a company</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FirstName, "ชื่อ | First Name")<span class="text-danger">*</span>
                            @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", @id = "fname-tbx" })
                            @* @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })*@
                            <span class="text-danger" id="alert-fname" hidden>กรุณากรอกชื่อ | Please enter first name</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.LastName, "นามสกุล | Last Name")<span class="text-danger">*</span>
                            @Html.TextBoxFor(model => model.LastName, new { @class = "form-control", @id = "lname-tbx" })
                            @*  @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })*@
                            <span class="text-danger" id="alert-lname" hidden>กรุณากรอกนามสกุล | Please enter last name</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Email, "อีเมล | E-mail")
                            @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @id = "email-tbx" })
                            <span class="text-danger" id="alert-email" hidden>กรุณากรอกอีเมล | Please enter email</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DeptId, "หน่วยงาน | Department")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.DeptId, new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "เลือกหน่วยงาน|Select Department", new { @class = "custom-select", @id = "department-selector" })
                            <span class="text-danger" id="alert-dept" hidden>กรุณาเลือกแผนก | Please select a department</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Position, "ตำแหน่ง | Position")<span class="text-danger">*</span>
                            @Html.TextBoxFor(model => model.Position, new { @class = "form-control", @id = "pos-selector" })
                            <span class="text-danger" id="alert-position" hidden>Please select a position | กรุณาเลือกตำแหน่ง</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DirectorId, "หัวหน้างาน |Director")@*<span class="text-danger">*</span>*@
                            @*@Html.TextBoxFor(model => model.DirectorId, new { @class = "form-control", list = "directors-list" })*@
                            @Html.DropDownListFor(model => model.DirectorId, new SelectList(ViewBag.Directors, "EmpId", "Fullname"), "เลือกหัวหน้างาน|Select Director", new { @class = "custom-select", @id = "directors-selector" })
                            <span class="text-danger" id="alert-director" hidden>กรุณาเลือกหัวหน้างาน | Please select a director</span>
                            @*<datalist id="directors-list">
                                    @foreach (var director in ViewBag.Directors)
                                    {
                                        <option value="@director.EmpId">@director.Fullname</option>
                                    }
                                </datalist>*@
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmpLvl, "ระดับพนักงาน | Employee Level")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.EmpLvl, new SelectList(ViewBag.EmpLevel, "LookValue", "LookDesc"), "เลือกระดับพนักงาน|Select Employee Level", new { @class = "custom-select", @id = "emplvl-selector" })
                            <span class="text-danger" id="alert-emplvl" hidden>กรุณาเลือกระดับพนักงาน | Please select a employee level</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.ApprGrpID, "กลุ่มอนุมัติ | Approval Group")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.ApprGrpID, new SelectList(ViewBag.ApprovFlow, "ApprGrpId", "DisplayText"), "เลือกกลุ่มอนุมัติ|Select Approval Group", new { @class = "custom-select", @id = "approval-selector" })
                            <span class="text-danger" id="alert-apprvgrp" hidden>กรุณาเลือกกลุ่มอนุมัติ | Please select a approval group</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.UserType, "ประเภทผู้ใช้ | User Type")<span class="text-danger">*</span>
                            @Html.DropDownListFor(model => model.UserType, new SelectList(ViewBag.usrtyp, "TypeVal", "UsrTypeName"), "เลือกประเภทผู้ใช้|Select User Type", new { @class = "custom-select", @id = "usrtyp-selector" })
                            <span class="text-danger" id="alert-usrtyp" hidden>กรุณาเลือกประเภทผู้ใช้ | Please select a user type</span>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmpTypeId, "ประเภทพนักงาน | Employee Type")
                            @Html.DropDownListFor(model => model.EmpTypeId, new SelectList(ViewBag.EmpTyp, "LookValue", "LookDesc"), "เลือกประเภทพนักงาน|Select Employee Type", new { @class = "custom-select", @id = "emptyp-selector" })

                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.StartDate, "วันเริ่มงาน | Start Date")
                            @Html.TextBoxFor(model => model.StartDate, new { @class = "form-control", id = "start-date" })
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmpStatus, "สถานะพนักงาน | Employee Status")
                            @Html.DropDownListFor(model => model.EmpStatus, new SelectList(ViewBag.EmpSta, "LookValue", "LookDesc"), new { @class = "custom-select", @id = "empStatusDropdown" })
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.LabelFor(model => model.TempId, "รหัสพนักงานชั่วคราว | Temp ID")
                            @Html.TextBoxFor(model => model.TempId, new { @class = "form-control", id = "temp-id" })
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="float-end">
                        @*<input type="submit" value="บันทึก" class="btn btn-success" />*@
                        <Button type="submit" class="btn btn-success">บันทึก | SAVE</Button>

                    </div>
                    <div class="float-left">
                        <input type="button" value="ย้อนกลับ | BACK" class="btn btn-secondary" onclick="history.back();" id="back-btn" />
                    </div>

                </div>



            }
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#department-selector').select2({
            width: '100%'
        });
        $('#directors-selector').select2({
            width: '100%'
        });
        $('#approval-selector').select2({
            width: '100%'
        });
        $('#start-date').datepicker({
            orientation: "bottom auto",
            format: "dd/mm/yyyy",
            autoclose: true
        });
    });
    $(document).ready(function () {
        $('#update-employee-form').submit(function (even) {
            var alrt = 0;
            var comp = $('#comp-selector').val();
            var title = $('#title-selector').val();
            var fname = $('#fname-tbx').val();
            var lname = $('#lname-tbx').val();
            var email = $('#email-tbx').val();
            var dept = $('#department-selector').val();
            var position = $('#pos-selector').val();
            var director = $('#directors-selector').val();
            var emplvl = $('#emplvl-selector').val();
            var apprv = $('#approval-selector').val();
            var usrtyp = $('#usrtyp-selector').val();
            if (comp === '' || comp === null) {
                alrt++;
                $('#alert-comp').removeAttr('hidden');
            }
            else {
                $('#alert-comp').attr('hidden',true);
            }
            if (title === '' || title === null) {
                alrt++;
                $('#alert-title').removeAttr('hidden');
            }
            else {
                $('#alert-title').attr('hidden', true);
            }
            if (fname === '' || fname === null) {
                alrt++;
                $('#alert-fname').removeAttr('hidden');
            }
            else {
                $('#alert-fname').attr('hidden', true);
            }
            if (lname === '' || lname === null) {
                alrt++;
                $('#alert-lname').removeAttr('hidden');
            }
            else {
                $('#alert-lname').attr('hidden', true);
            }
            if (dept === '' || dept === null) {
                alrt++;
                $('#alert-dept').removeAttr('hidden');
            }
            else {
                $('#alert-dept').attr('hidden', true);
            }
            if (position === '' || position === null) {
                alrt++;
                $('#alert-position').removeAttr('hidden');
            }
            else {
                $('#alert-position').attr('hidden', true);
            }
            if (emplvl === '0') {
                $('#alert-director').attr('hidden', true);
            }
            else {
                if (director === '' || director === null ) {
                    alrt++;
                    $('#alert-director').removeAttr('hidden');
                }
                else {
                    $('#alert-director').attr('hidden', true);
                }
            }

            if (emplvl === '' || emplvl === null) {
                alrt++;
                $('#alert-emplvl').removeAttr('hidden');
            }
            else if (emplvl === 1 || emplvl === 2 || emplvl === 3) {
                $('#alert-emplvl').attr('hidden', true);
                if (email === '' || email === null) {
                    alrt++;
                    $('#alert-email').removeAttr('hidden');
                }
                else {
                    $('#alert-email').attr('hidden', true);
                }
            }
            else {
                $('#alert-emplvl').attr('hidden', true);
                $('#alert-email').attr('hidden', true);
            }
            if (apprv === '' || apprv === null) {
                alrt++;
                $('#alert-apprvgrp').removeAttr('hidden');
            }
            else {
                $('#alert-apprvgrp').attr('hidden', true);
            }
            if (usrtyp === '' || usrtyp === null) {
                alrt++;
                $('#alert-usrtyp').removeAttr('hidden');
            }
            else {
                $('#alert-usrtyp').attr('hidden', true);
            }

            if (alrt > 0) {
                even.preventDefault()
                return false;
            }
        });
    });
    if ('@ViewBag.Error' != '') {
        Swal.fire({
            title: 'Error',
            html: '@ViewBag.Error',
            icon: 'error'
        });
    }
    @*if ("@ViewBag.UpdateStatus" === "Success") {
        Swal.fire({
            title: "@ViewBag.UpdateStatus",
            text: "Update ข้อมูลพนักงานสำเร็จ | Update Success.",
            icon: "success"
        }).then(() => {
            window.location.href = "@Url.Action("ManagerEmployee", "Employee")";
        });
    }*@

    $(document).on('click', '#back-btn', function () {
        let form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ManagerEmployee", "Employee")';

            let inputs = [
                { name: "Company", value: "@com" },
                { name: "Department", value: "@dept" },
                { name: "Name", value: "@nam" },
                { name: "EmpID", value: "@emp" }
            ];

            inputs.forEach(data => {
                let input = document.createElement('input');
                input.type = 'hidden';
                input.name = data.name;
                input.value = data.value;
                form.appendChild(input);
            });

            document.body.appendChild(form);
            form.submit();
    });
    if ("@ViewBag.UpdateStatus" === "Success") {
        Swal.fire({
            title: "Success",
            text: "Update ข้อมูลพนักงานสำเร็จ | Update Success.",
            icon: "success"
        }).then(() => {
            // สร้างฟอร์มเพื่อส่งค่ากลับไปที่ Controller
            let form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ManagerEmployee", "Employee")';

            // เพิ่ม input ซ่อนที่เก็บค่าจาก ViewBag
            let inputs = [
                { name: "Company", value: "@com" },
                { name: "Department", value: "@dept" },
                { name: "Name", value: "@nam" },
                { name: "EmpID", value: "@emp" }
            ];

            // สร้าง input แต่ละตัวและเพิ่มเข้าไปในฟอร์ม
            inputs.forEach(data => {
                let input = document.createElement('input');
                input.type = 'hidden';
                input.name = data.name;
                input.value = data.value;
                form.appendChild(input);
            });

            // เพิ่มฟอร์มใน body และทำการ submit
            document.body.appendChild(form);
            form.submit();
        });
    }




</script>

