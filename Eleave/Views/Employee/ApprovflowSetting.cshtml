    function AddApprvFlow() {
        var apprvId = $('#groupId-add').val();
        var apprvNm = $('#groupName-add').val();
        var deptVal = $('#department-selector-add').val();
        var stepNum = $('#apprvLvl-add').val();
        var emp = $('#empId-add').val();
        var actionTex = $('#actiontyp-add').val();
        var apprvDesc = $('#apprvDesc-add').val();

        $.ajax({
            url: '@Url.Action("AddApprvFlow", "Employee")',
            data: {
                apprvID: apprvId,
                apprvName: apprvNm,
                dept: deptVal,
                step: stepNum,
                empId: emp,
                action: actionTex,
                desc: apprvDesc
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#addFormModal').modal('hide');
                LoadingShow();
            },
            success: function (data) {
                LoadingHide();
                if (data.message == "Y") {
                    Swal.fire({
                        title: "Success",
                        text: "Add approval successful. | เพิ่มการอนุมัติสำเร็จ",
                        icon: "success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                }
                else {
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    }).then(() => {
                        $('#addFormModal').modal('show');
                    });
                }
            }
        })
    }
    function UpdateApprvFlow() {
        var apprvID = $('#groupId-edit').val();
        var apprvNmold = $('#groupName-edit-old').val();
        var apprvNm = $('#groupName-edit').val();
        var deptVal = $('#department-selector-edit').val();
        var oldstepNum = $('#ApprvLvl-edit-old').val();
        var stepNum = $('#ApprvLvl-edit').val();
        var empId = $('#empid-edit').val();
        var actionTex = $('#actiontyp-edit').val();
        var apprvDesc = $('#apprvDesc-edit').val();
        if (apprvNm === null || apprvNm.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approval group. | กรุณากรอกชื่อกลุ่มอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (deptVal === null || deptVal.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select department. | กรุณาเลือกแผนก",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (stepNum === null || stepNum.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approval level. | กรุณาเลือกลำดับการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (empId === null || empId.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approver. | กรุณาเลือกผู้ทำการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (apprvDesc === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณากรอกรายละเอียด",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }


        $.ajax({
            url: '@Url.Action("UpdateApprvFlow", "Employee")',
            data: {
                apprvID: apprvID ,
                oldApprvName: apprvNmold,
                apprvName: apprvNm,
                dept: deptVal,
                oldStep: oldstepNum,
                step: stepNum,
                empId: empId,
                action: actionTex,
                desc: apprvDesc
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                LoadingShow();
            },
            success: function (data) {
                LoadingHide();
                if (data.message === 'Y') {
                    Swal.fire({
                        title: "Success",
                        text: "Update Success",
                        icon: "success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                    $('#editFormModal').modal('hide');
                }
                else {
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    });
                }
            }
        });
    }
</script>