                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Description | รายละเอียดประเภทอนุมัติ")
                            @Html.TextArea("ApprvDesc", null, new { @class = "form-control", @id = "apprvDesc-edit" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
                <button type="button" class="btn btn-primary" onclick="UpdateApprvFlow();">Confirm | ยืนยัน</button>
            </div>
        </div>
    </div>
</div>
