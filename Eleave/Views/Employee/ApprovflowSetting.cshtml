    function GetApprovalID(department) {
    $.ajax({
        url: '@Url.Action("GetApprvID", "Employee")',
        data: {
            Dept: department
        },
        type: 'POST',
        dataType: 'JSON',
        success: function (data) {
            if (data.message === 'Y') {
                var datalist = $('#list-ApprvFlowID');
                datalist.empty();
                $(data.GrpvID).each(function (index, item) {
                    datalist.append($('<option>').val(item.ApprGrpId).text(item.ApprGrpName));
                });
            } else {
                console.log('Error GetID: ' + data.message);
            }
        },
        error: function (xhr, status, error) {
            console.log('AJAX error: ' + status + ' - ' + error);
        }
    });
}

