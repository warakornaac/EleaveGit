    async function GetApprovflowSettingEdit(ApprvID, ApprvName, ApprvStep, ApprvDept, ApprvAction) {
        return $.ajax({
            url: '@Url.Action("GetApprovflowSettingEdit", "Employee")',
            data: {
                ApprvGrp: ApprvID,
                ApprvName: ApprvName,
                ApprvStep: ApprvStep,
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#groupName-edit-old').val('');
                $('#groupName-edit').val('');
                $('#department-selector-edit').val('').trigger('change');
                $('#ApprvLvl-edit-old').val('');
                $('#ApprvLvl-edit').val('').trigger('change');
                $('#empid-edit').val('').trigger('change');
                $('#actiontyp-edit').val('').trigger('change');
                $('#apprvDesc-edit').val('');
            },
            success: function (res) {
                if (res.message === "Y") {
                    if (res.getApproval && res.getApproval.length > 0) {
                        $('#groupName-edit-old').val(res.getApproval[0].ApprGrpName);
                        $('#groupName-edit').val(res.getApproval[0].ApprGrpName);
                        var dept = res.getApproval[0].DepId.trim();

                        var shortDept = dept.substring(0, 3);
                        console.log(dept);

                        $('#department-selector-edit option').each(function () {
                            var optionValue = $(this).val();
                            if (optionValue.includes(shortDept) ) {
                                console.log('depert option: ' + optionValue);
                                $('#department-selector-edit').val(optionValue).trigger('change');
                                return false;
                            }
                        });
                        //$('#department-selector-edit').val(ApprvDept).trigger('change');

                        $('#ApprvLvl-edit-old').val(res.getApproval[0].ApprStep);
                        $('#ApprvLvl-edit').val(res.getApproval[0].ApprStep).trigger('change');
                        var emp = res.getApproval[0].EmpId;
                        console.log('Head: ' + emp);
                        $('#empid-edit').val(res.getApproval[0].EmpId).trigger('change');
                        if (res.getApproval[0].ActionType) {
                            $('#actiontyp-edit').val(res.getApproval[0].ActionType.trim()).trigger('change');
                        }
                        $('#apprvDesc-edit').val(res.getApproval[0].ApprDesc)
                    }
                }
            }

        });
    }

