<div class="row">
    <div class="col-xl-12" `>
        <div class="card">
            @using (Html.BeginForm("ApprovflowSetting", "Employee", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.Label("Department | แผนก")
                                @Html.DropDownList("DeptID", new SelectList(ViewBag.DepartmentList, "LookParam", "LookDesc"), "Select department | เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-search" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.Label("Approval Group ID | รหัสกลุ่มอนุมัติ")
                                @Html.DropDownList("ApprvGrp", new SelectList(ViewBag.apprvFlowSelect, "ApprGrpId", "ApprGrpName"), "ALL", new { @class = "custom-select", @id = "apprv-search" })
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer p-1">
                    <div class="form-group float-start m-2">
                        <button class="btn btn-success float-start m-1" type="button" id="addFlowbtn">Add | เพิ่ม</button>
                    </div>
                    <div class="form-group float-end m-2">
                        <input type="button" value="Clear | ล้าง" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="Search | ค้นหา" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="apprv-flow-table">
                        <thead>
                            <tr>
                                <th class="text-center">Approval group ID | รหัสกลุ่มอนุมัติ</th>
                                <th class="text-center">Approval group name | ชื่อกลุ่มอนุมัติ</th>
                                <th class="text-center">Department ID | รหัสแผนก</th>
                                <th class="text-center">Approval level|ลำดับการอนุมัติ</th>
                                <th class="text-center">Approver | พนักงานผู้อนุมัติ</th>
                                <th class="text-center">Approver Type | ประเภทอนุมัติ</th>
                                <th class="text-center">Edit | แก้ไข <br />Delete | ลบ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var aprflow in ViewBag.apprvFlow)
                                {
                                    <tr>
                                        <td class="text-center">@aprflow.ApprGrpId</td>
                                        <td class="text-center">@aprflow.ApprGrpName</td>
                                        <td class="text-center">@aprflow.DepName</td>
                                        <td class="text-center">@aprflow.ApprStep</td>
                                        <td class="text-center">@aprflow.EmpName</td>
                                        <td class="text-center">@aprflow.ActionType</td>
                                        <td class="text-center p-2">
                                            <a href="#" class="btn btn-warning btn-xs" data-apprv="@aprflow.ApprGrpId" data-apprvname="@aprflow.ApprGrpName" data-department="@aprflow.DepId" data-dept="@aprflow.DeptShort" data-apprvstep="@aprflow.ApprStep" data-apprvaction="@aprflow.ActionType" id="editApprv-@aprflow.ApprGrpId"><span class="fa fa-edit"></span></a>
                                            <a href="#" class="btn btn-danger btn-xs" id="deleteApprv-@aprflow.ApprGrpId" data-apprv="@aprflow.ApprGrpId" data-apprvname="@aprflow.ApprGrpName" data-department="@aprflow.DepId" data-dept="@aprflow.DeptShort" data-apprvstep="@aprflow.ApprStep" data-apprvaction="@aprflow.ActionType"><span class="fa fa-times"></span></a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#department-search').select2({
            width: '100%'
        });
        $('#apprv-search').select2({
            width: '100%'
        });
        $('#department-selector-add').select2({
            dropdownParent: $('#addFormModal'),
            width: '100%'
        });
        $('#department-selector-edit').select2({
            dropdownParent: $('#editFormModal'),
            width: '100%'
        });
        $('#empid-edit').select2({
            dropdownParent: $('#editFormModal'),
            width: '100%'
        });
    });

    $(document).on('click', '#addFlowbtn', function () {
        $('#addFormModal').modal('show');
    });
    $(document).ready(function () {
        $('#apprv-flow-table').dataTable({
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: " _START_ to _END_ from _TOTAL_ Group",
                infoEmpty: "No data display.| ไม่มีข้อมูลให้แสดง"
            }
        });
    });
    $(document).on('click', '#addFlowbtn', function () {
        $('#groupId-add').val('');
        $('#groupName-add').val('');
        $('#apprvDesc-add').val('');
        $('#department-selector-add').val('').trigger('change');
        $('#apprvLvl-add').val('');
        $('#empId-add').val('').trigger('change');
        $('#actiontyp-add').val('').trigger('change');

        DropdownEmpSelectAdd();
    });
    $(document).on('click', '#addApprove-btn', function () {
        var apprvID = $('#groupId-add').val();
        var apprvNm = $('#groupName-add').val();
        var deptVal = $('#department-selector-add').val();
        var stepNum = $('#apprvLvl-add').val();
        var empId = $('#empId-add').val();
        var actionTex = $('#actiontyp-add').val();
        var apprvDesc = $('#apprvDesc-add').val();
        if (apprvID == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Approval group ID is not found,please verify your data !!! | ไม่พบรหัสรหัสกลุ่มอนุมัติ กรุณาตรวจสอบข้อมูล",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (apprvNm == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please enter approval group name. | กรุณากรอกชื่อกลุ่มอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (deptVal === "" || deptVal === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select department.| กรุณาเลือกแผนก",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });

            return false;
        }
        if (stepNum === "" || stepNum === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approval level.| กรุณาเลือกลำดับการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (empId === "" || empId === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approver. | กรุณาเลือกพนักงานผู้อนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (actionTex === "" || actionTex === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please select approval type. | กรุณาเลือกประเภทอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (apprvDesc == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "Please enter aprroval description. | กรุณากรอกรายละเอียดขั้นตอนอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        AddApprvFlow();
    });

    $(document).on('focusout', '#groupId-add', function () {
        var grpID = $(this).val();
        if (grpID != '' ) {
            GetDepartForEdit(grpID);
        }
        GenerateApprvStep(grpID);
    });
    function GetDepartForEdit(GropID) {
        $.ajax({
            url: '@Url.Action("GetDepartmentEditApprvFlow", "Employee")',
            data: {
                GrpId: GropID
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#department-selector-add').prop('disabled', false);
            },
            success: function (data) {
                if (data.message == 'Y') {

                    $('#department-selector-add').val(data.DepID).trigger('change');
                    $('#department-selector-add').prop('disabled', true);
                }
                else {
                    $('#department-selector-add').prop('disabled', true);
                    $('#addFormModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    }).then(() => {
                        $('#addFormModal').modal('show');
                    });

                }
            }
        })
    }
    function GenApprv(depart) {
        var selectApprv = $('#select-addApprv').val();
        console.log('SELECT HOW');
        if (selectApprv == 1) {
            GenerateApprvGrbID(depart);
        }
        else {
            GetApprovalID('');
        }
    }

    $(document).on('click', '#reset-btn', function () {
        $('#department-search').val('').trigger('change');
        $('#apprv-search').val('').trigger('change');
    }),
    $(document).on('change', '#select-addApprv', function () {
        var selectVal = $(this).val();
        var em = ''
        if (selectVal == 2) {
            $('#groupId-add').removeAttr('readonly');
            $('#department-selector-add').prop('disabled', true);
            GetApprovalID(em);
        }
        else {
            $('#groupId-add').attr('readonly', true);
            $('#department-selector-add').prop('disabled', false);
        }
    });
    $('[id^="editApprv-"]').on('click', async function () {
        var ApprvID = $(this).data('apprv');
        var ApprvName = $(this).data('apprvname');
        var ApprvStep = $(this).data('apprvstep');
        var ApprvDept = $(this).data('dept');
        var ApprvAction = $(this).data('apprvaction');
        var Dept = $(this).data('department');
        $('#groupId-edit').val(ApprvID);
        $('#editFormModal').modal('show');
        if (ApprvAction == 'Acknowledge') {
             DropdownEmpSelectEditAsync('Ack');
        }
        else {
             DropdownEmpSelectEditAsync(ApprvDept);
        }
        await GetApprovflowSettingEdit(ApprvID, ApprvName, ApprvStep, ApprvDept, ApprvAction);

    });
    $('[id^="deleteApprv-"]').on('click', async function () {
