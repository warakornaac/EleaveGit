
@{
    ViewBag.Title = "ตั้งค้า-กำหนดลำดับการอนุมัติ";
}

<style>
    .swal-custom-zindex {
        z-index: 1060 !important;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">กำหนดลำดับการอนุมัติ</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ApprovflowSetting", "Employee")">กำหนดลำดับการอนุมัติ</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add-->
<div class="modal fade" id="addFormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">เพิ่ม Approve Flow</h5>

                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">ปิด</button>

            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label>การเพิ่มอนุมัต</label>
                            <select class="custom-select" id="select-addApprv">
                                <option value="1">เพิ่มกลุ่มอนุมัต</option>
                                <option value="2">เพิ่มลำดับการอนุมัติ</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("รหัสกลุ่มอนุมัติ")
                            @Html.TextBox("GroupID", null, new { @class = "form-control", @id = "groupId-add", @readonly = "readonly", list = "list-ApprvFlowID" })
                            <datalist id="list-ApprvFlowID">
                                <option value="dataTest">Group</option>
                            </datalist>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("ชื่อกลุ่มอนุมัติ")
                            @Html.TextBox("GroupName", null, new { @class = "form-control", @id = "groupName-add" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("แผนก")
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-selector-add", onchange = "GenApprv(this.value)" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("ลำดับการอนุมัติ")
                            @Html.TextBox("ApprvLvl", null, new { @class = "custom-select", @id = "apprvLvl-add", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("พนักงานผู้อนุมัติ")
                            @Html.DropDownList("EMPID", new List<SelectListItem>
                       {

                       }, "เลือกพนักงาน", new { @class = "custom-select", @id = "empId-add" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("ประเภทอนุมัติ")
                            @Html.DropDownList("ActionType", new List<SelectListItem>
                                               {
                                                   new SelectListItem(){Text="Approve", Value="Approve"},
                                                   new SelectListItem(){Text="Acknowledge", Value="Acknowledge"}
                                               }, "เลือกประเภทอนุมัติ", new { @class = "custom-select", @id = "actiontyp-add" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("รายระเอียดประเภทอนุมัติ")
                            @Html.TextArea("ApprvDesc", null, new { @class = "form-control", @id = "apprvDesc-add" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
                <button type="button" class="btn btn-primary" id="addApprove-btn">ยืนยัน</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Edit-->
<div class="modal fade" id="editFormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editformModel">แก้ไข Approve Flow</h5>
                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">ปิด</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("รหัสกลุ่มอนุมัติ")
                            @Html.TextBox("GroupID", "", new { @class = "form-control", @id = "groupId-edit", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("ชื่อกลุ่มอนุมัติ")
                            @Html.TextBox("GroupName", "", new { @class = "form-control", @id = "groupName-edit" })
                            @Html.Hidden("GroupNameVal", null, new { @id = "groupName-edit-old" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("แผนก")
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookParam", "LookDesc"), "เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-selector-edit", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Hidden("ApprvLvl_Hidden", null, new { @id = "ApprvLvl-edit-old" })
                            @Html.Label("ลำดับการอนุมัติ")
                            @Html.DropDownList("ApprvLvl", new List<SelectListItem>
                                                           {
                                                            new SelectListItem() {Text="1",Value="1"},
                                                            new SelectListItem() {Text="2",Value="2"},
                                                            new SelectListItem() {Text="3",Value="3"},
                                                            new SelectListItem() {Text="4",Value="4"},
                                                            new SelectListItem() {Text="5",Value="5"},
                                                           }, "Approve Level", new { @class = "custom-select", @id = "ApprvLvl-edit" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("พนักงานผู้อนุมัติ")
                            @Html.DropDownList("EMPID", new List<SelectListItem>
                                               {

                                               }, "เลือกพนักงาน", new { @class = "custom-select", @id = "empid-edit" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("ประเภทอนุมัติ")
                            @Html.DropDownList("ActionType", new List<SelectListItem>
                                               {
                                                   new SelectListItem(){Text="Approve", Value="Approve"},
                                                   new SelectListItem(){Text="Acknowledge", Value="Acknowledge"}
                                               }, new { @class = "custom-select", @id = "actiontyp-edit" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("รายระเอียดประเภทอนุมัติ")
                            @Html.TextArea("ApprvDesc", null, new { @class = "form-control", @id = "apprvDesc-edit" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
                <button type="button" class="btn btn-primary" onclick="UpdateApprvFlow();">ยืนยัน</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12" `>
        <div class="card">
            @using (Html.BeginForm("ApprovflowSetting", "Employee", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.Label("แผนก")
                                @Html.DropDownList("DeptID", new SelectList(ViewBag.DepartmentList, "LookParam", "LookDesc"), "เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-search" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                @Html.Label("รหัสกลุ่มอนุมัติ")
                                @Html.DropDownList("ApprvGrp", new SelectList(ViewBag.apprvFlow, "ApprGrpId", "ApprGrpName"), "ALL", new { @class = "custom-select", @id = "apprv-search" })
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer p-1">

                    <div class="form-group float-start m-2">
                        <button class="btn btn-secondary float-start m-1" type="button" id="addFlowbtn">ADD/เพิ่ม</button>
                    </div>
                    <div class="form-group float-end m-2">
                        <input type="button" value="ล้าง" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="ค้นหา" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="apprv-flow-table">
                        <thead>
                            <tr>
                                <th class="text-center">รหัสกลุ่มอนุมัติ</th>
                                <th class="text-center">ชื่อกลุ่มอนุมัติ</th>
                                <th class="text-center">รหัสแผนก</th>
                                <th class="text-center">ลำดับการอนุมัติ</th>
                                <th class="text-center">พนักงานผู้อนุมัติ</th>
                                <th class="text-center">ประเภทอนุมัติ</th>
                                <th class="text-center">แก้ไข</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var aprflow in ViewBag.apprvFlow)
                                {
                                    <tr>
                                        <td class="text-center">@aprflow.ApprGrpId</td>
                                        <td class="text-center">@aprflow.ApprGrpName</td>
                                        <td class="text-center">@aprflow.DepId</td>
                                        <td class="text-center">@aprflow.ApprStep</td>
                                        <td class="text-center">@aprflow.EmpName</td>
                                        <td class="text-center">@aprflow.ActionType</td>
                                        <td class="text-center"><a href="#" data-apprv="@aprflow.ApprGrpId" data-apprvname="@aprflow.ApprGrpName" data-apprvstep="@aprflow.ApprStep" id="editApprv-@aprflow.ApprGrpId">แก้ไข</a></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#department-search').select2({
            width: '100%'
        });
        $('#apprv-search').select2({
            width: '100%'
        });
        $('#department-selector-add').select2({
            dropdownParent: $('#addFormModal'),
            width: '100%'
        });
        $('#department-selector-edit').select2({
            dropdownParent: $('#editFormModal'),
            width: '100%'
        });
        $('#empid-edit').select2({
            dropdownParent: $('#editFormModal'),
            width: '100%'
        });
    });

    $(document).on('click', '#addFlowbtn', function () {
        $('#addFormModal').modal('show');
    });



    $(document).ready(function () {

        $('#apprv-flow-table').dataTable({
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ กลุ่ม",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });
    $(document).on('click', '#addFlowbtn', function () {
        $('#groupId-add').val('');
        $('#groupName-add').val('');
        $('#apprvDesc-add').val('');
        $('#department-selector-add').val('').trigger('change');
        $('#apprvLvl-add').val('');
        $('#empId-add').val('').trigger('change');
        $('#actiontyp-add').val('').trigger('change');

        DropdownEmpSelectAdd();
    });
    $(document).on('click', '#addApprove-btn', function () {
        var apprvID = $('#groupId-add').val();
        var apprvNm = $('#groupName-add').val();
        var deptVal = $('#department-selector-add').val();
        var stepNum = $('#apprvLvl-add').val();
        var empId = $('#empId-add').val();
        var actionTex = $('#actiontyp-add').val();
        var apprvDesc = $('#apprvDesc-add').val();
        if (apprvID == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "ไม่พบรหัสรหัสกลุ่มอนุมัติ กรุณาตรวจสอบข้อมูล",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (apprvNm == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณากรอกชื่อกลุ่มอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (deptVal === "" || deptVal === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกแผนก",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });

            return false;
        }
        if (stepNum === "" || stepNum === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกลำดับการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (empId === "" || empId === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกพนักงานผู้อนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (actionTex === "" || actionTex === null) {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกประเภทอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        if (apprvDesc == "") {
            $('#addFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณากรอกรายระเอียดขั้นตอนอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#addFormModal').modal('show');
            });
            return false;
        }
        AddApprvFlow();
    });

    $(document).on('focusout', '#groupId-add', function () {
        var grpID = $(this).val();
        if (grpID != '' ) {
            GetDepartForEdit(grpID);
        }
        GenerateApprvStep(grpID);
    });
    function GetDepartForEdit(GropID) {
        $.ajax({
            url: '@Url.Action("GetDepartmentEditApprvFlow", "Employee")',
            data: {
                GrpId: GropID
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#department-selector-add').prop('disabled', false);
            },
            success: function (data) {
                if (data.message == 'Y') {

                    $('#department-selector-add').val(data.DepID).trigger('change');
                    $('#department-selector-add').prop('disabled', true);
                }
                else {
                    $('#department-selector-add').prop('disabled', true);
                    $('#addFormModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    }).then(() => {
                        $('#addFormModal').modal('show');
                    });

                }
            }
        })
    }
    //$(document).on('change', '#department-selector-add', function () {
    //    var depart = $(this).val();
    //    var selectApprv = $('#select-addApprv').val();
    //    console.log('SELECT HOW');
    //    if (selectApprv == 1) {
    //        GenerateApprvGrbID(depart);
    //    }
    //    else {
    //        GetApprovalID(depart);
    //    }

    //});
    function GenApprv(depart) {
        var selectApprv = $('#select-addApprv').val();
        console.log('SELECT HOW');
        if (selectApprv == 1) {
            GenerateApprvGrbID(depart);
        }
        else {
            GetApprovalID('');
        }
    }

    $(document).on('click', '#reset-btn', function () {
        $('#department-search').val('').trigger('change');
        $('#apprv-search').val('').trigger('change');

    }),
    $(document).on('change', '#select-addApprv', function () {
        var selectVal = $(this).val();
        var em = ''
        if (selectVal == 2) {
            $('#groupId-add').removeAttr('readonly');
            $('#department-selector-add').prop('disabled', true);
            GetApprovalID(em);
        }
        else {
            $('#groupId-add').attr('readonly', true);
            $('#department-selector-add').prop('disabled', false);
        }

    });

    $('[id^="editApprv-"]').on('click', function () {
        var ApprvID = $(this).data('apprv');
        var ApprvName = $(this).data('apprvname');
        var ApprvStep = $(this).data('apprvstep');
        $('#groupId-edit').val(ApprvID);
        $('#editFormModal').modal('show');
        DropdownEmpSelectEdit();
        $.ajax({
            url: '@Url.Action("GetApprovflowSettingEdit", "Employee")',
            data: {
                ApprvGrp: ApprvID,
                ApprvName: ApprvName,
                ApprvStep: ApprvStep,
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#groupName-edit-old').val('');
                $('#groupName-edit').val('');
                $('#department-selector-edit').val('').trigger('change');
                $('#ApprvLvl-edit-old').val('');
                $('#ApprvLvl-edit').val('').trigger('change');
                $('#empid-edit').val('').trigger('change');
                $('#actiontyp-edit').val('').trigger('change');
                $('#apprvDesc-edit').val('');
            },
            success: function (res) {
                if (res.message === "Y") {
                    if (res.getApproval && res.getApproval.length > 0) {
                        $('#groupName-edit-old').val(res.getApproval[0].ApprGrpName);
                        $('#groupName-edit').val(res.getApproval[0].ApprGrpName);
                        var dept = res.getApproval[0].DepId.trim();

                        var shortDept = dept.substring(0, 3);
                        console.log(dept);

                        $('#department-selector-edit option').each(function () {
                            var optionValue = $(this).val();
                            if (optionValue.includes(shortDept) ) {
                                console.log('depert option: ' + optionValue);
                                $('#department-selector-edit').val(optionValue).trigger('change');
                                return false;
                            }
                        });
                        $('#ApprvLvl-edit-old').val(res.getApproval[0].ApprStep);
                        $('#ApprvLvl-edit').val(res.getApproval[0].ApprStep).trigger('change');
                        var emp = res.getApproval[0].EmpId;
                        console.log('Head: ' + emp);
                        $('#empid-edit').val(res.getApproval[0].EmpId).trigger('change');
                        if (res.getApproval[0].ActionType) {
                            $('#actiontyp-edit').val(res.getApproval[0].ActionType.trim()).trigger('change');
                        }
                        $('#apprvDesc-edit').val(res.getApproval[0].ApprDesc)
                    }
                }
            }

        });
    });
    function DropdownEmpSelectAdd() {
         $.ajax({
                 url: '@Url.Action("GetDirectorDepartment", "Employee")',
                 data: {
                     deptID: 'values'
                 },
                 type: 'POST',
                 dataType: 'JSON',
                 success: function (data) {
                     if (data.message == "Y") {
                         var select = $('#empId-add');
                         select.children().remove();
                         select.append($('<option>').val(0).text('เลือกผู้อนุมัติ'))
                         $(data.getDirector).each(function (index, item) {
                             select.append($('<option>').val(item.EmpId).text(item.DeptId + '/' + item.Fullname))
                         });
                     }
                     else {
                         alert(data.message);
                     }
                 }
             });
    }
    function DropdownEmpSelectEdit() {
         $.ajax({
             url: '@Url.Action("GetDirectorDepartment", "Employee")',
             data: {
                 deptID: '123'
             },
             type: 'POST',
             dataType: 'JSON',
             success: function (data) {
                 if (data.message == "Y") {
                     var select = $('#empid-edit');
                     select.children().remove();
                     select.append($('<option>').val(0).text('เลือก'))
                     $(data.getDirector).each(function (index, item) {
                         select.append($('<option>').val(item.EmpId).text(item.DeptId + '/' + item.Fullname))
                     });
                 }
                 else {
                     alert(data.message);
                 }
             }
         });
    }
    function GenerateApprvGrbID(department) {
        $.ajax({
            url: '@Url.Action("GenerateApprvFlowID", "Employee")',
            data: {
                Dept: department
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#groupId-edit').val('Generating...');
            },
            success: function (data) {
                if (data.message == 'Y') {
                    $('#groupId-add').val(data.apprvGrbID);
                    $('#apprvLvl-add').val('1');
                }
            }
        });
    }
    function GetApprovalID(department) {
    $.ajax({
        url: '@Url.Action("GetApprvID", "Employee")',
        data: {
            Dept: department
        },
        type: 'POST',
        dataType: 'JSON',
        success: function (data) {
            if (data.message === 'Y') {
                var datalist = $('#list-ApprvFlowID');
                datalist.empty();
                $(data.GrpvID).each(function (index, item) {
                    datalist.append($('<option>').val(item.ApprGrpId).text(item.ApprGrpName));
                });
            } else {
                console.log('Error GetID: ' + data.message);
            }
        },
        error: function (xhr, status, error) {
            console.log('AJAX error: ' + status + ' - ' + error);
        }
    });
}

    function GenerateApprvStep(Grp) {
        $.ajax({
            url: '@Url.Action("GenerateApprvFlowStep", "Employee")',
            data: {
                GrpID: Grp
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (data) {
                if (data.message == 'Y') {
                    $('#apprvLvl-add').val(data.stepGrb);
                }
            }
        });
    }
    function AddApprvFlow() {
        var apprvId = $('#groupId-add').val();
        var apprvNm = $('#groupName-add').val();
        var deptVal = $('#department-selector-add').val();
        var stepNum = $('#apprvLvl-add').val();
        var emp = $('#empId-add').val();
        var actionTex = $('#actiontyp-add').val();
        var apprvDesc = $('#apprvDesc-add').val();

        $.ajax({
            url: '@Url.Action("AddApprvFlow", "Employee")',
            data: {
                apprvID: apprvId,
                apprvName: apprvNm,
                dept: deptVal,
                step: stepNum,
                empId: emp,
                action: actionTex,
                desc: apprvDesc
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#addFormModal').modal('hide');
                LoadingShow();
            },
            success: function (data) {
                LoadingHide();
                if (data.message == "Y") {
                    Swal.fire({
                        title: "Success",
                        text: "เพิ่มการอนุมัติสำเร็จ",
                        icon: "success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                }
                else {
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    }).then(() => {
                        $('#addFormModal').modal('show');
                    });
                }
            }
        })
    }
    function UpdateApprvFlow() {
        var apprvID = $('#groupId-edit').val();
        var apprvNmold = $('#groupName-edit-old').val();
        var apprvNm = $('#groupName-edit').val();
        var deptVal = $('#department-selector-edit').val();
        var oldstepNum = $('#ApprvLvl-edit-old').val();
        var stepNum = $('#ApprvLvl-edit').val();
        var empId = $('#empid-edit').val();
        var actionTex = $('#actiontyp-edit').val();
        var apprvDesc = $('#apprvDesc-edit').val();
        if (apprvNm === null || apprvNm.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณากรอกชื่อกลุ่มอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (deptVal === null || deptVal.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกแผนก",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (stepNum === null || stepNum.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกลำดับการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (empId === null || empId.trim() === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณาเลือกผู้ทำการอนุมัติ",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }
        if (apprvDesc === "") {
            $('#editFormModal').modal('hide');
            Swal.fire({
                title: "Error!!!",
                text: "กรุณากรอกรายละเอียด",
                icon: "error"
            }).then(() => {
                $('#editFormModal').modal('show');
            });
            return false;
        }


        $.ajax({
            url: '@Url.Action("UpdateApprvFlow", "Employee")',
            data: {
                apprvID: apprvID ,
                oldApprvName: apprvNmold,
                apprvName: apprvNm,
                dept: deptVal,
                oldStep: oldstepNum,
                step: stepNum,
                empId: empId,
                action: actionTex,
                desc: apprvDesc
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                LoadingShow();
            },
            success: function (data) {
                LoadingHide();
                if (data.message === 'Y') {
                    Swal.fire({
                        title: "Success",
                        text: "Update Success",
                        icon: "success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            location.reload();
                        }
                    });
                    $('#editFormModal').modal('hide');
                }
                else {
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    });
                }
            }
        });
    }
</script>