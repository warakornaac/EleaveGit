
@{
    ViewBag.Title = "ตั้งค่า-กำหนดลำดับการอนุมัติ";
}

<style>
    .swal-custom-zindex {
        z-index: 1060 !important;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Approval flow setting | กำหนดลำดับการอนุมัติ</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ApprovflowSetting", "Employee")">Approval flow setting | กำหนดลำดับการอนุมัติ</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add-->
<div class="modal fade" id="addFormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Add approve flow | เพิ่มการอนุมัติ</h5>

                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">Close | ปิด</button>

            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label>Add approval | การเพิ่มอนุมัติ</label>
                            <select class="custom-select" id="select-addApprv">
                                <option value="1">Add approval group | เพิ่มกลุ่มอนุมัติ</option>
                                <option value="2">Add approval level | เพิ่มลำดับการอนุมัติ</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Approval group ID | รหัสกลุ่มอนุมัติ")
                            @Html.TextBox("GroupID", null, new { @class = "form-control", @id = "groupId-add", @readonly = "readonly", list = "list-ApprvFlowID" })
                            <datalist id="list-ApprvFlowID">
                                <option value="dataTest">Group</option>
                            </datalist>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Approve group name | ชื่อกลุ่มอนุมัติ")
                            @Html.TextBox("GroupName", null, new { @class = "form-control", @id = "groupName-add" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Department | แผนก")
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "Select department | เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-selector-add", onchange = "GenApprv(this.value),GetdirectorSelectAdd(this.value)" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Approval level | ลำดับการอนุมัติ")
                            @Html.TextBox("ApprvLvl", null, new { @class = "custom-select", @id = "apprvLvl-add", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Approve type | ประเภทอนุมัติ")
                            @Html.DropDownList("ActionType", new List<SelectListItem>
                                               {
                                                   new SelectListItem(){Text="Approve", Value="Approve"},
                                                   new SelectListItem(){Text="Acknowledge", Value="Acknowledge"}
                                               }, "Select approve type | เลือกประเภทอนุมัติ", new { @class = "custom-select", @id = "actiontyp-add", onchange = "ActionSelectAdd(this.value)" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Approver | พนักงานผู้อนุมัติ")
                            @Html.DropDownList("EMPID", new List<SelectListItem>
                       {

                       }, "เลือกพนักงาน", new { @class = "custom-select", @id = "empId-add" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            @Html.Label("Description | รายละเอียดประเภทอนุมัติ")
                            @Html.TextArea("ApprvDesc", null, new { @class = "form-control", @id = "apprvDesc-add" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
                <button type="button" class="btn btn-primary" id="addApprove-btn">Confirm | ยืนยัน</button>
            </div>
        </div>
    </div>
</div>


