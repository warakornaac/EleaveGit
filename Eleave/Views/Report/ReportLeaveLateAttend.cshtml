
@{
    ViewBag.Title = "Report";
    var currentMonth = DateTime.Now.Month;

}
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Report | รีพอร์ต</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ReportLeaveLate", "Report")">รายงาน</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            @using (Html.BeginForm("SearchReportLeaveBalance", "Report", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body">
                    <div class="row">
                        <div class="form-group col-md-3">
                            @Html.Label("บริษัท | Company", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Company", new List<SelectListItem>
                                    {
                                        new SelectListItem() {Text="AAC", Value="AAC"},
                                        new SelectListItem() {Text="TRU", Value="TRU"},
                                        new SelectListItem(){Text="OMP",Value="OMP"}
                                    }, "เลือกบริษัท | Select Company ", new { @class = "custom-select", @id = "Company-selector" })
                            @Html.Hidden("CompanyHidden", "", new { @id = "Company-hidden" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Label("แผนก | Department", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "เลือกหน่วยงาน | Select department ", new { @class = "custom-select", @id = "department-search" })
                            @Html.Hidden("DepartmentHidden", "", new { @id = "Department-hidden" })
                        </div>
                        <div class="form-group col-md-3">
                            @{
                                string[] month_eng = {"January",
                                    "February",
                                    "March",
                                    "April",
                                    "May",
                                    "June",
                                    "July",
                                    "August",
                                    "September",
                                    "October",
                                    "November",
                                    "December" };
                                var months = new List<SelectListItem>();
                                for (var i = 0; i < 12; i++)
                                {
                                    months.Add(new SelectListItem { Text = month_eng[i], Value = (i + 1).ToString() });
                                }
                            }
                            @Html.Label("เดือน | Month", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Month", months, "เลือกเดือน | Select Month", new { @class = "custom-select", @id = "month-selector" })
                        </div>
                    </div>
                </div>
                <div class="card-footer p-1">
                    <div class="form-group float-end m-2">
                        <input type="button" value="ล้าง | Clear" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="ค้นหา | Search" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="table-report-attend">
                        <thead>
                            <tr>
                                <th>บริษัท | Company</th>
                                <th>รหัสผนักงาน | Employee ID</th>
                                <th>ชื่อพนักงาน | Employee Name</th>
                                <th>แผนก | Department</th>
                                <th>วันที่ | Date</th>
                                <th>ลาพักร้อน | Annaul Leave</th>
                                <th>ลาชดเชย | Compensate Leave</th>
                                <th>ลากิจ | Business Leave</th>
                                <th>ลาป่วย | Sick Leave</th>
                                <th>ลาเพื่อจัดพิธีศพ | Bereavement Leave</th>
                                <th>ลาเพื่อทำหมัน | Contraceptive Leave</th>
                                <th>ลารับปริญญาบัตร | Graduation Leave</th>
                                <th>ลาคลอด | Maternity Leave</th>
                                <th>ลาไปรับราชการทหาร | Military Service Leave</th>
                                <th>ลาอุปสมบท หรือพิธีฮัจญ์ | Ordination leave</th>
                                <th>ลาเพื่อพัฒนาความรู้ ความสามารถ | Professional development leave</th>
                                <th>ลาอื่นๆ ไม่ได้รับค่าจ้าง | Leave Without Pay</th>
                                <th>ทำงานที่บ้าน | Work From Home</th>
                                <th>ทำงานนอกสถานที่ | Work Off-Site</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        console.log('Month NOW C# @currentMonth');
        $('#department-search').select2({
            width: '100%'
        });
    })
</script>