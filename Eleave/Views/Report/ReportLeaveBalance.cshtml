    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">รายละเอียด | Detail</h5>
                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">Close | ปิด</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <h5>ชื่อ-นามสกุล | Name : <span id="detail-fullname"></span></h5>
                    </div>
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover" id="detail-table">
                                <thead>
                                    <tr>
                                        <th class="text-center">ประเภทค้ร้อง | Request Type</th>
                                        <th class="text-center">ลาวันที่ | Request Date</th>
                                        <th class="text-center">จำนวนวัน | Total Days </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>*@
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // ดึงค่าจาก DropDownList และ TextBox
        var companyValue = $('#Company-selector').val();
        var departmentValue = $('#department-search').val();
        var yearValue = $('#year-dd').val();
        var empValue = $('#emp-tb').val();
        console.log("Company Value:", companyValue);
        console.log("Department Value:", departmentValue);
        console.log("Year Value:", yearValue);
        console.log("Employee Value:", empValue);
        // เซ็ตค่าลงใน Hidden Field
        $('#Company-hidden').val(companyValue);
        $('#Department-hidden').val(departmentValue);
        $('#Year-hidden').val(yearValue);
        $('#emp-hidden').val(empValue);

    });
    $(document).ready(function () {
        $("#btn-ex-table").click(function () {
            var today = new Date();
            var formattedDate = today.getFullYear() + '-' +
                String(today.getMonth() + 1).padStart(2, '0') + '-' +
                String(today.getDate()).padStart(2, '0');
            // ดึงข้อมูลจาก Table แรก
            let table1 = document.getElementById('report-leave-balance-tbl');
            let ws1 = XLSX.utils.table_to_sheet(table1);
            const companyValue = $('#Company-hidden').val();
            const depValue = $('#Department-hidden').val();
            const yearValue = $('#Year-hidden').val();
            const empValue = $('#emp-hidden').val();

            // ดึงข้อมูลจาก Stored Procedure
            $.ajax({
                url: '@Url.Action("DetailReportYearSheet", "Report")',
                type: "POST",
                dataType: "JSON",
                data: {
                    Yearly: yearValue,
                    Dept: depValue,
                    EmpID: empValue,
                    Comp: companyValue
                },
                success: function (response) {
                    if (response.message === 'Y') {
                        // Header
                        let data2 = [['Country', 'Company', 'REQ_NO', 'EmpId', 'Empname', 'Department', 'ReqStatus', 'LeaveType', 'StartDate', 'EndDate', 'NumDay', 'ApprGrpID', 'ApproveBy', 'ApproveDate', 'AcknowledgeBy', 'AcknowledgeDate']]; // Header

                        // เพิ่มข้อมูล
                        response.Detail.forEach(item => {
                            data2.push([
                                item.CountryCode,
                                item.Company,
                                item.ReqNo,
                                item.EmpId,
                                item.Empname,
                                item.DeptName,
                                item.ReqStaDesc,
                                item.LeaveType,
                                item.StartDate,
                                item.EndDate,
                                item.NumDayCal,
                                item.ApprGrpID,
                                item.ApproveBy,
                                item.ApproveDate,
                                item.AcknowledgeBy,
                                item.AcknowledgeDate
                            ]);
                        });

                        // สร้าง Sheet ที่สอง
                        let ws2 = XLSX.utils.aoa_to_sheet(data2);

                        // สร้าง Workbook
                        let wb = XLSX.utils.book_new();
                        XLSX.utils.book_append_sheet(wb, ws1, 'Report_Yearly');
                        XLSX.utils.book_append_sheet(wb, ws2, 'Detail');

                        // บันทึกไฟล์ Excel
                        XLSX.writeFile(wb, 'Report_Leave_Year_' + formattedDate + '.xlsx');
                    } else {
                        console.error('Error fetching data:', response.message);
                    }
                },
                error: function (err) {
                    console.error('Error in AJAX:', err);
                }
            });
        });
    });

