@model IEnumerable<Eleave.Models.ReportLeaveBalance>
@{
    ViewBag.Title = "รายงานการลา";
}
<style>
    /*    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
    }*/
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รายงานการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ReportLeaveBalance","Report")">รายงานการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            @using (Html.BeginForm("SearchReportLeaveBalance", "Report", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-md-4">
                            @Html.Label("บริษัท | Company", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Company", new List<SelectListItem>
                                    {
                                        new SelectListItem() {Text="AAC", Value="AAC"},
                                        new SelectListItem() {Text="TRU", Value="TRU"},
                                        new SelectListItem(){Text="OMP",Value="OMP"}
                                    }, "Select Company | เลือกบริษัท", new { @class = "custom-select", @id = "Company-selector" })
                        </div>
                        <div class="form-group col-md-4">
                            @{
                                var currentYear = DateTime.Now.Year;
                                var years = Enumerable.Range(currentYear - 3, 4).Reverse()
                                                      .Select(y => new SelectListItem
                                                      {
                                                          Value = y.ToString(),
                                                          Text = y.ToString()
                                                      }).ToList();
                            }
                            @Html.Label("ปี | Year", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Year", years, "Select Year | เลือกปี", new { @class = "form-control", @id = "year-dd" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.Label("แผนก | Department", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "Select department | เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-search" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.Label("รหัสผนักงาน | EmployeeID", new { @class = "font-weight-bold" })
                            @Html.TextBox("EmpID", null, new { @class = "form-control", @id = "emp-tb", @placeholder = "Enter EmpID | กรอกรหัสผนักงาน" })
                        </div>
                    </div>
                </div>
                <div class="card-footer p-1">
                    <div class="form-group float-end m-2">
                        <input type="button" value="Clear | ล้าง" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="Search | ค้นหา" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="report-leave-balance-tbl">
                        <thead>
                            <tr>
                                <th class="text-center">ลำดับ</th>
                                <th class="text-center">แผนก</th>
                                <th class="text-center">รหัสผนักงาน</th>
                                <th class="text-center">ชื่อพนักงาน</th>
                                <th class="text-center">ตำแหน่ง</th>
                                <th class="text-center">วันเริ่มงาน</th>
                                <th class="text-center">อายุงาน(ปี)</th>
                                <th class="text-center">อายุงาน(เดือน)</th>
                                <th class="text-center">อายุงาน(วัน)</th>

                                <th class="text-center">สิทธิ์ลาพักร้อน</th>
                                <th class="text-center">ใช้ลาพักร้อน</th>
                                <th class="text-center">ลาพักร้อนคงเหลือ</th>

                                <th class="text-center">สิทธิ์ลาป่วย</th>
                                <th class="text-center">ใช้ลาป่วย</th>
                                <th class="text-center">ลาป่วยคงเหลือ</th>

                                <th class="text-center">สิทธิ์ลากิจ(ได้รับเงิน)</th>
                                <th class="text-center">ใช้ลากิจ</th>
                                <th class="text-center">ลากิจคงเหลือ</th>

                                <th class="text-center">สิทธิ์หยุดชดเชย</th>
                                <th class="text-center">ใช้หยุดชดเชย</th>
                                <th class="text-center">หยุดชดเชยคงเหลือ</th>

                                <th class="text-center">ลาบวช</th>
                                <th class="text-center">ลาคลอด</th>
                                <th class="text-center">อื่นๆ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var report in Model)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center">@report.Company</td>
                                    <td class="text-center">@report.EmpId</td>
                                    <td class="text-center">@report.Fullname</td>
                                    <td class="text-center">@report.Position</td>
                                    <td class="text-center">@report.StartDate</td>
                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-center">@report.AL02_Accured</td>
                                    <td class="text-center">@report.AL02_Balance</td>
                                    <td class="text-center">@report.AL02_Leave</td>
                                    <td class="text-center">@report.SL01_Accured</td>
                                    <td class="text-center">@report.SL01_Balance</td>
                                    <td class="text-center">@report.SL01_Leave</td>
                                    <td class="text-center">@report.CP03_Accured</td>
                                    <td class="text-center">@report.CP03_Balance</td>
                                    <td class="text-center">@report.CP03_Leave</td>
                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-center">@report.OL07_Accured</td>
                                    <td class="text-center">@report.ML06_Accured</td>
                                    <td class="text-center">@report.Other_Accured</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#department-search').select2({
            width: '100%'
        });
        $('#report-leave-balance-tbl').dataTable({
            dom: '<t><"d-flex align-items-center"ip>',
            paging: true,
            pageLength: 100,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คน",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
        //$('#report-leave-balance-tbl').DataTable({
        //    paging: true,
        //    pageLength: 100,
        //    lengthChange: false,
        //    searching: false,
        //    ordering: false,
        //    select: false,
        //    language: {
        //        info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คน",
        //        infoEmpty: "ไม่มีข้อมูลให้แสดง"
        //    },
        //    dom: 'Bfrtip', // เพิ่ม 'B' เพื่อแสดงปุ่ม
        //    buttons: [
        //        {
        //            extend: 'excelHtml5',
        //            text: 'Export to Excel', // ข้อความปุ่ม
        //            className: 'btn btn-success', // เพิ่มคลาสเพื่อปรับแต่งปุ่ม
        //            title: 'รายงานข้อมูล', // ชื่อไฟล์ Excel
        //            exportOptions: {
        //                columns: ':visible' // Export เฉพาะคอลัมน์ที่มองเห็น
        //            }
        //        }
        //    ]
        //});

    });
    $(document).on('click', '#reset-btn', function () {
        $('#Company-selector').val('').trigger('change');
        $('#year-dd').val('').trigger('change');
        $('#department-search').val('').trigger('change');
        $('#emp-tb').val('');
    });
</script>