@model IEnumerable<Eleave.Models.ReportLeaveBalance>
@{
    ViewBag.Title = "รายงานการลา";
}
<style>
    /*    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
    }*/
    .note {
        position: relative;
    }

        .note:after { /* Magic Happens Here!!! */
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            display: block;
            border-left: 20px solid transparent;
            border-bottom: 20px solid transparent;
            border-top: 20px solid #f00;
        }
    /* </magic> */
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รายงานการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ReportLeaveBalance","Report")">รายงานการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            @using (Html.BeginForm("SearchReportLeaveBalance", "Report", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-md-6">
                            @Html.Label("บริษัท | Company", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Company", new List<SelectListItem>
                                    {
                                        new SelectListItem() {Text="AAC", Value="AAC"},
                                        new SelectListItem() {Text="TRU", Value="TRU"},
                                        new SelectListItem(){Text="OMP",Value="OMP"}
                                    }, "Select Company | เลือกบริษัท", new { @class = "custom-select", @id = "Company-selector" })
                        </div>
                        <div class="form-group col-md-6">
                            @{
                                var currentYear = DateTime.Now.Year;
                                var years = Enumerable.Range(currentYear - 3, 4).Reverse()
                                                      .Select(y => new SelectListItem
                                                      {
                                                          Value = y.ToString(),
                                                          Text = y.ToString()
                                                      }).ToList();
                            }
                            @Html.Label("ปี | Year", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Year", years, new { @class = "form-control", @id = "year-dd" })
                        </div>
                        <div class="form-group col-md-6">
                            @Html.Label("แผนก | Department", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "Select department | เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-search" })
                        </div>
                        <div class="form-group col-md-6">
                            @Html.Label("รหัสผนักงาน | EmployeeID", new { @class = "font-weight-bold" })
                            @Html.TextBox("EmpID", null, new { @class = "form-control", @id = "emp-tb", @placeholder = "Enter EmpID | กรอกรหัสผนักงาน" })
                        </div>
                    </div>
                </div>
                <div class="card-footer p-1">
                    <div class="form-group float-end m-2">
                        <input type="button" value="Clear | ล้าง" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="Search | ค้นหา" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="report-leave-balance-tbl">
                        <thead>
                            <tr>
                                <th class="text-center">No. | ลำดับ</th>
                                <th class="text-center">Department | แผนก</th>
                                <th class="text-center">Employee ID | รหัสพนักงาน</th>
                                <th class="text-center">Employee Name | ชื่อพนักงาน</th>
                                <th class="text-center">Position | ตำแหน่ง</th>
                                <th class="text-center">Start Date | วันเริ่มงาน</th>
                                <th class="text-center">Years of Service | อายุงาน (ปี)</th>
                                <th class="text-center">Months of Service | อายุงาน (เดือน)</th>
                                <th class="text-center">Days of Service | อายุงาน (วัน)</th>

                                <th class="text-center">Vacation Entitlement | สิทธิ์ลาพักร้อน</th>
                                <th class="text-center">Vacation Taken | ใช้ลาพักร้อน</th>
                                <th class="text-center">Vacation Remaining | ลาพักร้อนคงเหลือ</th>

                                <th class="text-center">SickLeave Entitlement | สิทธิ์ลาป่วย</th>
                                <th class="text-center">SickLeave Taken | ใช้ลาป่วย</th>
                                <th class="text-center">SickLeave Remaining | ลาป่วยคงเหลือ</th>

                                <th class="text-center">PersonalLeave Entitlement (Paid) | สิทธิ์ลากิจ (ได้รับเงิน)</th>
                                <th class="text-center">PersonalLeave Taken | ใช้ลากิจ</th>
                                <th class="text-center">PersonalLeave Remaining | ลากิจคงเหลือ</th>

                                <th class="text-center">CompensationLeave Entitlement | สิทธิ์หยุดชดเชย</th>
                                <th class="text-center">CompensationLeave Taken | ใช้หยุดชดเชย</th>
                                <th class="text-center">CompensationLeave Remaining | หยุดชดเชยคงเหลือ</th>

                                <th class="text-center">OrdinationLeave | ลาบวช</th>
                                <th class="text-center">MaternityLeave | ลาคลอด</th>
                                <th class="text-center">Other | อื่นๆ</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var report in Model)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center">@report.Company</td>
                                    <td class="text-center">@report.EmpId</td>
                                    <td class="text-center">@report.Fullname</td>
                                    <td class="text-center">@report.Position</td>
                                    <td class="text-center">@report.StartDate</td>
                                    <td class="text-center">@report.Years</td>
                                    <td class="text-center">@report.Months</td>
                                    <td class="text-center">@report.Days</td>
                                    <td class="text-center">@report.AL02_Accured</td>
                                    <td class="text-center @report.AL02_Leave > 0 ?? " ":" note""><a href="#" id="al02-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="al02"> @report.AL02_Leave</a></td>
                                    <td class="text-center">@report.AL02_Balance</td>
                                    <td class="text-center">@report.SL01_Accured</td>
                                    <td class="text-center note"><a href="#" id="sl01-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="sl01"> @report.SL01_Leave</a></td>
                                    <td class="text-center">@report.SL01_Balance</td>
                                    <td class="text-center">@report.BU04_Accured</td>
                                    <td class="text-center note"><a href="#" id="bu04-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="bu04"> @report.BU04_Leave</a> </td>
                                    <td class="text-center">@report.BU04_Balance</td>
                                    <td class="text-center">@report.CP03_Accured</td>
                                    <td class="text-center note"><a href="#" id="cp03-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="cp03"> @report.CP03_Leave</a></td>
                                    <td class="text-center">@report.CP03_Balance</td>
                                    <td class="text-center">@report.OL07_Accured</td>
                                    <td class="text-center">@report.ML06_Accured</td>
                                    <td class="text-center">@report.Other_Accured</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detailLeaveModal" tabindex="-1" role="dialog" aria-labelledby="detailLeaveModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">รายละเอียด | Detail</h5>
                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">Close | ปิด</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <h5>ชื่อ-นามสกุล | Name : <span id="detail-fullname"></span></h5>
                    </div>
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-hover" id="detail-table">
                                <thead>
                                    <tr>
                                        <th class="text-center">ประเภทการลา | Leave Type</th>
                                        <th class="text-center">ลาวันที่ | Leave Date</th>
                                        <th class="text-center">จำนวนวัน | Total Days </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>*@
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#department-search').select2({
            width: '100%'
        });
        //$('#report-leave-balance-tbl').dataTable({
        //    dom: '<t><"d-flex align-items-center"ip>',
        //    paging: true,
        //    pageLength: 100,
        //    lengthChange: false,
        //    searching: false,
        //    ordering: false,
        //    select: false,
        //    language: {
        //        info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คน",
        //        infoEmpty: "ไม่มีข้อมูลให้แสดง"
        //    }
        //});
        $('#report-leave-balance-tbl').DataTable({
            paging: true,
            pageLength: 100,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คน",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            },
            dom: '<"d-flex justify-content-between mb-3"B>t<"d-flex align-items-center"i<"ml-3"p>>', // ปรับตำแหน่ง DOM
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Export to Excel', // ข้อความปุ่ม
                    className: 'btn btn-success', // เพิ่มคลาสเพื่อปรับแต่งปุ่ม
                    title: 'รายงานข้อมูล'//, // ชื่อไฟล์ Excel
                    //exportOptions: {
                    //    columns: ':visible' // Export เฉพาะคอลัมน์ที่มองเห็น
                    //}
                }
            ]
        });

    });
    $(document).on('click', '#reset-btn', function () {
        $('#Company-selector').val('').trigger('change');
        $('#year-dd').val('').trigger('change');
        $('#department-search').val('').trigger('change');
        $('#emp-tb').val('');
    });
    $(document).on('click', '[id*="-bal-detail-"]', function () {
        var emp = $(this).data('emp');
        var type = $(this).data('levtyp');
        var yearly = $('#year-dd').val();
        getDetailReport(emp, type, yearly);
    });
    function getDetailReport(empID,type,year) {
        $.ajax({
            url: '@Url.Action("DetailReport", "Report")',
            data: {
                EMP: empID,
                LEVTYP: type,
                YEAR: year
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                LoadingShow();
                $('#detail-table tbody').html('');
                $('#detail-fullname').text('');
            },
            success: function (data) {
                $('#detail-table tbody').html('');
                if (data.message == 'Y') {
                    $('#detailLeaveModal').modal('show');
                    var SubmithtmlPage = '';
                    if (data.Detail.length > 0) {
                        for (var i = 0; i < data.Detail.length; i++) {
                            SubmithtmlPage += '<tr>';
                            SubmithtmlPage += '<td>' + data.Detail[i].Description + '</td>';
                            SubmithtmlPage += '<td>' + data.Detail[i].TimeLev + '</td>';
                            SubmithtmlPage += '<td>' + data.Detail[i].NumDay + '</td>';
                            SubmithtmlPage += '</tr>';
                        }
                        $('#detail-fullname').text(data.Detail[0].Fullname);
                    }
                    else {
                        SubmithtmlPage += '<tr>';
                        SubmithtmlPage += '<td class="text-center" colspan="3">ไม่พบข้อมูล | No Data</td>';
                        SubmithtmlPage += '</tr>';
                    }

                    $('#detail-table tbody').append(SubmithtmlPage);
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        html: '<p>GetDetailReport :</p><p>' + data.message + '</p>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด | Close',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            }, complete: function (res) {
                LoadingHide();
            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetDetailReport :</p><p>' + error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด | Close',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }

        });
    }
</script>