@model IEnumerable<Eleave.Models.ReportLeaveBalance>
@{
    ViewBag.Title = "รายงานการลารายเดือน";
}
<style>
    th, td {
        white-space: nowrap;
    }

    div.dataTables_wrapper {
        width: 800px;
        margin: 0 auto;
    }

    .note {
        position: relative;
    }

        .note:after { /* Magic Happens Here!!! */
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            display: block;
            border-left: 20px solid transparent;
            border-bottom: 20px solid transparent;
            border-top: 20px solid #f00;
        }
    /* </magic> */
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รายงานการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ReportLeaveBalanceMonth","Report")">รายงานการลารายเดือน</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            @using (Html.BeginForm("ReportLeaveBalanceMonthSearch", "Report", FormMethod.Post, new { @id = "formsearch" }))
            {
                <div class="card-body p-3 m-0">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-md-3">
                            @Html.Label("บริษัท | Company", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Company", new List<SelectListItem>
                                    {
                                        new SelectListItem() {Text="AAC", Value="AAC"},
                                        new SelectListItem() {Text="TRU", Value="TRU"},
                                        new SelectListItem(){Text="OMP",Value="OMP"}
                                    }, "Select Company | เลือกบริษัท", new { @class = "custom-select", @id = "Company-selector" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Label("แผนก | Department", new { @class = "font-weight-bold" })
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "Select department | เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-search" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Label("เริ่มต้น | Begin", new { @class = "font-weight-bold" })
                            @Html.TextBox("StartDate", null, new { @class = "form-control", @id = "start-date", @placeholder = "--/--/--" })
                            @Html.Hidden("StartDateHidden", "", new { @id = "start-date-hidden" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.Label("จนถึง | End", new { @class = "font-weight-bold" })
                            @Html.TextBox("EndDate", null, new { @class = "form-control", @id = "end-date", @placeholder = "--/--/--" })
                            @Html.Hidden("EndDateHidden", "", new { @id = "end-date-hidden" })
                        </div>
                    </div>
                </div>
                <div class="card-footer p-1">
                    <div class="form-group float-end m-2">
                        <input type="button" value="ล้าง | Clear" class="btn btn-secondary" id="reset-btn" />
                        <input type="submit" value="ค้นหา | Search" class="btn btn-primary" />
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped" id="report-leave-balance-month-tbl">
                        <thead>
                            <tr>
                                <th class="text-center" rowspan="2" align="center">No. | ลำดับ</th>
                                <th class="text-center" rowspan="2" align="center">Company | บริษัท</th>
                                <th class="text-center" rowspan="2" align="center">Employee ID | รหัสพนักงาน</th>
                                <th class="text-center" rowspan="2" align="center">Employee Name | ชื่อพนักงาน</th>
                                <th class="text-center" rowspan="2" align="center">Department | แผนก</th>
                                <th class="text-center" rowspan="2" align="center">Position | ตำแหน่ง</th>
                                <th class="text-center" rowspan="2" align="center">Start Date | วันเริ่มงาน</th>
                                <th class="text-center" rowspan="2" align="center">Years of Service | อายุงาน (ปี)</th>
                                <th class="text-center" rowspan="2" align="center">Months of Service | อายุงาน (เดือน)</th>
                                <th class="text-center" rowspan="2" align="center">Days of Service | อายุงาน (วัน)</th>

                                <th class="text-center" colspan="3">Annual Leave | สิทธิ์ลาพักร้อน</th>

                                <th class="text-center" colspan="3">Annual Leave | สิทธิ์ลาพักร้อนยกยอด</th>

                                <th class="text-center" colspan="3">Compensation Leave | สิทธิ์หยุดชดเชย</th>

                                <th class="text-center" colspan="3">Sick Leave | สิทธิ์ลาป่วย</th>

                                <th class="text-center" colspan="3">Personal Leave (Paid) | สิทธิ์ลากิจ (ได้รับเงิน)</th>

                                <th class="text-center" colspan="3">Personal Leave (Not Paid) | สิทธิ์ลากิจ (ไม่ได้รับเงิน)</th>

                                <th class="text-center" colspan="3" align="center">Ordination Leave | ลาบวช</th>

                                <th class="text-center" colspan="3" align="center">Maternity Leave | ลาคลอด</th>

                                <th class="text-center" colspan="3" align="center">Contraceptive Operation Leave | ลาทำหมัน</th>

                                <th class="text-center" colspan="3" align="center">Bereavement Leave | ลาพิธีศพ</th>

                                <th class="text-center" colspan="3" align="center">Graduation Leave | ลารับปริญญา</th>

                                <th class="text-center" colspan="3" align="center">Military Service Leave | ลาเกณฑ์ทหาร</th>


                                <th class="text-center" colspan="2" align="center">Work From Home | ทำงานที่บ้าน</th>
                                <th class="text-center" colspan="2" align="center">Work off site | ทำงานนอกสถานที่</th>

                            </tr>
                            <tr>
                                @*ลาพักร้อน*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาพักร้อนยกยอด*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาหยุดชดเชย*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาป่วย*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลากิจ*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลากิจไม่ได้เงิน*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาบวช*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาคลอด*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาทำหมัน*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลางานศพ*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลารับปริญญา*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*ลาเกณฑ์ทหาร*@
                                <th>Total</th>
                                <th>Taken</th>
                                <th>Remaining</th>

                                @*WFH*@
                                <th>Taken</th>
                                <th>Waiting</th>

                                @*OffSite*@
                                <th>Taken</th>
                                <th>Waiting</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var report in Model)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center">@report.Company</td>
                                    <td class="text-center">@report.EmpId</td>
                                    <td class="text-center">@report.Fullname</td>
                                    <td class="text-center">@report.DeptName</td>
                                    <td class="text-center">@report.Position</td>
                                    <td class="text-center">@report.StartDate</td>
                                    <td class="text-center">@report.Years</td>
                                    <td class="text-center">@report.Months</td>
                                    <td class="text-center">@report.Days</td>
                                    @*ลาพักร้อน*@
                                    <td class="text-center">@report.AL02_Accured.ToString("0.#")</td>
                                    <td class="text-center @(report.AL02_Leave > 0 ? "note" : "")" id="al02-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="al02"><a href="#"> @report.AL02_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.AL02_Balance.ToString("0.#")</td>
                                    @*ลาพักร้อนยกยอด*@
                                    <td class="text-center">@report.AL01_Accured.ToString("0.#")</td>
                                    <td class="text-center @(report.AL01_Leave > 0 ? "note" : "")" id="al01-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="al01"><a href="#"> @report.AL01_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.AL01_Balance.ToString("0.#")</td>
                                    @*ลาชดเชย*@
                                    <td class="text-center">@report.CP03_Accured.ToString("0.#")</td>
                                    <td class="text-center @(report.CP03_Leave > 0 ? "note" : "")" id="cp03-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="cp03"><a href="#"> @report.CP03_Leave.ToString("0.#")</a> </td>
                                    <td class="text-center">@report.CP03_Balance.ToString("0.#")</td>
                                    @*ลาป่วย*@
                                    <td class="text-center">@report.SL01_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.SL01_Leave > 0 ? "note" : "")" id="sl01-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="sl01"><a href="#"> @report.SL01_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.SL01_Balance.ToString("0.#")</td>
                                    @*ลากิจ(ได้รับเงิน)*@
                                    <td class="text-center">@report.BU04_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.BU04_Leave > 0 ? "note" : "")" id="bu04-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="bu04"><a href="#"> @report.BU04_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.BU04_Balance.ToString("0.#")</td>
                                    @*ลากิจ(ไม่ได้รับเงิน)*@
                                    <td class="text-center">@report.OT13_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.OT13_Leave > 0 ? "note" : "")" id="ot13-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="ot13"><a href="#"> @report.OT13_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.OT13_Balance.ToString("0.#")</td>
                                    @*ลาบวช*@
                                    <td class="text-center">@report.OL07_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.OL07_Leave > 0 ? "note" : "")" id="ol07-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="ol07"><a href="#"> @report.OL07_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.OL07_Balance.ToString("0.#")</td>
                                    @*ลาคลอด*@
                                    <td class="text-center">@report.ML06_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.ML06_Leave > 0 ? "note" : "")" id="ml06-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="ml06"><a href="#"> @report.ML06_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.ML06_Balance.ToString("0.#")</td>
                                    @*ลาทำหมัน*@
                                    <td class="text-center">@report.CO11_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.CO11_Leave > 0 ? "note" : "")" id="co11-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="co11"><a href="#"> @report.CO11_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.CO11_Balance.ToString("0.#")</td>
                                    @*ลาพิธีศพ*@
                                    <td class="text-center">@report.BL10_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.BL10_Leave > 0 ? "note" : "")" id="bl10-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="bl10"><a href="#"> @report.BL10_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.BL10_Balance.ToString("0.#")</td>
                                    @*ลารับปริญญา*@
                                    <td class="text-center">@report.GL09_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.GL09_Leave > 0 ? "note" : "")" id="gl09-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="gl09"><a href="#"> @report.GL09_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.GL09_Balance.ToString("0.#")</td>
                                    @*ลาเกณฑ์ทหาร*@
                                    <td class="text-center">@report.MS08_Accured.ToString("0.#")</td>
                                    <td class="text-center  @(report.MS08_Leave > 0 ? "note" : "")" id="ms08-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="ms08"><a href="#"> @report.MS08_Leave.ToString("0.#")</a></td>
                                    <td class="text-center">@report.MS08_Balance.ToString("0.#")</td>
                                    @*WFH*@
                                    <td class="text-center  @(report.WFH_Approve > 0 ? "note" : "")" id="wfh-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="wfh"><a href="#"> @report.WFH_Approve.ToString("0.#")</a></td>
                                    <td class="text-center">@report.WFH_Waiting.ToString("0.#")</td>
                                    @*Onsite*@
                                    <td class="text-center  @(report.OffSite_Approve > 0 ? "note" : "")" id="offsite-bal-detail-@report.EmpId" data-emp="@report.EmpId" data-levtyp="offsite"><a href="#"> @report.OffSite_Approve.ToString("0.#")</a></td>
                                    <td class="text-center">@report.OffSite_Waiting.ToString("0.#")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detailLeaveModal" tabindex="-1" role="dialog" aria-labelledby="detailLeaveModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">รายละเอียด | Detail</h5>
                <button type="button" class="btn btn-danger" data-dismiss="modal" aria-label="Close">Close | ปิด</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <h5>ชื่อ-นามสกุล | Name : <span id="detail-fullname"></span></h5>
                    </div>
                    <div class="col-12">
                        <div class="table-responsive-sm table-responsive">
                            <table class="table table-hover" id="detail-table">
                                <thead>
                                    <tr>
                                        <th class="text-center">ประเภทค้ร้อง | Request Type</th>
                                        <th class="text-center">ลาวันที่ | Request Date</th>
                                        <th class="text-center">จำนวนวัน | Total Days </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#department-search').select2({
            width: '100%'
        });
        var isMdOrLarger = window.matchMedia("(min-width: 1600px)").matches;
        $('#report-leave-balance-month-tbl').DataTable({
            paging: true,
            fixedColumns: isMdOrLarger
                ? { start: 5, end: 0 } // ใช้งาน fixedColumns ถ้าหน้าจอเป็น md ขึ้นไป
                : false,
            columnDefs: [
                {
                    targets: '_all',
                    className: "dt-head-center"
                }
            ],
            pageLength: 100,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คน",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            },
            screenX: true,
            scrollY: 500,
            dom: '<"d-flex justify-content-between mb-3"B>t<"d-flex align-items-center"i<"ml-3"p>>', // ปรับตำแหน่ง DOM
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Export to Excel', // ข้อความปุ่ม
                    className: 'btn btn-success', // เพิ่มคลาสเพื่อปรับแต่งปุ่ม
                    title: 'รายงานข้อมูลรวมเดือน'//, // ชื่อไฟล์ Excel
                    //exportOptions: {
                    //    columns: ':visible' // Export เฉพาะคอลัมน์ที่มองเห็น
                    //}
                }
            ]
        });
    });

    $('#start-date').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#end-date').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#start-date').inputmask('99/99/9999');
    $('#end-date').inputmask('99/99/9999');
    $(document).ready(function () {

        var startDate = $('#start-date').val();
        var endDate = $('#end-date').val();
        $('#start-date-hidden').val(startDate);
        $('#end-date-hidden').val(endDate);

    });
    $(document).on('click', '#reset-btn', function () {
        $('#Company-selector').val('').trigger('change');
        $('#department-search').val('').trigger('change');
        $('#start-date').val('');
        $('#end-date').val('');
    });
    $(document).on('click', '[id*="-detail-"]', function () {
        var emp = $(this).data('emp');
        var type = $(this).data('levtyp');
        var startdate = $('#start-date-hidden').val();
        var enddate = $('#end-date-hidden').val();

        //console.log('EmpID : ' + emp);
        //console.log('Type :' + type);
        //console.log('Start Date: ' + startdate);
        //console.log('End Date: ' + enddate);
        getDetailReport(emp, type, startdate, enddate);

    });



    function getDetailReport(empID,type,start,end) {
        $.ajax({
            url: '@Url.Action("ReportDetailMonth", "Report")',
            data: {
                EmpID: empID,
                LeavTyp: type,
                StartDate: start,
                EndDate: end
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                LoadingShow();
                $('#detail-table tbody').html('');
                $('#detail-fullname').text('');
            },
            success: function (data) {
                $('#detail-table tbody').html('');
                if (data.message == 'Y') {
                    $('#detailLeaveModal').modal('show');
                    var SubmithtmlPage = '';
                    if (data.Detail.length > 0) {
                        for (var i = 0; i < data.Detail.length; i++) {
                            SubmithtmlPage += '<tr>';
                            SubmithtmlPage += '<td>' + data.Detail[i].Description + '</td>';
                            SubmithtmlPage += '<td>' + data.Detail[i].TimeLev + '</td>';
                            SubmithtmlPage += '<td>' + data.Detail[i].CalculatedHour + '</td>';
                            SubmithtmlPage += '</tr>';
                        }
                        $('#detail-fullname').text(data.Detail[0].Fullname);
                    }
                    else {
                        SubmithtmlPage += '<tr>';
                        SubmithtmlPage += '<td class="text-center" colspan="3">ไม่พบข้อมูล | No Data</td>';
                        SubmithtmlPage += '</tr>';
                    }

                    $('#detail-table tbody').append(SubmithtmlPage);
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        html: '<p>GetDetailReport :</p><p>' + data.message + '</p>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด | Close',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            }, complete: function (res) {
                LoadingHide();
            },
            error: function (xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetDetailReport :</p><p>' + error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด | Close',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }

        });
    }
</script>
