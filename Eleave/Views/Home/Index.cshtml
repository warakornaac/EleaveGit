@model IEnumerable<Eleave.Models.RequestList>
@{
    ViewBag.Title = "หน้าแรก";
}
@{
    var iconMapping = new Dictionary<int, string>
{
         { 1, "fa fa-medkit" },
         { 2, "fa fa-map-marker" },
         { 3, "icon feather icon-rotate-ccw" },
         { 4, "icon feather icon-rotate-ccw" },
     };

    string defaultIcon = "icon feather icon-file-text"; // Default icon
}
<style>
    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .star {
        height: 50px;
        width: 47px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eee;
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
        font-size: 12px;
        text-align: center;
        padding: 0 15px;
        margin-left: -10px;
    }

    .content-text-1 {
        height: 55px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
        font-size: 12px;
        width: 55px;
        word-wrap: break-word;
        text-align: center;
        white-space: pre-line;
    }

    .vcenter {
        vertical-align: middle;
        text-align: -webkit-center;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Leave Info | ข้อมูลการลา</h5>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->
<!-- [ Main Content ] start -->
<div class="row align-items-stretch">
    <div class="col-md-8 col-lg-4 d-flex flex-column p-0">
        <div class="col-md-12 col-lg-8  col-xl-12 p-0">
            <div class="card bg-transparent border-0 shadow-none">
                <div class="card-body pt-0">
                    @if (ViewBag.BalanceLeave != null)
                    {
                        foreach (var bal in ViewBag.BalanceLeave)
                        {
                            <div class="col-md-12 col-xl-12 col-sm-4">
                                <div class="card border-top-0 rounded-3 ">
                                    <div class="card-body row">
                                        <div class="col-2 d-flex align-items-center">

                                            <span class="star font-bold"> @Eleave.Library.Utils.CalculateDayHour((double)bal.AccuredLeave) </span>

                                        </div>
                                        <div class="col-8 pl-0 pr-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="">
                                                    <b>@(bal.LeaveType)</b>
                                                    <div class="d-flex flex-row align-items-center time-text">
                                                        <small>ใช้สิทธิแล้ว (@Eleave.Library.Utils.CalculateDayHour((double)bal.LeaveTaken))</small>
                                                        <span class="dots"></span>
                                                        <small>รออนุมัติ (@Eleave.Library.Utils.CalculateDayHour((double)bal.WaitApprove))</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-2 p-0 d-flex align-items-center justify-content-center">
                                            <h5 class="content-text-1 m-0"> @Eleave.Library.Utils.CalculateDayHour((double)bal.ClosingBal)</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    else
                    {
                        <div class="col-md-12 col-xl-12 col-sm-4">
                            <div class="card border-top-0 rounded-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="text-center"><h5>ไม่พบข้อมูลวันลา</h5></div>
                                        <p class="text-white badge badge-pill badge-primary p-3"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>


            @*<div class="col-md-12 col-xl-12 col-sm-4">
                    <div class="card border-top-0 rounded-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="">TEST</div>
                                <p class="text-white badge badge-pill badge-primary p-3">12</p>
                            </div>
                        </div>
                    </div>
                </div>*@

        </div>
    </div>
    <div class="col-xl-8 col-md-8 d-flex flex-column">
        <div class="card table-card flex-grow-1 p-2">
            <div class="card-header p-3">
                <h5 class="">Request Lists | รายการร้องขอทั้งหมด</h5>
                <div class="card-header-right">
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="height:100%">
                    <table class="table tableList table-bordered table-striped m-0" id="leave-his-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">จัดการ | ACT</th>
                                <th class="text-center">สถานะคำขอ | REQ STATUS</th>
                                <th class="text-center">ประเภทการลา | REQ CATE</th>
                                <th class="text-center">วันที่ลา | Leave DATE</th>
                                <th class="text-center">รวมขอลา | TOT DATE</th>
                                <th class="text-center">หมายเหตุการลา | REMARK</th>
                                <th class="text-center">ผู้อนุมัติ | APPR BY</th>
                                <th class="text-center">วันที่อนุมัติ | APPR DATE</th>
                                <th class="text-center">HR ผู้รับอนุมัติ | ACK BY</th>
                                <th class="text-center">วันที่ HR รับอนุมัติ | ACK DATE</th>
                                <th class="text-center">รหัสคำขอ | REQ NO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var leave in Model)
                            {
                                i++;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center vcenter">
                                        <div class="btn btn-info btn-xs p-1" id="btnview_@leave.ReqNo" data-reqno="@leave.ReqNo" data-empid="@leave.EmpId"><span class="fa fa-eye p-1"></span></div>
                                    </td>
                                    @if (leave.ReqStatus == "0")
                                    {
                                        <td class="text-left">
                                            <div class="text-warning "><span class="badge bg-warning rounded-pill"><i class="fa fa-repeat" aria-hidden="true"></i></span><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "1")
                                    {
                                        <td class="text-left">
                                            <div class="text-success"><span class="badge bg-success rounded-pill"><i class="fa fa-check" aria-hidden="true"></i></span><span> @leave.ReqStaDesc</span></div>
                                        </td>

                                    }
                                    else if (leave.ReqStatus == "2")
                                    {
                                        <td class="text-left">
                                            <div class="text-danger"><span class="badge bg-danger rounded-pill"><i class="fa fa-times" aria-hidden="true"></i></span> <span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "3")
                                    {
                                        <td class="text-left">
                                            <div class="text-primary"><span class="badge bg-primary rounded-pill"><i class="fa fa-check" aria-hidden="true"></i></span><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "4")
                                    {
                                        <td class="text-left">
                                            <div class="text-danger"><span class="badge bg-danger rounded-pill"><i class="fa fa-ban" aria-hidden="true"></i></span><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    <td class="text-center">@leave.LeaveType</td>
                                    <td class="text-center">@(leave.StartDate)-@(leave.EndDate)</td>
                                    <td class="text-center">@Eleave.Library.Utils.CalculateDayHour((double)leave.NumDay)</td>
                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@leave.Remark</p>
                                    </td>


                                    @*apprvby*@

                                    @if (leave.ApproveBy.Contains(","))
                                    {
                                        <td class="text-left">
                                            @{
                                                string[] apprv = leave.ApproveBy.Split(',');
                                                string apver = string.Empty;
                                                string iconsta = string.Empty;
                                                string iconbg = string.Empty;
                                                foreach (var item in apprv)
                                                {
                                                    if (item.Contains(" | "))
                                                    {
                                                        string[] StatusNAme = item.Split('|');
                                                        switch (StatusNAme[0].Trim())
                                                        {
                                                            case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                            case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                            case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                        }
                                                        if (StatusNAme[0].Trim() == "4")
                                                        {
                                                            <span class="badge rounded-pill @iconbg">
                                                                <i class="@iconsta" aria-hidden="true"></i>
                                                            </span>
                                                            <del>@StatusNAme[1]</del> <br />

                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill @iconbg">
                                                                <i class="@iconsta" aria-hidden="true"></i>
                                                            </span>
                                                            <span>@StatusNAme[1]</span><br />
                                                        }

                                                    }
                                                }
                                            }
                                        </td>

                                    }
                                    else
                                    {
                                        //<td class="text-center">@leave.ApproveBy</td>
                                        <td class="text-left">
                                            @{
                                                string[] apprv = leave.ApproveBy.Split(',');

                                                string apver = string.Empty;
                                                string iconsta = string.Empty;
                                                string iconbg = string.Empty;
                                                foreach (var item in apprv)
                                                {
                                                    if (item.Contains(" | "))
                                                    {

                                                        string[] StatusNAme = item.Split('|');
                                                        switch (StatusNAme[0].Trim())
                                                        {
                                                            case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                            case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                            case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                        }

                                                        <span class="badge rounded-pill @iconbg">
                                                            <i class="@iconsta" aria-hidden="true"></i>
                                                        </span>
                                                        <span>@StatusNAme[1]</span><br />
                                                    }
                                                }
                                            }
                                        </td>
                                    }
                                    @*apprvby*@
                                    <td class="text-center">@(leave.ApproveDate)</td>
                                    <td class="text-center">@leave.AcknowledgeBy</td>
                                    <td class="text-center">@(leave.AcknowledgeDate)</td>
                                    <td class="text-center">@leave.ReqNo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal -->
<div class="modal fade" id="RequestDetailModal" tabindex="-1" aria-labelledby="ModalCancel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-2">
                <div class="col-sm-10 col-md-10">
                    <h4 class="modal-title" id="myModalLabel">รายละเอียด</h4>
                </div>
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close | ปิด</button></div>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" id="cancel_submit"><i class="fa fa-trash"></i> ยกเลิกรายการ </button>
                @*<button type="button" class="btn btn-danger" data-dismiss="modal"> <i class="fa fa-times"></i> ปิด</button>*@
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var isMdOrLarger = window.matchMedia("(min-width: 1600px)").matches;
        $('#leave-his-table').dataTable({
            dom: '<t><"d-flex align-items-center"ip>',
            fixedColumns: isMdOrLarger
                ? { start: 6, end: 0 } // ใช้งาน fixedColumns ถ้าหน้าจอเป็น md ขึ้นไป
                : false,              // ไม่ใช้งาน fixedColumns ถ้าหน้าจอเล็กกว่า md
            paging: true,
            pageLength: 10,
            pageResize: false,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            scrollY: 500,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ การร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });

    $(document).on('click', '[id^="btnview_"]', function (e) {
        e.preventDefault();
        var reqNo = $(this).data('reqno');
        var empId = $(this).data('empid');
        //console.log(reqNo);
        //$('#RequestDetailModal').modal('show');
        GetReqDetail(reqNo, empId);
    });

    function GetReqDetail(REQ, empId) {
        $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                EmpId: empId,
                Flag: "view"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#RequestDetailModal').find('.modal-body').html("");
            },
            success: function (data) {
                $('#RequestDetailModal').find('.modal-body').html(data);
                $('#RequestDetailModal').modal('show');
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>GetReqDetail :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }

    $(document).on('click', '#cancel_submit', function () {
        var reqno = $('#cancel_reqid_val').val()
        $.ajax({
            url: '@Url.Action("CancelRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ยกเลิกคำร้องสำเร็จ ",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Cancel Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
    });
</script>