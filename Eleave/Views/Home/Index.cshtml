@model IEnumerable<Eleave.Models.RequestList>
@{
    ViewBag.Title = "หน้าแรก";
}
@{
    var iconMapping = new Dictionary<int, string>
{
         { 1, "fa fa-medkit" },
         { 2, "fa fa-map-marker" },
         { 3, "icon feather icon-rotate-ccw" },
         { 4, "icon feather icon-rotate-ccw" },
     };

    string defaultIcon = "icon feather icon-file-text"; // Default icon
}
<style>
    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Leave Info | ข้อมูลการลา</h5>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->
<!-- [ Main Content ] start -->
<div class="row align-items-stretch">
    <div class="col-md-4 col-lg-4 d-flex flex-column p-0">
        <div class="col-md-12 col-xl-12 p-0">
            <div class="card bg-transparent border-0 shadow-none">
                <div class="card-body p-2">
                    @if (ViewBag.BalanceLeave != null)
                    {
                        foreach (var bal in ViewBag.BalanceLeave)
                        {
                            <div class="col-md-12 col-xl-12 col-sm-4">
                                <div class="card border-top-0 rounded-3 ">
                                    <div class="card-body row">
                                        <div class="col-2 d-flex align-items-center ">
                                            <h5 class="m-0">
                                                @bal.AccuredLeave
                                            </h5>
                                        </div>
                                        <div class="col-8 pl-0 pr-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="">
                                                    <h5>@bal.LeaveType</h5>
                                                    <div class="d-flex flex-row align-items-center time-text">
                                                        <small>ใช้สิทธิแล้ว (@bal.LeaveTaken)</small>
                                                        <span class="dots"></span>
                                                        <small>รออนุมัติ (@bal.WaitApprove)</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-2 p-0 d-flex align-items-center justify-content-center">
                                            <h5 class="content-text-1 m-0"> @bal.ClosingBal</h5>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-12 col-xl-12 col-sm-4">
                            <div class="card border-top-0 rounded-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="text-center"><h5>ไม่พบข้อมูลวันลา</h5></div>
                                        <p class="text-white badge badge-pill badge-primary p-3"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>


            @*<div class="col-md-12 col-xl-12 col-sm-4">
                    <div class="card border-top-0 rounded-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="">TEST</div>
                                <p class="text-white badge badge-pill badge-primary p-3">12</p>
                            </div>
                        </div>
                    </div>
                </div>*@

        </div>
    </div>
    <div class="col-xl-8 col-md-8 d-flex flex-column">
        <div class="card table-card flex-grow-1 p-2">
            <div class="card-header p-3">
                <h5 class="">Request Lists | รายการร้องขอทั้งหมด</h5>
                <div class="card-header-right">
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="height:100%">
                    <table class="table table-bordered table-striped m-0" id="leave-his-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">Req No | รหัสคำขอ</th>
                                <th class="text-center">Req Date | วันที่ขอ</th>
                                <th class="text-center">Req Type | ประเภทการขอ</th>
                                <th class="text-center">Req By | ผู้ร้องขอ</th>
                                <th class="text-center">Req Cate | ประเภทการลา</th>
                                <th class="text-center">From Date | วันที่เริ่มต้น</th>
                                <th class="text-center">End Date | วันที่สิ้นสุด</th>
                                <th class="text-center">Tot Date | รวมขอลา</th>
                                <th class="text-center">Req Status | สถานะคำขอ</th>
                                <th class="text-center">Remark | หมายเหตุการลา</th>
                                <th class="text-center">Appr By | ผู้อนุมัติ</th>
                                <th class="text-center">Appr Date | วันที่อนุมัติ</th>
                                <th class="text-center">ACK By | ผู้รับอนุมัติ</th>
                                <th class="text-center">ACK Date | วันที่ HR รับอนุมัติ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var leave in Model)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td class="text-center">@leave.ReqNo</td>
                                    <td class="text-center">@(leave.ReqDate)</td>
                                    <td class="text-center">@leave.ReqType</td>
                                    <td class="text-center">@leave.Empname</td>
                                    <td class="text-center">@leave.LeaveType</td>
                                    <td class="text-center">@(leave.StartDate)</td>
                                    <td class="text-center">@(leave.EndDate)</td>
                                    <td class="text-center">@leave.NumDay</td>
                                    @if (leave.ReqStatus == "0")
                                    {
                                        <td class="text-center">
                                            <div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "1")
                                    {
                                        <td class="text-center">
                                            <div class="text-success"><i class="fa fa-check" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                        </td>

                                    }
                                    else if (leave.ReqStatus == "2")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger"><i class="fa fa-times" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "3")
                                    {
                                        <td class="text-center">
                                            <div class="text-primary"><i class="fa fa-check" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "4")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger"><i class="fa fa-ban" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@leave.Remark</p>
                                    </td>
                                    <td class="text-center">@leave.ApproveBy</td>
                                    <td class="text-center">@(leave.ApproveDate)</td>
                                    <td class="text-center">@leave.AcknowledgeBy</td>
                                    <td class="text-center">@(leave.AcknowledgeDate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        $('#leave-his-table').dataTable({
            dom: '<t><"d-flex align-items-center"ip>',
            paging: true,
            pageLength: 10,
            pageResize: true,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ การร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    })

</script>