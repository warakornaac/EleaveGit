@model IEnumerable<Eleave.Models.RequestList>

@{
    ViewBag.Title = "ประวัติการลา";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">ประวัติการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("EmployeeHistory","Leave")">ประวัติการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("EmployeeHistory", "Leave", FormMethod.Post))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">ประเภทร้องขอ :</label>
                            @Html.DropDownList("LeaveType", new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-4">
                            <label>ประเภทการลา :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "LeaveType", "Description"), "ประเภทการลา", new { @class = "custom-select", @id = "reqType-selector" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">สถานะคำขอ :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "สถานะคำขอ", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">เริ่มวันที่ :</label>
                            @Html.TextBox("ReqStart", null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">ถึงวันที่ :</label>
                            @Html.TextBox("ReqEnd", null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">รหัสคำขอ :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId" })
                        </div>

                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="Reset" class="btn btn-danger" id="reset-btn" />
                            <input type="submit" value="Search" class="btn btn-success" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-12">
        <div class="card p-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped m-0" id="leave-his-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">รหัสคำขอ</th>
                                <th class="text-center">วันที่ร้องขอ</th>
                                <th class="text-center">ประเภทการขอ</th>
                                <th class="text-center">ผู้ร้องขอ</th>
                                <th class="text-center">ประเภทการลา</th>
                                <th class="text-center">วันที่ลา(เริ่ม)</th>
                                <th class="text-center">วันที่ลา(สิ้นสุด)</th>
                                <th class="text-center">รวมขอลา</th>
                                <th class="text-center">สถานะคำขอ</th>
                                <th class="text-center">หมายเหตุการลา</th>
                                <th class="text-center">ผู้อนุมัติ</th>
                                <th class="text-center">วันที่อนุมัติ</th>
                                <th class="text-center">HR ผู้รับอนุมัติ</th>
                                <th class="text-center">วันที่ HR รับอนุมัติ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var leave in Model)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td>@leave.ReqNo</td>
                                    <td>@leave.ReqDate</td>
                                    <td class="text-center">@leave.ReqType</td>
                                    <td class="text-center">@leave.Empname</td>
                                    <td class="text-center">@leave.LeaveType</td>
                                    <td>@leave.StartDate</td>
                                    <td>@leave.EndDate</td>
                                    <td class="text-center">@leave.NumDay</td>
                                    @if (leave.ReqStatus == "0")
                                    {
                                        <td class="text-center">
                                            <div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "1")
                                    {
                                        <td class="text-center">
                                            <div class="text-success"><i class="fa fa-check" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>

                                    }
                                    else if (leave.ReqStatus == "2")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger"><i class="fa fa-times" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "3")
                                    {
                                        <td class="text-center">
                                            <div class="text-success"><i class="fa fa-check" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "4")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger"><i class="fa fa-ban" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }

                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@leave.Remark</p>
                                    </td>
                                    <td class="text-center">@leave.ApproveBy</td>
                                    <td>@(leave.ApproveDate)</td>
                                    <td class="text-center"> @leave.AcknowledgeBy</td>
                                    <td>@leave.AcknowledgeDate</td>
                                    @if (leave.EmpId.ToString() == Session["EmpId"].ToString() && leave.ReqStatus == "0")
                                    {
                                        <td class="text-center"><a href="#" id="cancelbtn_@leave.ReqNo" data-reqno="@leave.ReqNo">Cancel</a></td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="CancelRequestModal" tabindex="-1" aria-labelledby="ModalCancel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalCancel">ต้องการยกเลิก Request หรือไม่?</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>รหัสคำขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqId" id="cancel_reqid"></p>
                            <input type="hidden" name="ReqIdHide" value="" id="cancel_reqid_val" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ร้องขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqDate" id="cancel_reqdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการขอ: </label>
                            <p class="border-0 p-0 m-0" name="ReqTyp" id="cancel_reqtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>ประเภทการลา: </label>
                            <p class="border-0 p-0 m-0" name="LevTyp" id="cancel_levtyp"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(เริ่ม): </label>
                            <p class="border-0 p-0 m-0" name="StartDate" id="cancel_startdate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(สิ้นสุด): </label>
                            <p class="border-0 p-0 m-0" name="EndDate" id="cancel_enddate"></p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>สถานะคำขอ: </label>
                            <div id="cancel_sta"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>หมายเหตุการลา</label>
                            <p class="border-0 p-0 m-0 mb-1" name="Remark" id="cancel_remark"></p>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">ไม่</button>
                <button type="button" class="btn btn-danger" id="cancel_submit">ใช่</button>
            </div>
        </div>
    </div>
</div>
<script defer>
    $(document).ready(function () {
        $('#department-selector').select2()
    });

    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $(document).on('change', '#LeaveType-selector', function () {
        DropdownReqTyp();
    });
    //$('a[id^="cancelbtn_"]').on('click', function () {
    //    $(this).data();
    //    $('#CancelRequestModal').modal('show');
    //});

    $(document).on('click', '[id^="cancelbtn_"]', function (e) {
        e.preventDefault();
        var reqNo = $(this).data('reqno');
        //console.log(reqNo);
        $('#CancelRequestModal').modal('show');
        GetReqDetail(reqNo);
    });
    $(document).on('click', '#cancel_submit', function () {
        var reqno = $('#cancel_reqid_val').val()
        $.ajax({
            url: '@Url.Action("CancelRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#CancelRequestModal').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ยกเลิกคำร้องสำเร็จ ",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#CancelRequestModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Cancel Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
    });

    function GetReqDetail(REQ) {
        $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ
            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {
                $('#cancel_reqid').text('');
                $('#cancel_reqid_val').val('');
                $('#cancel_reqdate').text('');
                $('#cancel_reqtyp').text('');
                $('#cancel_levtyp').text('');
                $('#cancel_startdate').text('');
                $('#cancel_enddate').text('');
                $('#cancel_remark').text('');
                $('#cancel_sta').html('');
            },
            success: function (data) {
                if (data.message == "Y") {
                    if (data.ReqDetail.length != 0) {
                        $('#cancel_reqid').text(data.ReqDetail[0].ReqNo);
                        $('#cancel_reqid_val').val(data.ReqDetail[0].ReqNo);
                        $('#cancel_reqdate').text(data.ReqDetail[0].ReqDate);
                        $('#cancel_reqtyp').text(data.ReqDetail[0].ReqType);
                        $('#cancel_levtyp').text(data.ReqDetail[0].LeaveType);
                        $('#cancel_startdate').text(data.ReqDetail[0].StartDate);
                        $('#cancel_enddate').text(data.ReqDetail[0].EndDate);
                        $('#cancel_remark').text(data.ReqDetail[0].Remark);
                        if (data.ReqDetail[0].ReqStatus == "0") {
                            $('#cancel_sta').html('<div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span>' + data.ReqDetail[0].ReqStaDesc +'</span></div>');
                        }
                    }
                }
                else {
                    console.log('Detail Err: ' + data.message);
                }
            }
        });
    }

    function DropdownReqTyp()
    {
        $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                data: {

                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#reqType-selector');
                        select.children().remove();
                        select.append($('<option>').val(0).text('เลือกประเภทการร้องขอ'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.LeaveType).text(item.Description));
                        });
                        select.val(0).trigger('change');
                    }
                    else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
    }
    $(document).on("click", "#reset-btn", function () {
        $('#LeaveType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqStatus-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqId').val('');                      // รหัสคำขอ
        $('#reqDate').val('');                    // วันที่แจ้ง
        $('#reqStart').val('');                   // เริ่มวันที่
        $('#reqEnd').val('');                     // ถึงวันที่
    });
    $('#reqStart').inputmask('99/99/9999');
    $('#reqEnd').inputmask('99/99/9999');
    $(document).ready(function () {

        $('#leave-his-table').dataTable({
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คำร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });
</script>

<script type="text/javascript">
    $(document).ready(function () {
        LoadingShow();
    });
</script>

@if (Model != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            setTimeout(function () {
                LoadingHide();
            }, 1500);
        });
    </script>
}
@if (ViewBag.ErrorMessage != null)
{
    <script>
        $(document).ready(function () {
            LoadingHide();
            alert("@ViewBag.ErrorMessage");
        });
    </script>
}