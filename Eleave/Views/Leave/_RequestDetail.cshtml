@*@using Eleave.Models;*@
@{
    Layout = null;
    var reqDetails = ViewBag.ReqDetail;
    string EMPID = Session["EmpId"].ToString();
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>_RequestDetail</title>
</head>
<body>
    @if (ViewBag.ReqDetail != null)
    {
        foreach (var reqDetail in ViewBag.ReqDetail)
        {
            <div class="row">
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">รหัสคำขอ : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="ReqId" id="cancel_reqid"> @reqDetail.ReqNo </p>
                            <input type="hidden" name="ReqIdHide" value="@reqDetail.ReqNo" id="cancel_reqid_val" />
                            <input type="hidden" id="ReqStatus" name="ReqStatus" value="@reqDetail.ReqStatus" />
                            <input type="hidden" id="ReqEmpId" name="ReqEmpId" value="@reqDetail.EmpId" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">ชื่อพนักงาน : </label>
                        <div class="form-control-static">
                            <span style="white-space: nowrap;"><p class="border-0 p-0 m-0" name="Empname" id="Empname"> @reqDetail.Empname </p></span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">วันที่ขอ : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="ReqId" id="cancel_reqid"> @reqDetail.ReqDate </p>
                            <input type="hidden" name="ReqIdHide" value="" id="cancel_reqdate" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">ประเภทการขอ	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="ReqId" id="cancel_reqtyp"> @reqDetail.ReqType </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">ประเภทการลา	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="LevTyp" id="cancel_levtyp"> @reqDetail.LeaveType </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">วันที่ลา(เริ่ม)	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="StartDate" id="cancel_startdate"> @reqDetail.StartDate </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">วันที่ลา(สิ้นสุด)	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="EndDate" id="cancel_enddate"> @reqDetail.EndDate </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">จำนวนวัน	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="NumDay" id="NumDay"> @reqDetail.NumDay </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-md-3">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">สถานะคำขอ : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="CancelStatus" id="cancel_status"> @reqDetail.ReqStaDesc </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 col-md-12">
                    <div class="form-group highlight-addon hide-errors">
                        <label class="control-label font-weight-bold" for="">หมายเหตุการลา	 : </label>
                        <div class="form-control-static">
                            <p class="border-0 p-0 m-0" name="Remark" id="cancel_remark"> @reqDetail.Remark </p>
                        </div>
                    </div>
                </div>
            </div>
            if (ViewBag.Flag == "approve")
            {
                <div class="row">
                    <hr />
                </div>
                <div class="row">
                    <div class="col-sm-6 col-md-6 text-left">
                        <span class="badge badge-light-secondary" style="font-size: 16px;"> สิทธิ์การลาทั้งหมด </span>
                    </div>
                </div>
                <div class="row pt-2">
                    <!-- table card-1 start -->
                    <div class="col-md-12">
                        <div class="card flat-card">
                            <div class="row-table">
                                <div class="col-sm-4 card-body br ">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="fa fa-medkit text-c-green mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>30/2</h5>
                                            <span>ลาป่วย</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 card-body border-right">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="fa fa-umbrella text-c-blue mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>10/1</h5>
                                            <span>ลาพักร้อน</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 card-body ">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="fa fa-bank text-c-blue mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>10/2</h5>
                                            <span>ลากิจ</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row-table">
                                <div class="col-sm-4 card-body br border-top">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="icon feather icon-file-text text-c-blue mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>10/2</h5>
                                            <span>ลากิจส่วนตัว</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 card-body border-right">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="fa fa-list-alt text-c-blue mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>10/3</h5>
                                            <span>ลาอื่นๆ</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 card-body border-top">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <i class="fa fa-plus-square text-c-red mb-1 d-block"></i>
                                        </div>
                                        <div class="col-sm-8 text-md-center">
                                            <h5>5</h5>
                                            <span>ลาทั้งหมด</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="row">
                <hr />
            </div>
            if (ViewBag.ApprvComment.Count > 0)
            {
                <div class="row">
                    <div class="col-sm-6 col-md-6 text-left">
                        <span class="badge badge-light-secondary" style="font-size: 16px;"> คาวมเห็นผู้อนุมัติ </span>
                    </div>
                </div>
            }
            <div class="row">
                @if (ViewBag.ApprvComment != null)
                {
                    int i = 0;
                    foreach (var comm in ViewBag.ApprvComment)
                    {
                        i++;
                        string colorSta = string.Empty;
                        string iconSta = string.Empty;
                        if (comm.RequestStatus == "1")
                        {
                            colorSta = "text-success";
                            iconSta = "fa fa-check";
                        }
                        else if (comm.RequestStatus == "2")
                        {
                            colorSta = "text-danger";
                            iconSta = "fa fa-times";
                        }
                        else if (comm.RequestStatus == "3")
                        {
                            colorSta = "text-success";
                            iconSta = "fa fa-check";
                        }
                        else if (comm.RequestStatus == "4")
                        {
                            colorSta = "text-danger";
                            iconSta = "fa fa-ban";
                        }
                        <div class="col-12">
                            <div class="form-group highlight-addon hide-errors">
                                <label class="control-label font-weight-bold" for="">ผู้อนุมัติคนที่ @i : @comm.ApproveBy</label>
                                <div class="@colorSta badge" style="font-size: 14px;"><i class="@iconSta" aria-hidden="true"></i><span> @comm.ReqStaDesc</span></div>
                                <div class="form-control-static">
                                    @*<p class="border-0 p-0 m-0" id="appr_comm_@i">  </p>*@
                                    <textarea class="form-control" id="apprv_comment_@i" style="resize: none;" readonly>@comm.ApprComment</textarea>
                                </div>
                            </div>
                        </div>
                    }

                }
            </div>
            <br />

            <div id="area-ack-comment">
                @if (ViewBag.AckComment.Count > 0)
                {
                    int i = 0;
                    <div class="row">
                        <div class="col-sm-6 col-md-6 text-left">
                            <span class="badge badge-light-secondary" style="font-size: 16px;"> คาวมเห็นผู้รับทราบอนุมัติ </span>
                        </div>

                        @foreach (var comment in ViewBag.AckComment)
                        {
                            i++;
                            string colorSta = string.Empty;
                            string iconSta = string.Empty;
                            if (comment.RequestStatus == "1")
                            {
                                colorSta = "text-success";
                                iconSta = "fa fa-check";
                            }
                            else if (comment.RequestStatus == "2")
                            {
                                colorSta = "text-danger";
                                iconSta = "fa fa-times";
                            }
                            else if (comment.RequestStatus == "3")
                            {
                                colorSta = "text-success";
                                iconSta = "fa fa-check";
                            }
                            else if (comment.RequestStatus == "4")
                            {
                                colorSta = "text-danger";
                                iconSta = "fa fa-ban";
                            }
                            <div class="col-12">
                                <div class="form-group highlight-addon hide-errors">
                                    <label class="control-label font-weight-bold" for="">ผู้รับทราบอนุมัติ : @comment.ApproveBy</label>
                                    <div class="@colorSta badge" style="font-size: 14px;"><i class="@iconSta" aria-hidden="true"></i><span> @comment.ReqStaDesc</span></div>
                                    <div class="form-control-static">
                                        @*<p class="border-0 p-0 m-0" id="appr_comm_@i">  </p>*@
                                        <textarea class="form-control" id="ack_comment_@i" style="resize: none;" readonly>@comment.ApprComment</textarea>
                                    </div>
                                </div>
                            </div>
                            <br />
                        }
                    </div>
                }
            </div>


            <div class="row">
                <hr />
            </div>
            <div class="row">
                <div class="col-sm-6 col-md-6 text-left">
                    <span class="badge badge-light-secondary" style="font-size: 16px;"> Attach File </span>
                </div>
            </div><br>

            @Html.Partial("_RequestFileDetail", new { });




            @*if (ViewBag.Flag == "approve")
                {
                    <div class="row">
                        <hr />
                    </div>
                    <div class="row">
                        <div class="col-sm-6 col-md-6 text-left">
                            <span class="badge badge-light-secondary" style="font-size: 16px;"> คาวมเห็นผู้อนุมัติ </span>
                        </div>
                    </div>
                    <div class="row pt-2">
                        <div class="col-12">
                            <textarea class="form-control" id="apprv_comment"></textarea>
                        </div>
                    </div>
                }*@<div id="area-comment-form" hidden>
                <div class="row">
                    <hr />
                </div>
                <div class="row">
                    <div class="col-sm-6 col-md-6 text-left">
                        <span class="badge badge-light-secondary" style="font-size: 16px;"> คาวมเห็นผู้อนุมัติ </span>
                    </div>
                </div>
                <div class="row pt-2">
                    <div class="col-12">
                        <textarea class="form-control" id="apprv_comment"></textarea>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger text-center" style="font-size: 16px; font-weight: bold;"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล</div>
    }
</body>
</html>
<script defer>
    $(document).ready(function () {
        var ReqStatus = $("#ReqStatus").val() || 0;
        var EmpString = $('#ReqEmpId').val();
        if (EmpString == '@EMPID') {
            if (ReqStatus > 0) {
                $("#cancel_submit").css("display", "none");
            }
            else {
                $("#cancel_submit").css("display", "block");
            }
        }
        else {
            $("#cancel_submit").css("display", "none");
        }
    });
    $(document).ready(function () {
        var ReqStatus = $("#ReqStatus").val() || 0;
        var EmpString = $('#ReqEmpId').val();
        if (EmpString == '@EMPID') {
            if (ReqStatus > 0) {
                $("#cancel_alt_submit").css("display", "none");
            }
            else {
                $("#cancel_alt_submit").css("display", "block");
            }
        }
        else {
            $("#cancel_alt_submit").css("display", "none");
        }
    });
