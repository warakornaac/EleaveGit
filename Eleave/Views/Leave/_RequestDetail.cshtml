                            <label>หมายเหตุการลา</label>
                            <p class="border-0 p-0 m-0 mb-1" name="Remark" id="cancel_remark">@reqDetail.ReqNo</p>
                        </div>

                    </div>
                </div>*@
        }
    }
    else
    {
        <div class="alert alert-danger text-center" style="font-size: 16px; font-weight: bold;"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล</div>
    }
</body>
</html>
<script defer>
   $(document).on('click', '#cancel_submit', function () {
        var reqno = $('#cancel_reqid_val').val()
        $.ajax({
            url: '@Url.Action("CancelRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Success",
                        text: "ยกเลิกคำร้องสำเร็จ ",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Cancel Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
   });
</script>
