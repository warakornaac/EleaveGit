                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(เริ่ม): </label>
                            <p class="border-0 p-0 m-0" name="StartDate" id="cancel_startdate">@reqDetail.ReqNo</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>วันที่ลา(สิ้นสุด): </label>
