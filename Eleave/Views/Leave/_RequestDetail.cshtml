<script defer>

     //set leave balance
    $('#item-list #sub-item-list').slice(3).hide();
    $('#view-more').click(function () {
        $('#item-list #sub-item-list').slice(3).toggle(); // Toggle the hidden items
        if ($(this).val() == "View More") {
            $(this).val("View Less");
            $(this).html("เพิ่มเติม <i class='fa fa-angle-double-down'> </i>");
        } else {
            $(this).val("View More");
            $(this).html("ย่อ <i class='fa fa-angle-double-up'> </i>");
        }
    });
    $(document).ready(function () {
         var Enddate = $('#EndDatecancel').val();
         // แปลง input เป็น Date object
         var inputDateParts = Enddate.split('/');
         var inputDate = new Date(inputDateParts[2], inputDateParts[1] - 1, 1);

         // ดึง current date
         var currentDate = new Date();
         var currentYear = currentDate.getFullYear();
         var currentMonth = currentDate.getMonth();
         //

         var ReqStatus = $("#ReqStatus").val() || 0;
         var EmpString = $('#ReqEmpId').val();
         if (EmpString == '@EMPID') {
             if (inputDate.getFullYear() != currentYear ||
                 (inputDate.getFullYear() === currentYear && inputDate.getMonth() > currentMonth) && ReqStatus != 1 || ReqStatus == 4 || ReqStatus ==2) {
                 $("#cancel_submit").css("display", "none");
             }
             else {
                 $("#cancel_submit").css("display", "block");
             }
         }
         else {
             $("#cancel_submit").css("display", "none");
         }
     });
    $(document).ready(function () {
         var Enddate = $('#EndDatecancel').val();
         // แปลง input เป็น Date object
         var inputDateParts = Enddate.split('/');
         var inputDate = new Date(inputDateParts[2], inputDateParts[1] - 1, 1);

         // ดึง current date
         var currentDate = new Date();
         var currentYear = currentDate.getFullYear();
         var currentMonth = currentDate.getMonth();
         //

         var ReqStatus = $("#ReqStatus").val() || 0;
         var EmpString = $('#ReqEmpId').val();
         if (EmpString == '@EMPID') {
             if (inputDate.getFullYear() != currentYear ||
                 (inputDate.getFullYear() === currentYear && inputDate.getMonth() > currentMonth) && ReqStatus != 1 || ReqStatus == 4 || ReqStatus == 2) {
                 $("#cancel_alt_submit").css("display", "none");
             }
             else {
                 $("#cancel_alt_submit").css("display", "block");
             }
         }
         else {
             $("#cancel_alt_submit").css("display", "none");
         }
     });

</script>
