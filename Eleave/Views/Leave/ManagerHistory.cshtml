@model IEnumerable<Eleave.Models.RequestList>

@{
    ViewBag.Title = "ประวัติการลา";
}
<style>
    .vcenter {
        vertical-align: middle;
        text-align: -webkit-center;
    }
</style>
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">ประวัติการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManagerHistory","Leave")">ประวัติการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("ManagerSearchHistory", "Leave", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">ประเภทร้องขอ :</label>
                            @Html.DropDownList("LeaveType", new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">ประเภทการลา :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "RequestID", "Description"), "ประเภทการลา", new { @class = "custom-select", @id = "reqType-selector" })

                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">สถานะคำขอ :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "สถานะคำขอ", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">เริ่มวันที่ :</label>
                            @Html.TextBox("ReqStart", null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">ถึงวันที่ :</label>
                            @Html.TextBox("ReqEnd", null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        @*<div class="form-group col-lg-3">
                                <label class="font-weight-bold">แผนก :</label>
                                @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-selector" })
                            </div>*@
                        <div class="form-group col-lg-4">
                            <label class="font-weight-bold">รหัสคำขอ :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId", @placeholder = "รหัสคำขอ" })
                        </div>
                        @*<div class="form-group col-lg-3">
                                <label class="font-weight-bold">ชื่อพนักงาน :</label>
                                @Html.TextBox("empName", null, new { @class = "form-control", @id = "empName", @placeholder = "ชื่อพนักงาน" })
                            </div>*@

                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="ล้าง" class="btn btn-secondary" id="reset-btn" />
                            <input type="submit" value="ค้นหา" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-12">
        <div class="card p-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped m-0" id="leave-his-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">จัดการ</th>
                                <th class="text-center">รหัสคำขอ</th>
                                <th class="text-center">วันที่ขอ</th>
                                <th class="text-center">ประเภทการขอ</th>
                                <th class="text-center">ผู้ร้องขอ</th>
                                <th class="text-center">ประเภทการลา</th>
                                <th class="text-center">วันที่ลา(เริ่ม)</th>
                                <th class="text-center">วันที่ลา(สิ้นสุด)</th>
                                <th class="text-center">รวมขอลา</th>
                                <th class="text-center">สถานะคำขอ</th>
                                <th class="text-center">หมายเหตุการลา</th>
                                <th class="text-center">ผู้อนุมัติ</th>
                                <th class="text-center">วันที่อนุมัติ</th>
                                <th class="text-center">HR ผู้รับอนุมัติ</th>
                                <th class="text-center">วันที่ HR รับอนุมัติ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }

                            @foreach (var leave in Model)
                            {
                                i++;
                                var colorStatus = string.Empty;
                                var iconStatus = string.Empty;
                                <tr>
                                    <td class="vcenter">@i</td>
                                    @if (leave.ReqStatus == "0")
                                    {
                                        <td class="text-center vcenter">
                                            <div class="btn btn-info btn-xs p-1" id="btnview_@leave.ReqNo" data-reqno="@leave.ReqNo"><span class="fa fa-eye p-1"></span></div>
                                            @*@if (leave.ReqStatus == "0")
                                                {
                                                    <div class="btn btn-danger btn-xs p-1" id="cancelbtn_@leave.ReqNo" data-reqno="@leave.ReqNo"><span class="fa fa-times p-1"></span></div>
                                                }*@

                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }

                                    <td class="vcenter">@leave.ReqNo</td>
                                    <td class="vcenter">@leave.ReqDate</td>
                                    <td class="text-center">@leave.ReqType</td>
                                    <td class="text-center">@leave.Empname</td>
                                    <td class="text-center">@leave.LeaveType</td>
                                    <td>@leave.StartDate</td>
                                    <td>@leave.EndDate</td>
                                    <td class="text-center">@leave.NumDay</td>
                                    @if (leave.ReqStatus == "0")
                                    {
                                        colorStatus = "text-warning";
                                        iconStatus = "fa fa-repeat";

                                    }
                                    else if (leave.ReqStatus == "1")
                                    {
                                        colorStatus = "text-success";
                                        iconStatus = "fa fa-check";

                                    }
                                    else if (leave.ReqStatus == "2")
                                    {
                                        colorStatus = "text-danger";
                                        iconStatus = "fa fa-times";
                                    }
                                    else if (leave.ReqStatus == "3")
                                    {
                                        colorStatus = "text-success";
                                        iconStatus = "fa fa-check";
                                    }
                                    else if (leave.ReqStatus == "4")
                                    {
                                        colorStatus = "text-danger";
                                        iconStatus = "fa fa-ban";
                                    }
                                    <td class="text-center">
                                        <div class="@colorStatus badge" style="font-size: 14px;"><i class="@iconStatus" aria-hidden="true"></i><span> @leave.ReqStaDesc</span></div>
                                    </td>

                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@leave.Remark</p>
                                    </td>
                                    <td class="text-center">@leave.AcceptBy</td>
                                    <td>@(leave.AcceptDate?.ToString("dd/MM/yyyy")??"")</td>
                                    @*<td class="text-center">@leave.UpdatedBy</td>
                                        <td>@(leave.UpdateDate?.ToString("dd/MM/yyyy")??"")</td>*@
                                    <td></td>
                                    <td></td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="RequestDetailModal" tabindex="-1" aria-labelledby="ModalCancel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-2">
                <div class="col-sm-10 col-md-10">
                    <h4 class="modal-title" id="myModalLabel">รายละเอียด</h4>
                </div>
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">ปิด</button></div>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" id="cancel_submit"><i class="fa fa-times"></i> ยกเลิกรายการ</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>
<script defer>
    $(document).ready(function () {
        $('#department-selector').select2({
            width: '100%'
        });
    });

    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    //$(document).on('change', '#LeaveType-selector', function () {
    //    DropdownReqTyp();
    //});
    $(document).on('click', '[id^="btnview_"]', function (e) {
        e.preventDefault();
        var reqNo = $(this).data('reqno');
        //console.log(reqNo);
        //$('#RequestDetailModal').modal('show');
        GetReqDetail(reqNo);
    });

    function GetReqDetail(REQ) {
        $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                Flag: "view"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#RequestDetailModal').find('.modal-body').html("");
                //$('#cancel_reqid').text('');
                //$('#cancel_reqid_val').val('');
                //$('#cancel_reqdate').text('');
                //$('#cancel_reqtyp').text('');
                //$('#cancel_levtyp').text('');
                //$('#cancel_startdate').text('');
                //$('#cancel_enddate').text('');
                //$('#cancel_remark').text('');
                //$('#cancel_sta').html('');
            },
            success: function (data) {
                $('#RequestDetailModal').find('.modal-body').html(data);
                $('#RequestDetailModal').modal('show');
                //if (data.message == "Y") {
                //    if (data.ReqDetail.length != 0) {
                //        $('#cancel_reqid').text(data.ReqDetail[0].ReqNo);
                //        $('#cancel_reqid_val').val(data.ReqDetail[0].ReqNo);
                //        $('#cancel_reqdate').text(data.ReqDetail[0].ReqDate);
                //        $('#cancel_reqtyp').text(data.ReqDetail[0].ReqType);
                //        $('#cancel_levtyp').text(data.ReqDetail[0].LeaveType);
                //        $('#cancel_startdate').text(data.ReqDetail[0].StartDate);
                //        $('#cancel_enddate').text(data.ReqDetail[0].EndDate);
                //        $('#cancel_remark').text(data.ReqDetail[0].Remark);
                //        if (data.ReqDetail[0].ReqStatus == "0") {
                //            $('#cancel_sta').html('<div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span>' + data.ReqDetail[0].ReqStaDesc +'</span></div>');
                //        }
                //    }
                //}
                //else {
                //    console.log('Detail Err: ' + data.message);
                //}
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>GetReqDetail :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }

    $(document).on('click', '#cancel_submit', function () {
        var reqno = $('#cancel_reqid_val').val()
        $.ajax({
            url: '@Url.Action("CancelRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ยกเลิกคำร้องสำเร็จ ",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#RequestDetailModal').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Cancel Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
    });
    function DropdownReqTyp()
    {
        $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                data: {

                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#reqType-selector');
                        select.children().remove();
                        select.append($('<option>').val(null).text('เลือกประเภทการร้องขอ'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.RequestID).text(item.Description));
                        });

                    }
                    else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
    }

    function GetReqStatus() {
        $.ajax({
            url: '@Url.Action("GetReqStatus", "Leave")',
            data: {

            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    var select = $('#reqStatus');
                    select.children().remove();
                    select.append($('<option>').val(null).text('สถานะคำขอ'));
                    $(data.ReqSta).each(function (index, item) {
                        select.append($('<option>').val(item.LookValue).text(item.LookDesc));
                    });
                }
                else {
                    console.log('Getstatus Error: ' + data.message);
                }
            }
        });
    }
    $(document).on("click", "#reset-btn", function () {
        $('#reqId').val('');                      // รหัสคำขอ
        $('#reqType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqDate').val('');                    // วันที่แจ้ง
        $('#reqStart').val('');                   // เริ่มวันที่
        $('#reqEnd').val('');                     // ถึงวันที่
        $('#reqStatus').val('').trigger('change'); // สถานะคำขอ
        $('#department-selector').val('').trigger('change');
    });
    $('#reqStart').inputmask('99/99/9999');
    $('#reqEnd').inputmask('99/99/9999');
    $(document).ready(function () {

        $('#leave-his-table').dataTable({
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คำร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });
</script>

<script type="text/javascript">
    document.onreadystatechange = function () {
        if (document.readyState === 'interactive') {
            LoadingShow();
        }
        if (document.readyState === "complete") {
            LoadingHide();
        }
    }
</script>

