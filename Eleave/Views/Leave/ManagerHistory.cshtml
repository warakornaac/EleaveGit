@model IEnumerable<Eleave.Models.RequestList>

@{
    ViewBag.Title = "ประวัติการลา";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">ประวัติการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManagerHistory","Leave")">ประวัติการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("ManagerSearchHistory", "Leave", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-4">
                            <label>ประเภทร้องขอ :</label>
                            @Html.DropDownList("LeaveType", new List<SelectListItem>
                                                {
                                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-4">
                            <label>ประเภทการลา :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "RequestID", "Description"), "ประเภทการลา", new { @class = "custom-select", @id = "reqType-selector" })

                        </div>
                        <div class="form-group col-lg-4">
                            <label>สถานะคำขอ :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "สถานะคำขอ", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label>เริ่มวันที่ :</label>
                            @Html.TextBox("ReqStart", null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label>ถึงวันที่ :</label>
                            @Html.TextBox("ReqEnd", null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label>แผนก :</label>
                            @Html.DropDownList("Department", new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"), "เลือกหน่วยงาน", new { @class = "custom-select", @id = "department-selector" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label>รหัสคำขอ :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId", @placeholder = "รหัสคำขอ" })
                        </div>
                        <div class="form-group col-lg-4">
                            <label>ชื่อพนักงาน :</label>
                            @Html.TextBox("empName", null, new { @class = "form-control", @id = "empName", @placeholder = "ชื่อพนักงาน" })
                        </div>

                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="Reset" class="btn btn-danger" id="reset-btn" />
                            <input type="submit" value="Search" class="btn btn-success" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-12">
        <div class="card p-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped m-0" id="leave-his-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">รหัสคำขอ</th>
                                <th class="text-center">วันที่ขอ</th>
                                <th class="text-center">ประเภทการขอ</th>
                                <th class="text-center">ผู้ร้องขอ</th>
                                <th class="text-center">ประเภทการลา</th>
                                <th class="text-center">วันที่ลา(เริ่ม)</th>
                                <th class="text-center">วันที่ลา(สิ้นสุด)</th>
                                <th class="text-center">รวมขอลา</th>
                                <th class="text-center">สถานะคำขอ</th>
                                <th class="text-center">ผู้อนุมัติ</th>
                                <th class="text-center">วันที่อนุมัติ</th>
                                <th class="text-center">ผู้รับอนุมัติ</th>
                                <th class="text-center">วันที่ HR รับอนุมัติ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var leave in Model)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td>@leave.ReqNo</td>
                                    <td>@(leave.ReqDate?.ToString("dd/MM/yyyy")??"")</td>
                                    <td class="text-center">@leave.ReqType</td>
                                    <td class="text-center">@leave.Empname</td>
                                    <td class="text-center">@leave.LeaveType</td>
                                    <td>@(leave.StartDate?.ToString("dd/MM/yyyy")??"")</td>
                                    <td>@(leave.EndDate?.ToString("dd/MM/yyyy")??"")</td>
                                    <td class="text-center">@leave.NumDay</td>
                                    @if (leave.ReqStatus == "1")
                                    {
                                        <td class="text-center">
                                            <div class="text-success"><i class="fa fa-check" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>

                                    }
                                    else if (leave.ReqStatus == "2")
                                    {
                                        <td class="text-center">
                                            <div class="text-danger"><i class="fa fa-times" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    else if (leave.ReqStatus == "0")
                                    {
                                        <td class="text-center">
                                            <div class="text-warning"><i class="fa fa-repeat" aria-hidden="true"></i><span>@leave.ReqStaDesc</span></div>
                                        </td>
                                    }
                                    <td class="text-center">@leave.AcceptBy</td>
                                    <td>@(leave.AcceptDate?.ToString("dd/MM/yyyy")??"")</td>
                                    <td class="text-center">@leave.UpdatedBy</td>
                                    <td>@(leave.UpdateDate?.ToString("dd/MM/yyyy")??"")</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script defer>
    $('#department-selector').select2({
        width: '100%'
    });
    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    //$(document).on('change', '#LeaveType-selector', function () {
    //    DropdownReqTyp();
    //});
    function DropdownReqTyp()
    {
        $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                data: {

                },
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#reqType-selector');
                        select.children().remove();
                        select.append($('<option>').val(null).text('เลือกประเภทการร้องขอ'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.RequestID).text(item.Description));
                        });

                    }
                    else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
    }

    function GetReqStatus() {
        $.ajax({
            url: '@Url.Action("GetReqStatus", "Leave")',
            data: {

            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    var select = $('#reqStatus');
                    select.children().remove();
                    select.append($('<option>').val(null).text('สถานะคำขอ'));
                    $(data.ReqSta).each(function (index, item) {
                        select.append($('<option>').val(item.LookValue).text(item.LookDesc));
                    });
                }
                else {
                    console.log('Getstatus Error: ' + data.message);
                }
            }
        });
    }
    $(document).on("click", "#reset-btn", function () {
        $('#reqId').val('');                      // รหัสคำขอ
        $('#reqType-selector').val('').trigger('change'); // ประเภทคำขอ
        $('#reqDate').val('');                    // วันที่แจ้ง
        $('#reqStart').val('');                   // เริ่มวันที่
        $('#reqEnd').val('');                     // ถึงวันที่
        $('#reqStatus').val('').trigger('change'); // สถานะคำขอ
        $('#department-selector').val('').trigger('change');
    });
    $(document).ready(function () {
        $('#reqStart').inputmask('99/99/9999');
        $('#reqEnd').inputmask('99/99/9999');
        $('#leave-his-table').dataTable({
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            select: false,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คำร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });
</script>

<script type="text/javascript">
    $(document).ready(function () {
        LoadingShow();
    });
</script>

@if (Model != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            setTimeout(function () {
                LoadingHide();
            }, 1500);
        });
    </script>
}
@if (ViewBag.ErrorMessage != null)
{
    <script>
        $(document).ready(function () {
            LoadingHide();
            alert("@ViewBag.ErrorMessage");
        });
    </script>
}