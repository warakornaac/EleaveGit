
@using Eleave.Models;
@{
    Layout = null;
    var countListLogApprove = ((List<StoreGetLogApprove>)ViewBag.listLogApprove).Count();

}
<style>
    .filepond--credits {
        display: none;
    }

    small, .small {
        font-size: 100%;
    }

    .starLog {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        /*background: #eee;*/
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
    }

    .time-text {
        font-size: 12px;
        color: #989898;
    }

    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
    }
</style>
<div class="card p-2">
    @{
        if (countListLogApprove == 0)
        {
            <div class="mt-3">
                <div class="time-text text-center">
                    <small>ไม่พบข้อมูล</small>
                </div>
            </div>
        }
        else
        {
            foreach (var rowItem in (List<StoreGetLogApprove>)ViewBag.listLogApprove)
            {
                <div class="mt-1">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex flex-row align-items-center">
                            @*<span class="star"><i class="fa fa-star yellow"></i></span>*@
                            <span class="starLog font-bold"><img src="~/Images/Logo/log.png" style="width: 35px;"></span>
                            <div class="d-flex flex-column">
                                <div>@rowItem.ApproveByName <span class="badge badge-warning" style="color: #000000;"><i class="fa fa-clock-o"></i> <span class=""> @rowItem.ApproveDate </span></span> </div>

                                

                                <div class="d-flex flex-row align-items-center time-text">
                                    <small>ผลการอนุมัติ : @rowItem.RequestStatusName</small>
                                </div>
                                <div class="d-flex flex-row align-items-center time-text">
                                    <small>หมายเหตุ : @rowItem.ApprComment</small>
                                </div>
                            </div>
                        </div>
                        @*<span class="content-text-1">@rowItem.ClosingBal</span>*@
                    </div>
                </div>
            }
        }
    }
</div>