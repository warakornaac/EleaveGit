@using Eleave.Models;
@{
    Layout = null;
    var countFile = ((List<RequestFile>)ViewBag.ReqFile).Count();
    string EmpId = Session["EmpId"] != null ? Session["EmpId"].ToString() : string.Empty;
}
<style>
    .swal2-container {
        z-index: 20000 !important;
    }
</style>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>_RequestFileDetail</title>
</head>
<body>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body table-border-style p-0">
                    <div class="table-responsive" style="margin-bottom: -17px;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th class="text-center">Actions | จัดการ</th>
                                    <th>File Name | ชื่อไฟล์</th>
                                    <th>Entry Date | วันที่เพิ่ม</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (countFile == 0)
                                    {
                                        <tr>
                                            <td colspan="4" align="center"> <small> ไม่พบไฟล์ </small> </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int rowFile = 0;
                                        foreach (var rowItem in (List<RequestFile>)ViewBag.ReqFile)
                                        {
                                            rowFile++;
                                            <tr id="rowFile_@rowItem.Id">
                                                <td>@rowFile</td>
                                                <td class="text-center">
                                                    <a class="btn-info btn-xs p-1" href="~/FileUpload/@rowItem.FileName" target="_blank" role="button"><i class="fa fa-download p-1"></i></a>
                                                    @if (@rowItem.InsertedBy == EmpId)
                                                    {
                                                        <a class="btn-danger btn-xs p-1" onclick="deleteRequestFile('@rowItem.Id', '@rowItem.FileName')" role="button"><i class="fa fa-trash p-1 text-white"></i></a>
                                                    }
                                                </td>
                                                <td> @rowItem.FileName </td>
                                                <td> @rowItem.InsertedDate </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script defer>
    function deleteRequestFile(idFile, nameFile) {
        Swal.fire({
            icon: 'question',
            title: 'ต้องการลบไฟล์ใช่หรือไม่',
            html: '<div style="text-align:center;  margin-left: 60px;"> ' + nameFile + '</div>',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
            //footer: `<div class="vleft" style="color:red;"> ***หมายเหตุ </div>`
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("DeleteFile", "Leave")',
                    type: 'post',
                    data: {
                        IdFile: idFile,
                        NameFile: nameFile,
                    },
                    dataType: 'json',
                    beforeSend: function () {
                        LoadingShow();
                    },
                    success: function (res) {
                        if (res.status == 'success') {
                            Swal.fire({
                                icon: 'success',
                                html: res.message,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            }).then((result) => {
                                if (result.value) {
                                    //$("#rowFile_" + idFile).JsLoadingOverlay("show");
                                    $("#rowFile_" + idFile).fadeOut(1000);
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'กรุณาตรวจสอบข้อความดังต่อไปนี้',
                                html: '<div style="text-align:left;">' + res.msg + '</div>',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                            return false;
                        }
                    },
                    complete: function (res) {
                        LoadingHide();
                    }
                }).fail(function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                        html: '<div class="vleft">deleteRequestFile :<p>' + error.responseText + '</p></div>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                });
            }
        });
    }
</script>