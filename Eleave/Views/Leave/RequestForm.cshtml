    //js get date curent
    function getTodayDate() {
        let tdate = new Date();
        let dd = tdate.getDate(); //yields day
        let MM = tdate.getMonth(); //yields month
        let yyyy = tdate.getFullYear(); //yields year
        let currentDate = yyyy + "-" + MM + "-" + dd;
        return currentDate;
    }
