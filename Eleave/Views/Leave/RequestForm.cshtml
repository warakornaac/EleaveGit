<script defer>
    var EmpTypeId = $("#empTypeId").val() || 0;
    //set จำนวนชั่วโมง
    function calNumHour(PeriodTime, NumDay, NumHour, FlagCal) {
        let SetNumHour = NumHour;
        let setPeriodTime = PeriodTime;
        let setNumDay = NumDay;
        let numDayMin = 0;
        let numDayOrg = $("#numDayOrg").val();
        let numDayCal = 0;
        if (SetNumHour == 0) {
            SetNumHour = $("#numHour option:selected").val();
        }
        if (setPeriodTime == 0) {
            setPeriodTime = $("#periodTime option:selected").val();
        }
        if (setNumDay == 0) {
            setNumDay = $("#numDay").val();
        }
        //console.log("setPeriodTime = " + setPeriodTime + " setNumDay = " + setNumDay, " FlagCal = " + FlagCal);
        if (setPeriodTime > 0) {
            if (setPeriodTime != 1) { //ครึ่งเช้า / ครึ่งบ่าย
                SetNumHour = 4;
                numDayMin = 0.5;
                if (setNumDay > 0) {
                    if (FlagCal == 'Y') {
                        numDayCal = Number(numDayOrg) - 0.5;
                    } else {
                        numDayCal = Number(numDayOrg);
                    }
                }
            } else {
                SetNumHour = 8;
                if (FlagCal == 'Y') {
                    numDayCal = Number(setNumDay) + 0.5;
                } else {
                    numDayCal = Number(numDayOrg);
                }
            }
        }
        if (NumHour != 0) {
            SetNumHour = NumHour;
        }
        //กรณี 1 วัน ลาเป็นรายชํ่วโมง
        //console.log("numDayOrg = " + numDayOrg);
        //console.log("SetNumHour = " + SetNumHour);
        if (numDayOrg == 1) {
            console.log("AfterSetNumHour = " + SetNumHour);
            numDayCal = SetNumHour / 8;
            if (numDayCal >= 1) {
                numDayCal = 1;
            } else {
                numDayCal = numDayCal.toFixed(2)
            }
        }
        $("#numHour").val(SetNumHour);
        $("#numDay").val(numDayCal)
    }
    //ดึงเงื่อนไขแต่ละการลา
    function getLeaveTypeCondition(LeaveType) {
        //$("#divDatePicker").fadeIn(100);
        let LeaveTypeName = $("#leaveType option:selected").text();
        let txtCondition = "";

        //if (LeaveType == "SL01") { //ลาป่วย
        //    $(".dates").fadeIn(100);
        //    txtCondition = "การลาป่วยสามารถลาได้ตามระยะเวลาที่ป่วยจริง แต่ได้รับเงินค่าจ้างปกติไม่เกิน 30 วันในรอบปีปฎิทิน และการลาป่วยตั้งแต่ 3 วันติดต่อกันขึ้นไป <u>ต้องมีใบรับรองแพทย์ที่ระบุจำนวนวันลาป่วยเท่ากับวันที่ลาจริงทุกครั้ง</u>";
        //} else {
        //    $(".dates").fadeOut(100);
        //}

        //ลาพักร้อนเลือกได้ 4 ซม ++ disable 1-3
        //if (LeaveType == "AL02") {
        //    $("#numHour option[value='1'], option[value='2'], option[value='3']").prop('disabled', true);
        //} else {
        //    $("#numHour option[value='1'], option[value='2'], option[value='3']").prop('disabled', false);
        //}
        resetValue();
        if (LeaveType != 0) {
            $("#divDatePicker").fadeIn(100); //show เลือกวันละ
            $.ajax({
                type: 'POST',
                cache: false,
                url: '@Url.Action("GetLeaveTypeCondition", "Leave")',
                data: {
                    LeaveType: LeaveType
                },
                dataType: 'json',
                beforeSend: function () {
                    LoadingShow();
                    //$("#divCondition").html('<i class="fa fa-spinner fa-spin f-center"></i>');
                },
