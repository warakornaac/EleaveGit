    //cal no Weekday
    function calculateWeekdays(start, end) {
        let count = 0;
        let current = new Date(start);
        //saturday, sunday
        while (current <= end) {
            //if (current.getDay() !== 0 && current.getDay() !== 6) {
                count++;
            //}
            current.setDate(current.getDate() + 1);
        }
        return count;
    }
