@using Eleave.Models;
@{
    ViewBag.Title = "บันทึกการลา";
    var countListBalance = ((List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance).Count();
}
<style>
    .filepond--credits {
        display: none;
    }

    small, .small {
        font-size: 100%;
    }

    .star {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eee;
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
    }

    .time-text {
        font-size: 12px;
        color: #989898;
    }

    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
    }
</style>

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">บันทึกการลา</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("RequestForm", "Leave")">บันทึกการลา</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>คำขออนุมัติลา </h5>
                @*<span class="badge badge-light-secondary" style="font-size: 16px;"> @ViewBag.DocumentRequest </span>*@
            </div>
            <div class="card-body">
                <div class="row">
                    <input type="hidden" id="reqNo" value="@ViewBag.DocumentRequest">
                    <div class="col-md-4 mb-4">
                        <label for="validationTooltip02" class="font-weight-bold">ประเภทการร้องขอ</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-list"></i></span>
                            </div>
                            <select id="reqType" class="form-control" onchange="dropDownRequest(this.value);">
                                <option value="0" selected>เลือกประเภทร้องขอ</option>
                                @foreach (var type in ViewBag.REQ_T)
                                {
                                    <option value="@type.LookValue">@type.LookDesc</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div id="divDateleaveType" class="col-md-8 mb-8">

                        <label for="validationTooltip02" class="font-weight-bold">ประเภทการลา</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-file-text-o"></i></span>
                            </div>
                            <select id="leaveType" name="leaveType" class="form-control" onchange="getConditionLeaveType(this.value);">
                                <option value="0" selected>เลือกประเภทการลา</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top: -5px;">
                    <div class="col-md-12">
                        <div class="alert alert-warning p-1" role="alert">
                            <b>เงื่อไนขการลา : </b> พนักงานที่ประสงค์จะลาหยุดงาน จะต้องกรอกข้อมูลการลาในระบบและยื่นต่อผู้บังคับบัญชาตามลำดับชั้น และจะลาได้ก็ต่อเมื่อผู้บังคับบัญชาได้อนุมัติการลาเท่านั้น
                        </div>
                    </div>
                </div>
                <div id="divDatePicker" style="display:none;">
                    <div class="row">
                        <div class="col-md-6 mb-6">
                            <label for="validationTooltip04" class="font-weight-bold">วันที่ลา(จาก-ถึง)</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-calendar"></i></span>
                                </div>
                                <input type="text" class="form-control" name="daterange" id="dates-available-from" placeholder="จาก" aria-describedby="inputGroupPrepend" required>
                                <input type="hidden" id="startDateDiv">
                                <input type="hidden" id="endDateDiv">
                                @*<div class="input-group-prepend">
                                        <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-calendar"></i></span>
                                    </div>
                                    <input type="text" class="form-control" id="endDate" placeholder="ถึง" aria-describedby="inputGroupPrepend" required>*@
                            </div>
                        </div>

                        <div class="col-md-2 mb-2">
                            <label for="validationTooltip03" class="font-weight-bold">ช่วงเวลา</label>
                            <select id="periodTime" name="periodTime" class="form-control">
                                <option value="1" selected>ทั้งวัน</option>
                                <option value="2">ช่วงเช้า</option>
                                <option value="3">ช่วงบ่าย</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="validationTooltip03" class="font-weight-bold">จำนวนวัน</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-calendar-plus-o"></i></span>
                                </div>
                                <input type="text" class="form-control" name="numDay" id="numDay" placeholder="วัน">
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label for="validationTooltip03" class="font-weight-bold">จำนวนชั่วโมง</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="inputGroupPrepend"><i class="fa fa-clock-o"></i></span>
                                </div>
                                <input type="text" class="form-control" name="numHour" id="numHour" placeholder="ชั่วโมง">
                            </div>

                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="col-md-12 mb-12">
                        <label for="exampleFormControlTextarea1" class="font-weight-bold">รายละเอียด/เหตุผลการลา</label>
                        <div class="form-group">
                            <textarea class="form-control" name="remark" id="remark" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="col-md-12 mb-12">
                        <label for="validationTooltip03" class="font-weight-bold">ไฟล์แนบ/Attach File</label>
                        <div class="row">
                            <div class="col">
                                <div class="file-loading">
                                    <input id="file_upload_multi" name="file_upload_multi[]" type="file" multiple="multiple">
                                </div>
                            </div>
                        </div>
                        <label id="r" class="text-success">อัปโหลดไฟล์ jpg, jped, png, pdf ขนาดไม่เกิน 5 MB (สามารถเลือกได้หลายไฟล์)</label>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-sm-12 text-right">
                        <button class="btn btn-secondary btn-md">ล้าง</button>
                        <button class="btn btn-primary btn-md" type="button" onclick="btnSubmitRequest();">บันทึก</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-12">
        <div class="card border-0 p-2">
            <div class="card-header p-2" style="border-bottom: 1px solid #e5c1be;">
                <h5 class="text-success"> สิทธิคงเหลือ </h5>
            </div>
            <div id="item-list">
                @{
                    if (countListBalance == 0)
                    {
                        <div class="mt-3">
                            <div class="time-text text-center">
                                <small>ไม่พบข้อมูล</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        foreach (var rowItem in (List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance)
                        {
                            <div class="mt-3" id="sub-item-list">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex flex-row align-items-center">
                                        @*<span class="star"><i class="fa fa-star yellow"></i></span>*@
                                        <span class="star font-bold">@rowItem.AccuredLeave</span>
                                        <div class="d-flex flex-column">
                                            <span>@rowItem.Description</span>
                                            <div class="d-flex flex-row align-items-center time-text">
                                                <small>ใช้สิทธิแล้ว (@rowItem.LeaveTaken)</small>
                                                <span class="dots"></span>
                                                <small>รออนุมัติ (@rowItem.WaitApprove)</small>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="content-text-1">@rowItem.ClosingBal</span>
                                </div>
                            </div>
                        }
                    }
                }
                <div class="mt-3 text-right text-primary" style="cursor: pointer;">
                   <a id="view-more" value="View More" style=""> เพิ่มเติม <i class="fa fa-angle-double-down"> </i> </a>
                </div>
            </div>
        </div>
    </div>
