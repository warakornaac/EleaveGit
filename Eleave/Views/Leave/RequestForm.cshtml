<style>
    /**leaveBalance*/
    .filepond--credits {
        display: none;
    }

    small, .small {
        font-size: 100%;
    }

    .star {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eee;
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
        font-size: 12px;
        text-align: center;
    }

    .time-text {
        font-size: 12px;
        color: #989898;
    }

    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 30%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
        font-size: 12px;
        width: 37px;
        word-wrap: break-word;
        text-align: center;
        white-space: pre-line;
    }
    /**note*/
    .tile {
        width: 100%;
        background: #fff;
        border-radius: 5px;
        box-shadow: 0px 2px 3px -1px rgba(151, 171, 187, 0.7);
        float: left;
        transform-style: preserve-3d;
        margin: 10px 0px;
    }

    .headerNote {
        border-bottom: 1px solid #ebeff2;
        padding: 19px 0;
        text-align: center;
        color: #59687f;
        font-size: 600;
        font-size: 19px;
        position: relative;
    }

    .dates {
        /*border: 1px solid #ebeff2;*/
        border-radius: 5px;
        /*padding: 20px 0px;*/
        margin: 10px 20px;
        font-size: 14px;
        color: #cb661f;
        /*font-weight: 600;*/
        overflow: auto;
    }

        .dates div {
            float: left;
            width: 100%;
            text-align: left;
            position: relative;
            font-size: 14px;
            padding: 2px;
        }

        .dates strong,
        .stats strong {
            display: block;
            /*color: #020202;*/
            font-size: 11px;
            font-weight: 700;
        }

        .dates span {
            width: 1px;
            height: 40px;
            position: absolute;
            right: 0;
            top: 0;
            background: #ebeff2;
        }

    .stats {
        border-top: 1px solid #ebeff2;
        background: #ffca7b;
        overflow: auto;
        padding: 2px 0;
        font-size: 20px;
        color: #59687f;
        font-weight: 600;
        border-radius: 5px;
    }

        .stats div {
            /*border-right: 1px solid #ebeff2;*/
            width: 50%;
            float: left;
            text-align: center;
            color: #000000;
        }

            .stats div:nth-of-type(3) {
                border: none;
            }

    #datepicker {
        width: 200px;
        font-size: 16px;
    }

    /* Customize the calendar dropdown */
    .datepicker {
        background-color: #f8f9fa;
        border: 1px solid #ccc;
        border-radius: 5px;
        /*width: 300px;*/
    }

        /* Change today button color */
        .datepicker .today,
        .datepicker .today:hover {
            background-color: #007bff;
