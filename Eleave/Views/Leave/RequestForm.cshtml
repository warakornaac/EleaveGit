@* krajee *@
<script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/plugins/buffer.min.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/plugins/filetype.min.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/plugins/piexif.min.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/plugins/sortable.min.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/fileinput.min.js"></script>

<script defer>
    //set leave balance
    $('#item-list #sub-item-list').slice(5).hide();
    $('#view-more').click(function () {
        $('#item-list #sub-item-list').slice(5).toggle(); // Toggle the hidden items
        if ($(this).val() == "View More") {
            $(this).val("View Less");
            $(this).html("เพิ่มเติม <i class='fa fa-angle-double-down'> </i>");
        } else {
            $(this).val("View More");
            $(this).html("ย่อ <i class='fa fa-angle-double-up'> </i>");
        }
    });

    //js get date curent
    function getTodayDate() {
        var tdate = new Date();
        var dd = tdate.getDate(); //yields day
        var MM = tdate.getMonth(); //yields month
        var yyyy = tdate.getFullYear(); //yields year
        var currentDate = yyyy + "-" + MM + "-" + dd;
        return currentDate;
    }
    //เลือกประเภทการร้องขอ
    function dropDownRequest(reqType) {
        console.log("reqType = " + reqType);
        if (reqType == 2) {
            $("#divDateleaveType").fadeOut(100);
        } else {
            $("#divDateleaveType").fadeIn(100);
            $.ajax({
                url: '@Url.Action("GetLeavetype", "Leave")',
                type: 'POST',
                dataType: 'JSON',
                success: function (data) {
                    if (data.message == 'Y') {
                        var select = $('#leaveType');
                        select.children().remove();
                        select.append($('<option>').val(0).text('เลือกประเภทการลา'))
                        $(data.LeaveType).each(function (index, item) {
                            select.append($('<option>').val(item.LeaveType).text(item.Description));
                        });
                        select.val(0).trigger('change');
                    } else {
                        console.log('Message Type: ' + data.message);
                    }
                }
            });
        }
    }
    //เลือกประเภทกวารลา
    function getConditionLeaveType(leaveId) {
        var todayDate = getTodayDate();
        var setMinDate = 0;
        console.log("leaveId = " + leaveId);
        if (leaveId != "SL01") { //ไม่ใช่ลาป่วยต้องลาล่วงหน้า 1 วัน
            setMinDate = 1;
        }
        setDateStart(setMinDate);
        //set datediff defalut
        console.log('todayDate = ' + todayDate);
        $("#startDateDiv").val(todayDate);
        $("#endDateDiv").val(todayDate);
        $('#numDay').val(1);
        if (leaveId == 0) { //hide
            $("#divDatePicker").fadeOut(100);
        } else { //show
            $("#divDatePicker").fadeIn(100);
        }
    }

    //ปุ่มบันทึก
    function btnSubmitRequest() {
        let error = 0;
        let textMsg = "";
        var ReqNo = $("#reqNo").val();
        var EmpId = @this.Session["EmpId"].ToString();
        var ReqType = $("#reqType option:selected").val();
        var LeaveType = $("#leaveType option:selected").val();
        var StartDate = $("#startDateDiv").val();
        var EndDate = $("#endDateDiv").val();
        var PeriodTime = $("#periodTime option:selected").val();
        var NumDay = $("#numDay").val() || 0;
        var NumHour = $("#numHour").val() || 0;
        var Remark = $("#remark").val() || "";
        //alert(ReqType + " LeaveType = " + LeaveType);
        //return false;
        if (ReqType == 0) {
            error++;
            textMsg += error + '. กรุณาเลือกประเภทการร้องขอ <br/>';
        }
        if (ReqType == 1 && LeaveType == 0) {
            error++;
            textMsg += error + '. กรุณาเลือกประเภทการลา <br/>';
        }
        if (error > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลดังต่อไปนี้ และลองใหม่อีกครั้ง',
                html: '<div class="text-left">' + textMsg + '</div>',
            });
            return false;
        }

        console.log("startDate = " + StartDate + " endDate = " + EndDate);

        var formData = new FormData();
        var totalFiles = document.getElementById("file_upload_multi").files.length;
        for (var i = 0; i < totalFiles; i++) {
            var file = document.getElementById("file_upload_multi").files[i];
            formData.append("file_upload_multi", file);
        }
        formData.append('ReqNo', ReqNo);
        formData.append('EmpId', EmpId);
        formData.append('ReqType', ReqType);
        formData.append('LeaveType', LeaveType);
        formData.append('StartDate', StartDate);
        formData.append('EndDate', EndDate);
        formData.append('PeriodTime', PeriodTime);
        formData.append('NumDay', NumDay);
        formData.append('NumHour', NumHour);
        formData.append('Remark', Remark);

        if (formData.entries() != null) {
            for (var pair of formData.entries()) {
                console.log(pair[0] + ', ' + pair[1]);
            }
        }
        Swal.fire({
            icon: 'question',
            title: 'ต้องการบันทึกใช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                 $.ajax({
                    url: '@Url.Action("SaveRequestForm", "Leave")',
                    type: 'post',
                    enctype: 'multipart/form-data',
                    data: formData,
                    dataType: 'json',
                    async: true,
                    cache: false,
                    contentType: false,
                    processData: false,
                    beforeSend: function () {
                        LoadingShow();
                    },
                    success: function (result) {
                        console.log("result.status = " + result.status);
                        if (result.status != "success") {
                            Swal.fire({
                                title: 'เกิดข้อผิดพลาด',
                                icon: 'error',
                                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>' + result.message +'<br><br>',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            }).then((result) => {
                                LoadingShow();
                                location.reload();
                            });
                        } else {
                              Swal.fire({
                                title: 'บันทึกเรียบร้อย <br> ' + result.getReqNo ,
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                onClose: () => {
                                    LoadingHide();
                                }
                             }).then((result) => {
                                 LoadingShow();
                                 window.location.href = '@Url.Action("ManagerHistory", "Leave")';
                             });
                        }
                    },
                    complete: function () {
                        LoadingHide();
                    },
                }).fail(function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ระบบทำงานผิดพลาด()',
                        html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>btnSubmitRequest<br><br>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                });
            }
        });
    }
    //upload file
    $('#file_upload_multi').fileinput({
        fileActionSettings: {
            //showUpload: false,
            //showDelete: true,
            //showRemove: false
            showRemove: true,
            showUpload: false, //This remove the upload button
            showZoom: true,
            showDrag: false
        },
        showRemove: false,
        previewFileType: 'image',
        dropZoneEnabled: true,
        browseOnZoneClick: true,
        uploadAsync: true,
        theme: 'fa',
        removeFromPreviewOnError: true,
        showPreview: true,
        showUpload: false,
        browseOnZoneClick: true,
        allowedPreviewTypes: false,
        //showUpload: false,
        //initialPreviewShowDelete: true,
        //initialPreviewAsData: true,
        //uploadUrl: "/Home/FileUpload",
        //deleteUrl: "/Home/FileDelete",
        //uploadUrl: '@Url.Action("Leave", "SaveRequestForm")',
        maxFileCount: 5,
        maxFileSize: 5120, //5mb
        maxFilePreviewSize: 10240,
        //initialPreview: true,
        //initialPreviewAsData: true,
        overwriteInitial: false,
        preferIconicPreview: true,
        previewFileIconSettings: {
            'doc': '<i class="fas fa-file-word text-primary"></i>',
            'xls': '<i class="fas fa-file-excel text-success"></i>',
            'ppt': '<i class="fas fa-file-powerpoint text-danger"></i>',
            'pdf': '<i class="fas fa-file-pdf text-danger"></i>',
            'zip': '<i class="fas fa-file-archive text-muted"></i>',
            'htm': '<i class="fas fa-file-code text-info"></i>',
            'txt': '<i class="fas fa-file-alt text-info"></i>',
            'mov': '<i class="fas fa-file-video text-warning"></i>',
            'mp3': '<i class="fas fa-file-audio text-warning"></i>',
            'jpg': '<i class="fas fa-file-image text-danger"></i>',
            'gif': '<i class="fas fa-file-image text-muted"></i>',
            'png': '<i class="fas fa-file-image text-primary"></i>'
        },
        previewFileExtSettings: { // configure the logic for determining icon file extensions
            'doc': function (ext) {
                return ext.match(/(doc|docx)$/i);
            },
            'xls': function (ext) {
                return ext.match(/(xls|xlsx)$/i);
            },
            'ppt': function (ext) {
                return ext.match(/(ppt|pptx)$/i);
            },
            'zip': function (ext) {
                return ext.match(/(zip|rar|tar|gzip|gz|7z)$/i);
            },
            'htm': function (ext) {
                return ext.match(/(htm|html)$/i);
            },
            'txt': function (ext) {
                return ext.match(/(txt|ini|csv|java|php|js|css)$/i);
            },
            'mov': function (ext) {
                return ext.match(/(avi|mpg|mkv|mov|mp4|3gp|webm|wmv)$/i);
            },
            'mp3': function (ext) {
                return ext.match(/(mp3|wav)$/i);
            }
        }
    });


    function setMinMaxDate(element) {
        // Store current date - setting max/min date seems to destroy time component
        var val = element;

        if (element.id == 'endDate') {
            var x = $('#startDate').daterangepicker("getDate");
            $(element).datetimepicker("option", "minDate", x);
        }
        else if (element.id == 'startDate') {
            var x = $('#endDate').daterangepicker("getDate");
            $(element).datetimepicker("option", "maxDate", x);
        }
        // Restore date
        $(element).val(val);
    }

     function setDateStart(setMinDate) {
        if (setMinDate != 0) {
            setMinDate = "-" + setMinDate;
        } else {
            setMinDate = 0;
        }
        $('input[name="daterange"]').daterangepicker({
            startDate: moment().subtract('days', 7),
            endDate: moment().subtract('days', setMinDate),
            minDate: moment().subtract('days', setMinDate),
