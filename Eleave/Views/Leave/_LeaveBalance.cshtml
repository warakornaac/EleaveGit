
@using Eleave.Models;
@{
    Layout = null;
    var countListBalance = ((List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance).Count();

}
<style>
    .filepond--credits {
        display: none;
    }

    small, .small {
        font-size: 100%;
    }

    .star {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eee;
        margin-right: 10px;
        border-radius: 5px;
        font-weight: 700;
    }

    .time-text {
        font-size: 12px;
        color: #989898;
    }

    .dots {
        height: 7px;
        width: 7px;
        background-color: #eee;
        display: flex;
        border-radius: 50%;
        margin-left: 7px;
        margin-right: 7px;
    }

    .content-text-1 {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #e3f3e1;
        color: #0c8916;
        font-weight: 700;
    }
</style>
<div class="card p-2">
    @{
        if (countListBalance == 0)
        {
            <div class="mt-3">
                <div class="time-text text-center">
                    <small>ไม่พบข้อมูล</small>
                </div>
            </div>
        }
        else
        {
            foreach (var rowItem in (List<StoreGetLeaveBalance>)ViewBag.listLeaveBalance)
            {
                <div class="mt-1">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex flex-row align-items-center">
                            @*<span class="star"><i class="fa fa-star yellow"></i></span>*@
                            <span class="star font-bold">@rowItem.AccuredLeave</span>
                            <div class="d-flex flex-column">
                                <span>@rowItem.Description</span>
                                <div class="d-flex flex-row align-items-center time-text">
                                    <small>ใช้สิทธิแล้ว (@rowItem.LeaveTaken)</small>
                                    <span class="dots"></span>
                                    <small>รออนุมัติ (@rowItem.WaitApprove)</small>
                                </div>
                            </div>
                        </div>
                        <span class="content-text-1">@rowItem.ClosingBal</span>
                    </div>
                </div>
            }
        }
    }
</div>