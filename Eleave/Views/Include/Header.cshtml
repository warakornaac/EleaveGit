    function CheckApprovalReq(REQ) {
    return $.ajax({
        url: '@Url.Action("CheckApproval", "Approval")',
        data: {
            ReqNo: REQ
        },
        type: 'POST',
        dataType: 'JSON',
        beforeSend: function () {

        },
        success: function (res) {
            if (res.message == 'Y') {
                $('#area-comment-form').removeAttr('hidden');
                $('#btnAlt-apprv-form').removeClass('d-none');
            }
            else if (res.message == 'N') {
                $('#area-comment-form').attr('hidden',true);
                $('#btnAlt-apprv-form').addClass('d-none');
            }
            else {
                console.log('Error :' + res.message);
            }
        }
    });
}



