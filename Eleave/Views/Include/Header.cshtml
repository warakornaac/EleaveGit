        function CheckAcknowledge(REQ) {
        return $.ajax({
            url: '@Url.Action("CheckAcknowledge", "Acknowledge")',
            data: {
                ReqNo:REQ
            },
            type: 'POST',
            dataType: 'JSON',
            cache: false,
            beforeSend: function () {
                LoadingShow();
            },
            success: function (res) {
                if (res.message === "Y") {
                    $('#ack-comment-div').removeClass('d-none');
                    $('#btnAlt-ack-form').removeClass('d-none');
                }
                else if (res.message === "N") {
                    $('#ack-comment-div').addClass('d-none');
                    $('#btnAlt-ack-form').addClass('d-none');
                }
                else {
                    $('#ModalAlert').modal('hide');
                    Swal.fire({
                        icon: 'error',
                        html: '<p>Error :</p><p>' + res.message + '</p>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            }, complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        });
    }


    /////Approve
        function ApproveAltSubmit(Sta) {
        var comment = $('#apprv_comment').val();
        var reqno = $('#cancel_reqid').text()
        console.log('ReqNo Sub:' + reqno);
        $.ajax({
            url: '@Url.Action("UpdateApproval", "Approval")',
            data: {
                ReqNo: reqno,
                ApprvStatus: Sta,
                ApprvComment: comment
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#ModalAlert').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ทำการอนุมัติเสร็จสิ้น",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#ModalAlert').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: data.message,
                        icon: "error"
                    }).then(() => {
                        $('#ModalAlert').modal('show');
                    });
                }
            }
        })
    }

