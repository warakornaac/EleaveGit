<div class="modal fade" id="ModalAlert" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="ModalAlertLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalAlertLabel">Modal title</h5>
                @*<button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>*@
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" id="alrt-modal-btn-close" data-dismiss="modal">Close | ปิด</button></div>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <div class="d-none" id="btnAlt-apprv-form">
                    <button type="button" class="btn btn-secondary" id="Approv_alt_submit" value="1">อนุมัติ/Approve</button>
                    <button type="button" class="btn btn-danger" id="Approv_alt_reject" value="2">ปฎิเสธ/Reject</button>
                </div>
                <div class="d-none" id="btnAlt-ack-form">
                    <button type="button" class="btn btn-success" id="acknowledge-alt-btn">รับทราบ/Acknowledge</button>
                </div>

                <button type="button" class="btn btn-warning" id="cancel_alt_submit"><i class="fa fa-times"></i> ยกเลิกรายการ </button>

            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        UserSession();
        $('#notificate-alert').click(function () {
            UserSession();
        });
    });
    $(document).on('click', '[id^="emp_btn_"]', async function () {
        var con = $(this).data('reqno');
        var empId = $(this).data('empid');
        console.log('btn : ' + con);
        GetReqDetail(con, empId);
    });
    $(document).on('click', '[id^="manager_btn_"]', async function () {
        var con = $(this).data('reqno');
        var empId = $(this).data('empid');
        console.log('btn : ' + con);
        await GetReqDetailApproval(con, empId);
        await CheckApprovalReq(con);
    });
    $(document).on('click', '[id^="hr_btn_"]', async function () {
        var con = $(this).data('reqno');
        var empId = $(this).data('empid');
        console.log('btn : ' + con);
        await GetDetailAcknowledge(con, empId);
        await CheckAcknowledge(con);
    });
    $(document).on('click', '#alrt-modal-btn-close', function () {
        $('#ModalAlert').modal('hide');
    });
    $(document).on('click', '#alert_refresh', function () {
        UserSession();
    });
    $(document).on('click', '#notificate-alert', function () {
        UserSession();
    });

    //setInterval(function () {
    //    UserSession();
    //}, 6000);



    /////Approve
    $(document).on('click', '[id^="Approv_alt_"]', function (e) {
        e.preventDefault();
        var status = $(this).val();
        console.log("Status Btn: " + status);
        ApproveAltSubmit(status);
    })
    /////Acknowledge
    $(document).on('click', '#acknowledge-alt-btn', function (e) {
        e.preventDefault();
        var ReqNo = $('#ReqIdHide').val();
        var Ack_comment = $('#ack-comment').val();
        console.log('Req :' + ReqNo);
        console.log('Comment :' + Ack_comment);
        SaveAcknowledge(ReqNo, Ack_comment);
    });

    ///////cancel
    $(document).on('click', '#cancel_alt_submit', function () {
        var reqno = $('#cancel_reqid_val').val();
        $.ajax({
            url: '@Url.Action("CancelRequest", "Leave")',
            data: {
                ReqNo: reqno
            },
            type: 'POST',
            dataType: 'JSON',
            success: function (data) {
                if (data.message == 'Y') {
                    $('#ModalAlert').modal('hide');
                    Swal.fire({
                        title: "Success!!!",
                        text: "ยกเลิกคำร้องสำเร็จ ",
                        icon: "success"
                    }).then(() => {
                        location.reload();
                    });
                }
                else {
                    $('#ModalAlert').modal('hide');
                    Swal.fire({
                        title: "Error!!!",
                        text: "Cancel Failed : " + data.message,
                        icon: "error"
                    });
                }
            }
        });
    });
    //////

    function UserSession() {
        var Type = '@UserType'
        //console.log('Type:' + Type);
        switch (Type) {
            case '1':
                ReqAlert();
                break;
            case '2':
                AdminAlert();
                break;
            case '3':
                ManagerAlert();
                break;
            default:
                ReqAlert()
                break;
        }
    }
    function ReqAlert() {
        $.ajax({
            url: '@Url.Action("GetAlertEmp", "Home")',
            data: {

            },
            type: 'POST',
            dataType: 'JSON',
            beforeSend: function () {

            },
            success: function (data) {
                if (data.message == 'Y') {
                    var HtmlString = '';
                    var StaIcon = '';
                    var colorStatus = '';

                    $('.noti-body').empty();
                    $('.noti-body').html('<li class="n-title"><p class= "m-b-0">รายการรออนุมัติ</p></li>');
                    if (data.REQ.length != 0) {
                        $('#alert-number').text(data.REQ.length);
                        $('#bell_alert').addClass('text-warning');
                        for (var i = 0; i < data.REQ.length; i++) {
                            if (data.REQ[i].ReqStatus == 0) {
                                StaIcon = 'fa fa-repeat';
                                colorStatus = "text-warning";
                            }
                            if (data.REQ[i].ReqStatus == 1) {
                                StaIcon = 'fa fa-check';
                                colorStatus = "text-success";
                            }
                            if (data.REQ[i].ReqStatus == 2) {
                                StaIcon = 'fa fa-times';
                                colorStatus = "text-danger";
                            }
                            if (data.REQ[i].ReqStatus == 3) {
                                StaIcon = 'fa fa-check';
                                colorStatus = "text-success";
                            }
                            if (data.REQ[i].ReqStatus == 4) {
                                StaIcon = 'fa fa-ban';
                                colorStatus = "text-danger";
                            }
                            HtmlString += '<li class="notification">';
                            HtmlString += '<a href="#!" id="emp_btn_' + data.REQ[i].ReqNo + '" data-reqno="' + data.REQ[i].ReqNo + '" data-empid="' + data.REQ[i].EmpId + '">'
                            HtmlString += ' <div class="media">';
                            HtmlString += '     <div class="media-body">';
                            HtmlString += '         <p><strong>' + data.REQ[i].Empname + '</strong><strong class="float-end "> ' + data.REQ[i].LeaveType + '</strong></p>';
                            HtmlString += '         <p><span class="' + colorStatus + '"><i class="' + StaIcon + '"></i>' + data.REQ[i].ReqStaDesc + '</p>';
                            HtmlString += '     </div>';
                            HtmlString += ' </div>';
                            HtmlString += '</a>';
                            HtmlString += '</li > ';

                        }
                        $('.noti-body').append(HtmlString);

                    }
                    else {
                        $('#alert-number').text('0');
                        $('#bell_alert').removeClass('text-warning');
                        $('.noti-body').html('<li class="n-title"><p class= "m-b-0">ไม่พบรายการที่ต้องดำเนินงาน</p></li>');
                    }
                }
            },
            error: function (xhr, status, error) {
                console.log('AJAX error: ' + status + ' - ' + error);
            }
        });
    }
