    ///////ForModalAlert
    function GetReqDetail(REQ, empId) {
    return  $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                EmpId: empId,
                Flag: "view"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#ModalAlert').find('.modal-body').html("");
                $('#ModalAlertLabel').text('การอนุมัติคำขอ');
            },
            success: function (data) {
                $('#ModalAlert').find('.modal-body').html(data);
                $('#ModalAlert').modal('show');
            },complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>GetReqDetail :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }


