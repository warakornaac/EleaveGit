@model IEnumerable<Eleave.Models.ApprovalRequest>
@{
    ViewBag.Title = "รับทราบการอนุมัติ";

}
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">รับทราบการอนุมัติ</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")"><i class="feather icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("AdminAcknowledge","Acknowledge")">รับทราบการอนุมัติ</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            @using (Html.BeginForm("AdminAcknowledge", "Acknowledge", FormMethod.Post, new { @id = "formSearch" }))
            {
                <div class="card-body p-3 m-0">

                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Request Type | ประเภทร้องขอ :</label>
                            @*@Html.DropDownList("LeaveType", new List<SelectListItem>
                                {
                                    new SelectListItem() {Text="ลาป่วย", Value="ลาป่วย"},
                                    new SelectListItem() {Text="ลากิจ", Value="ลากิจ"},
                                    new SelectListItem(){Text="ลาพักร้อน",Value="ลาพักร้อน"}
                                }, "ลา", new { @class = "custom-select", @id = "LeaveType-selector", @disabled = "disabled" })*@
                            @Html.DropDownList("LeaveType", new SelectList(ViewBag.REQ_T, "LookValue", "LookDesc"), "Select request type | เลือกประเภทร้องขอ", new { @class = "custom-select", @id = "LeaveType-selector" })

                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Leave Type | ประเภทการลา :</label>
                            @Html.DropDownList("reqType", new SelectList(ViewBag.Leavetype, "Leavetype", "Description"), "Select request type | เลือกประเภทร้องขอ", new { @class = "custom-select", @id = "reqType-selector", @disabled = "disabled" })

                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Request Status | สถานะคำขอ :</label>
                            @Html.DropDownList("ReqStatus", new SelectList(ViewBag.ReqSta, "LookValue", "LookDesc"), "All Request Statuses | สถานะคำขอทั้งหมด", new { @class = "custom-select", @id = "reqStatus" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">From Date | เริ่มวันที่ :</label>
                            @Html.TextBox("ReqStart", null, new { @class = "form-control", @id = "reqStart", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">End Date | ถึงวันที่ :</label>
                            @Html.TextBox("ReqEnd", null, new { @class = "form-control", @id = "reqEnd", @placeholder = "--/--/--" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Department | แผนก :</label>
                            @Html.DropDownList("Dept",
                                               new SelectList(ViewBag.DepartmentList, "LookValue", "LookDesc"),
                                               "Select department | เลือกหน่วยงาน",
                                               new { @class = "custom-select", @id = "department-selector" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Request No | รหัสคำขอ :</label>
                            @Html.TextBox("reqId", null, new { @class = "form-control", @id = "reqId", @placeholder = "Request No | รหัสคำขอ" })
                        </div>
                        <div class="form-group col-lg-3">
                            <label class="font-weight-bold">Employee Name | ชื่อพนักงาน :</label>
                            @Html.TextBox("empName", null, new { @class = "form-control", @id = "empName", @placeholder = "Employee Name | ชื่อพนักงาน" })
                        </div>
                        <div class="form-group col-lg-3">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBox("actionFlag", true, new { @class = "custom-control-input", @id = "actionFlag" })
                                <label class="custom-control-label" for="actionFlag">Pending Tasks | รายการที่ต้องดำเนินการ</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="col-lg-12">
                        <div class="form-group float-end m-2">
                            <input type="button" value="ล้าง" class="btn btn-secondary" id="reset-btn" />
                            <input type="submit" value="ค้นหา" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-12">
        <div class="card p-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped m-0" id="request-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th class="text-center">ACT | จัดการ</th>
                                <th class="text-center">REQ NO | รหัสคำขอ</th>
                                <th class="text-center">REQ DATE | วันที่ขอ</th>
                                <th class="text-center">REQ TYPE | ประเภทการขอ</th>
                                <th class="text-center">REQ BY | ผู้ร้องขอ</th>
                                <th class="text-center">REQ CATE | ประเภทการลา</th>
                                <th class="text-center">FROM DATE | วันที่ลา (เริ่ม)</th>
                                <th class="text-center">END DATE | วันที่ลา (สิ้นสุด)</th>
                                <th class="text-center">TOT DATE | รวมขอลา</th>
                                <th class="text-center">REQ STATUS | สถานะคำขอ</th>
                                <th class="text-center">REMARK | หมายเหตุการลา</th>
                                <th class="text-center">APPR BY | ผู้อนุมัติ</th>
                                <th class="text-center">APPR DATE | วันที่อนุมัติ</th>
                                <th class="text-center">ACK BY | HR ผู้รับอนุมัติ</th>
                                <th class="text-center">ACK DATE | วันที่ HR รับอนุมัติ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                            }
                            @foreach (var itemAck in Model)
                            {
                                i++;
                                var colorStatus = string.Empty;
                                var iconStatus = string.Empty;
                                string colorBgStatus = string.Empty;
                                <tr>
                                    <td class="text-center">@i</td>
                                    <td class="text-center">
                                        <div class="btn btn-warning btn-xs p-1" id="ackbtn_@itemAck.ReqNo" data-reqno="@itemAck.ReqNo" data-empid="@itemAck.EmpId"><span class="fa fa-eye p-1"></span></div>
                                    </td>
                                    <td class="text-center">@itemAck.ReqNo</td>
                                    <td class="text-center">@(itemAck.ReqDate )</td>
                                    <td class="text-center">@itemAck.ReqType</td>
                                    <td class="text-center">@itemAck.Empname</td>
                                    <td class="text-center">@itemAck.LeaveType</td>
                                    <td class="text-center">@(itemAck.StartDate )</td>
                                    <td class="text-center">@(itemAck.EndDate )</td>
                                    <td class="text-center">@itemAck.NumDay</td>
                                    @if (itemAck.ReqStatus == "0")
                                    {
                                        colorStatus = "text-warning";
                                        iconStatus = "fa fa-repeat";
                                        colorBgStatus = "badge bg-warning rounded-pill";


                                    }
                                    else if (itemAck.ReqStatus == "1")
                                    {
                                        colorStatus = "text-success";
                                        iconStatus = "fa fa-check";
                                        colorBgStatus = "badge bg-success rounded-pill";


                                    }
                                    else if (itemAck.ReqStatus == "2")
                                    {
                                        colorStatus = "text-danger";
                                        iconStatus = "fa fa-times";
                                        colorBgStatus = "badge bg-danger rounded-pill";

                                    }
                                    else if (itemAck.ReqStatus == "3")
                                    {
                                        colorStatus = "text-success";
                                        iconStatus = "fa fa-check";
                                        colorBgStatus = "badge bg-success rounded-pill";

                                    }
                                    else if (itemAck.ReqStatus == "4")
                                    {
                                        colorStatus = "text-danger";
                                        iconStatus = "fa fa-ban";
                                        colorBgStatus = "badge bg-danger rounded-pill";

                                    }
                                    <td class="text-left">
                                        <div class="@colorStatus badge" style="font-size: 14px;"><span class="@colorBgStatus"><i class="@iconStatus" aria-hidden="true"></i></span><span> @itemAck.ReqStaDesc</span></div>
                                    </td>
                                    <td style="max-width: 200px;">
                                        <p class="p-0 m-0 text-truncate">@itemAck.Remark</p>
                                    </td>

                                    @*apprvby*@

                                    @if (itemAck.ApproveBy != null && itemAck.ApproveBy.Contains(","))
                                    {
                                        <td class="text-left">
                                            @{
                                                string[] apprv = itemAck.ApproveBy.Split(',');
                                                string apver = string.Empty;
                                                string iconsta = string.Empty;
                                                string iconbg = string.Empty;
                                                foreach (var item in apprv)
                                                {
                                                    if (item.Contains(" | "))
                                                    {
                                                        string[] StatusNAme = item.Split('|');
                                                        switch (StatusNAme[0].Trim())
                                                        {
                                                            case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                            case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                            case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                            default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                        }
                                                        if (StatusNAme[0].Trim() == "4")
                                                        {
                                                            <span class="badge rounded-pill @iconbg">
                                                                <i class="@iconsta" aria-hidden="true"></i>
                                                            </span>
                                                            <del>@StatusNAme[1]</del> <br />

                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill @iconbg">
                                                                <i class="@iconsta" aria-hidden="true"></i>
                                                            </span>
                                                            <span>@StatusNAme[1]</span><br />
                                                        }

                                                    }
                                                }
                                            }
                                        </td>

                                    }
                                    else
                                    {
                                        //<td class="text-center">@leave.ApproveBy</td>


                                        <td class="text-left">
                                            @{
                                                if (itemAck.ApproveBy != null)
                                                {
                                                    string[] apprv = itemAck.ApproveBy.Split(',');

                                                    string apver = string.Empty;
                                                    string iconsta = string.Empty;
                                                    string iconbg = string.Empty;
                                                    foreach (var item in apprv)
                                                    {
                                                        if (item.Contains(" | "))
                                                        {

                                                            string[] StatusNAme = item.Split('|');
                                                            switch (StatusNAme[0].Trim())
                                                            {
                                                                case "0": iconsta = "fa fa-repeat "; iconbg = "bg-warning"; break;
                                                                case "1": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                case "2": iconsta = "fa fa-times "; iconbg = "bg-danger"; break;
                                                                case "3": iconsta = "fa fa-check "; iconbg = "bg-success"; break;
                                                                default: iconsta = "fa fa-ban "; iconbg = "bg-danger"; break;

                                                            }

                                                            <span class="badge rounded-pill @iconbg">
                                                                <i class="@iconsta" aria-hidden="true"></i>
                                                            </span>
                                                            <span>@StatusNAme[1]</span><br />
                                                        }
                                                    }
                                                }
                                            }
                                        </td>
                                    }
                                    @*apprvby*@

                                    <td>@(itemAck.ApproveDate )</td>
                                    <td>@itemAck.AcknowledgeBy</td>
                                    <td>@(itemAck.AcknowledgeDate )</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@*ModalAck*@

<div class="modal fade" id="AckRequestModal" tabindex="-1" aria-labelledby="ModalAck" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalAck">รับทราบคำขอ</h5>
                <div class="col-sm-2 col-md-2 text-right"><button type="button" class="btn btn-danger btn-sm" data-dismiss="modal">Close | ปิด</button></div>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <div id="btn-ack-form">
                    <button type="button" class="btn btn-success" id="acknowledge-btn">รับทราบ/Acknowledge</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    const queryString = decodeURIComponent(window.location.search);
    const params = new URLSearchParams(queryString);
    const page = params.get('req');

    $('#reqStart').inputmask('99/99/9999');
    $('#reqEnd').inputmask('99/99/9999');
    $('#reqStart').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $('#reqEnd').datepicker({
        orientation: "bottom auto",
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $(document).ready(function () {
        console.log("Page Param: " + page);
        $('#department-selector').select2({
            width: '100%'
        });
        var isMdOrLarger = window.matchMedia("(min-width: 1600px)").matches;
        $('#request-table').dataTable({
            //orderFixed: [[2, 'asc']],
            dom: '<t><"d-flex align-items-center"ip>',
            fixedColumns: isMdOrLarger
                ? { start: 6, end: 0 } // ใช้งาน fixedColumns ถ้าหน้าจอเป็น md ขึ้นไป
                : false,
            paging: true,
            pageLength: 50,
            lengthChange: false,
            searching: false,
            ordering: false,
            order:[],
            deferRender: true,
            processing: true,
            select: false,
            scrollY: 500,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ คำร้องขอ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            },
            scrollY: 500,
            dom: '<"d-flex justify-content-between mb-3"B>t<"d-flex align-items-center"i<"ml-3"p>>', // ปรับตำแหน่ง DOM
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Export to Excel', // ข้อความปุ่ม
                    className: 'btn btn-success', // เพิ่มคลาสเพื่อปรับแต่งปุ่ม
                    title: 'รายงานรายละเอียดการลา'//, // ชื่อไฟล์ Excel
                    //exportOptions: {
                    //    columns: ':visible' // Export เฉพาะคอลัมน์ที่มองเห็น
                    //}
                }
            ]
        });

        if (page) {
            $('#ackbtn_' + page).click();
            console.log('click:' + page);
        }

    });
    $(document).on('click', '#reset-btn', function () {
        $('#reqType-selector').val('').trigger('change');
        $('#reqStatus').val('').trigger('change');
        $('#reqStart').val('');
        $('#reqEnd').val('');
        $('#reqStatus').val('').trigger('change');
        $('#department-selector').val('').trigger('change');
        $('#reqId').val('');
        $('#empName').val('');

    });
    $(document).on('change', '#LeaveType-selector', function () {
        var typ = $(this).val();
        console.log('typ :' + typ);
        if (typ == 1) {
            $('#reqType-selector').removeAttr('disabled');
        }
        else {
            $('#reqType-selector').attr('disabled', true);
        }
    });
    $(document).on('click', '[id^="ackbtn_"]', async function (e) {
        e.preventDefault();
        var ReqNo = $(this).data('reqno');
        var empId = $(this).data('empid');
        console.log("Detail ReqNo: " + ReqNo);
        try {
            await GetDetailAcknowledge(ReqNo, empId);
            await CheckAcknowledge(ReqNo);
        }
        catch(error) {
            console.error("Error during acknowledge process:", error);
        }
    });
    $(document).on('click', '#acknowledge-btn', function (e) {
        e.preventDefault();
        var ReqNo = $('#ReqIdHide').val();
        var Ack_comment = $('#ack-comment').val();
        console.log('Req :' + ReqNo);
        console.log('Comment :' + Ack_comment);
        SaveAcknowledge(ReqNo, Ack_comment);
    });
    function SaveAcknowledge(REQ, ack_comm) {
        Swal.fire({
            icon: 'question',
            title: 'ต้องยืนยันใช่หรือไม่',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ยืนยัน',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ยกเลิก',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                $.ajax({
                    url: '@Url.Action("SaveAcknowledge", "Acknowledge")',
                    data: {
                        ReqNo: REQ,
                        AckComment: ack_comm
                    },
                    type: 'POST',
                    dataType: 'JSON',
                    success: function (res) {
                        if (res.message == 'Y') {
                            $('#AckRequestModal').modal('hide');
                            Swal.fire({
                                title: "อนุมัติเรียบร้อย",
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'ปิด',
                            }).then(() => {
                                location.reload();
                            });
                        }
                        else {
                            $('#AckRequestModal').modal('hide');
                            Swal.fire({
                                title: "เกิดข้อผิดพลาด!",
                                text: res.message,
                                icon: "error"
                            }).then(() => {
                                $('#AckRequestModal').modal('show');
                            });
                        }
                    }
                });
            }
        });
    }
    function CheckAcknowledge(REQ) {
        return $.ajax({
            url: '@Url.Action("CheckAcknowledge", "Acknowledge")',
            data: {
                ReqNo:REQ
            },
            type: 'POST',
            dataType: 'JSON',
            cache: false,
            beforeSend: function () {
                LoadingShow();
            },
            success: function (res) {
                if (res.message === "Y") {
                    $('#ack-comment-div').removeClass('d-none');
                    $('#btn-ack-form').removeClass('d-none');
                }
                else if (res.message === "N") {
                    $('#ack-comment-div').addClass('d-none');
                    $('#btn-ack-form').addClass('d-none');
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        html: '<p>Error :</p><p>' + res.message + '</p>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            }, complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        });
    }

    function GetDetailAcknowledge(REQ, empId) {
          return $.ajax({
            url: '@Url.Action("GetRequestDetail", "Leave")',
            data: {
                ReqNO: REQ,
                EmpId: empId,
                Flag: "ack"
            },
            type: 'POST',
            dataType: 'HTML',
            beforeSend: function () {
                LoadingShow();
                $('#AckRequestModal').find('.modal-body').html("");
            },
            success: function (data) {
                $('#AckRequestModal').find('.modal-body').html(data);
                $('#AckRequestModal').modal('show');
                $("#ack-comment").focus();
            }, complete: function (res) {
                LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>GetReqDetail :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        });
    }
</script>