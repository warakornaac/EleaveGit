@{
    string UsrType = Session["UserType"] != null ? Session["UserType"].ToString() : string.Empty;
    string UserID = Session["UserID"] != null ? Session["UserID"].ToString() : string.Empty;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRIS</title>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    @Styles.Render("~/Content/css")
    <link href="~/Content/style-flat.css" rel="stylesheet" />
    <link href="~/Content/plugins/animate.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/prism-coy.css" rel="stylesheet" />
    <link href="~/Content/plugins/perfect-scrollbar.css" rel="stylesheet" />
    <link href="~/Content/bell-alert.css" rel="stylesheet" />
    <!-- External libraries -->
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.7.1/css/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/css/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <link href="~/Content/daterangepicker.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">
    <!-- DataTables and Select2 -->
    <link href="~/Content/plugins/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/plugins/select2.min.css")" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-datepicker@1.9.0/dist/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedcolumns/5.0.4/css/fixedColumns.dataTables.css">
    @*<link rel="stylesheet" href="https://cdn.datatables.net/select/1.7.0/css/select.dataTables.min.css">*@
    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/plugins/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.7/jquery.inputmask.min.js"></script>


    <style>
        footer {
            position: fixed;
            height: 30px;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    @*Menu left*@
    <nav class="pcoded-navbar">
        <div class="navbar-wrapper">
            <div class="navbar-content scroll-div">
                <div class="main-menu-header pb-1">
                    <i class="feather icon-user"></i>
                    <div class="user-details">
                        <span> @Session["FullName"] (@Session["DeptName"]) </span>
                    </div>
                </div>
                @{
                    string fileMenu = "";
                    if (Session["UserType"] != null)
                    {
                        switch (Session["UserType"].ToString())
                        {
                            case "1": //Employee
                                fileMenu = "../Include/MenuEmployee";
                                break;
                            case "2": //Hr
                                fileMenu = "../Include/MenuHr";
                                break;
                            case "3": //Approve
                                fileMenu = "../Include/MenuMgr";
                                break;
                            default: //SuperAdmin (IT)
                                fileMenu = "../Include/MenuSuper";
                                break;
                        }
                        @Html.Partial(fileMenu)
                        <ul class="nav pcoded-inner-navbar">
                            <li class="nav-item pcoded-menu-caption pt-1">
                                <label>เอกสาร | Document</label>
                            </li>
                            <li class="nav-item">
                                <a href="#!" class="nav-link" data-toggle="modal" data-target="#imageModal" id="img-policy" onclick="ImgModalOpen();">
                                    <span class="pcoded-micon"><i class="feather icon-grid"></i></span>
                                    <span class="pcoded-mtext">ระเบียบการลา | Leave Policy</span>
                                </a>
                            </li>
                        </ul>
                        @*<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#imageModal">
                                เปิด Modal (ทดสอบ)
                            </button>*@

                    }
                    else
                    {
                        Response.Redirect("/Home/Login");
                    }
                }

            </div>
        </div>
    </nav>
    @*End menu left*@

    @* Header start *@

    @if (Session["UserType"] != null)
    {
        @Html.Partial("../Include/Header")
    }

    @* [ Header ]*@
    <div class="pcoded-main-container">
        <div class="pcoded-content">
            <!--Modal Image-->
            <!-- Modal สำหรับขยายภาพ -->
            <!-- Modal -->
            <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-body p-0">
                            <img src="~/Images/E-Leave_ระเบียบการลา-1.png" alt="Expanded Image" class="img-fluid w-100">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal" id="close-img-modal" onclick="ImgModalClose();">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            @RenderBody()
            @RenderSection("scripts", required: false)
            <footer>
                <p>@*&copy; @DateTime.Now.Year - E-Leave Application*@</p>
            </footer>
        </div>
    </div>
</body>
</html>

