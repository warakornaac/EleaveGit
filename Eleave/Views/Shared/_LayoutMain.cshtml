@{
    string UsrType = Session["UserType"] != null ? Session["UserType"].ToString() : string.Empty;
    string UserID = Session["UserID"] != null ? Session["UserID"].ToString() : string.Empty;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRIS</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/style-flat.css" rel="stylesheet" />
    <link href="~/Content/plugins/animate.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/prism-coy.css" rel="stylesheet" />
    <link href="~/Content/plugins/perfect-scrollbar.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.7.1/css/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/css/fileinput.min.css" media="all" rel="stylesheet" type="text/css" />
    <link href="~/Content/daterangepicker.css" rel="stylesheet" />

    <!-- SweetAlert CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="~/Content/plugins/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/plugins/select2.min.css")" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>                   
    <script src="~/Scripts/plugins/bootstrap-datepicker.min.js"></script>
    <script src="@Url.Content("~/Scripts/plugins/select2.min.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.7/jquery.inputmask.min.js"></script>

    <style>
        footer {
            position: fixed;
            height: 30px;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    @*Menu left*@
    <nav class="pcoded-navbar">
        <div class="navbar-wrapper">
            <div class="navbar-content scroll-div">
                <div class="main-menu-header pb-1">
                    <i class="feather icon-user"></i>
                    <div class="user-details">
                        <span> @Session["FullName"] (@Session["DeptName"]) </span>
                    </div>
                </div>
                @{
                    string fileMenu = "";
                    if (Session["UserType"] != null)
                    {
                        switch (Session["UserType"].ToString())
                        {
                            case "1": //Employee
                                fileMenu = "../Include/MenuEmployee";
                                break;
                            case "2": //Hr
                                fileMenu = "../Include/MenuHr";
                                break;
                            case "3": //Approve
                                fileMenu = "../Include/MenuMgr";
                                break;
                            default: //SuperAdmin (IT)
                                fileMenu = "../Include/MenuSuper";
                                break;
                        }
                        @Html.Partial(fileMenu)
                    }
                    else
                    {
                        Response.Redirect("/Home/Login");
                    }
                }

            </div>
        </div>
    </nav>
    @*End menu left*@

    @* Header start *@

    @if (Session["UserType"] != null) { 
        @Html.Partial("../Include/Header")
    }

    @* [ Header ]*@
    <div class="pcoded-main-container">
        <div class="pcoded-content">

            @RenderBody()

            <footer>
                <p>@*&copy; @DateTime.Now.Year - E-Leave Application*@</p>
            </footer>
        </div>
    </div>
</body>
</html>

<script type="text/javascript" src="~/Scripts/plugins/jquery-ui.min.js"></script>
<script type="text/javascript" src="~/Scripts/vendor-all.min.js"></script>
<script type="text/javascript" src="~/Scripts/plugins/bootstrap.min.js"></script>
<script type="text/javascript" src="~/Scripts/pcoded.js"></script>
<script type="text/javascript" src="~/Scripts/plugins/datatables.min.js"></script>
<script type="text/javascript" src="~/Scripts/plugins/gmaps.min.js"></script>
<script type="text/javascript" src="~/Scripts/plugins/perfect-scrollbar.min.js"></script>
<script type="text/javascript" src="~/Scripts/plugins/prism.js"></script>
<script type="text/javascript" src="~/Scripts/LoadingOverlay.js"></script>
<!-- jQuery -->
@*<script type="text/javascript" src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>*@
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.22.1/moment.min.js"></script>
<script type="text/javascript" src="~/Scripts/daterangepicker.js"></script>


<script type="text/javascript">
    function LoadingShow() {
        JsLoadingOverlay.show();
    }
    function LoadingHide() {
        JsLoadingOverlay.hide();
    }
</script>